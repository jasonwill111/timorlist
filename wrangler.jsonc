{
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "timorup",
  "account_id": "0b8c74af4a5531bd63c074724898a4c9",
  "compatibility_date": "2026-06-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "logs": { "enabled": true },
    "tracing": { "enabled": true },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist/client"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "timorup-db",
      "database_id": "45346e9c-d19c-4acb-85f1-ebf6cb581fc5",
      "remote": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "3e9ae14a105b4aa48316eaa029f5bc5f",
      "preview_id": "3e9ae14a105b4aa48316eaa029f5bc5f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "timorup-media",
      "preview_bucket_name": "timorup-media"
    }
  ],
  // --- Secret / Environment Variables ---
  "vars": {
    "MINIMAX_API_KEY": "PLACEHOLDER_SET_VIA_WRANGLER_SECRET",
    "CLEANUP_SECRET": "PLACEHOLDER_SET_VIA_WRANGLER_SECRET",
    "CRON_SECRET": "PLACEHOLDER_SET_VIA_WRANGLER_SECRET",
    "APP_URL": "https://timorup.jasonwill.workers.dev",
    "SITE_URL": "https://timorup.com",
    "BETTER_AUTH_URL": "PLACEHOLDER_SET_VIA_WRANGLER_SECRET",
    "R2_PUBLIC_URL": "https://pub-timorup.jasonwill.workers.dev"
  }
}