---
import '../styles/globals.css';
import { Button } from '../components/fulldev/button';
import ToastContainer from '../components/fulldev/toast/ToastContainer.astro';
import { actions } from 'astro:actions';

interface Props {
  title: string;
}

const { title } = Astro.props;
const fullTitle = title.includes('Admin') ? title : `${title} - Admin`;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Robots - admin pages should not be indexed -->
    <meta name="robots" content="noindex, nofollow" />
    <!-- Theme initialization - prevents flash of wrong theme -->
    <script is:inline>
      const theme = localStorage.getItem('theme') ||
        (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.classList.toggle('dark', theme === 'dark');
    </script>
  </head>
  <body class="min-h-screen bg-background">
    <ToastContainer />
    <!-- Mobile Header -->
    <header class="md:hidden fixed top-0 left-0 right-0 h-14 bg-card border-b z-50 flex items-center px-3 gap-2">
      <Button id="mobile-menu-btn" variant="ghost" size="icon" class="p-2 -ml-2 flex-shrink-0">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </Button>
      <!-- Center: Logo + TimorUp -->
      <div class="flex-1 flex items-center justify-center gap-2 min-w-0">
        <div class="w-7 h-7 bg-brand-500 rounded-lg flex items-center justify-center flex-shrink-0">
          <span class="text-white font-bold text-sm">T</span>
        </div>
        <span class="font-semibold text-sm truncate">TimorUp</span>
        <span class="text-xs text-muted-foreground bg-muted px-1.5 py-0.5 rounded">Admin</span>
      </div>
      <!-- Right: Theme toggle -->
      <Button id="theme-toggle-mobile" variant="ghost" size="icon" class="p-2 -mr-2">
        <svg class="w-5 h-5 sun-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/>
        </svg>
        <svg class="w-5 h-5 moon-icon hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/>
        </svg>
      </Button>
    </header>

    <div class="flex">
      <!-- Sidebar - Desktop -->
      <aside class="hidden md:flex flex-col w-64 min-h-screen border-r bg-card fixed left-0 top-0 bottom-0 z-40">
        <div class="flex items-center gap-2 p-4 border-b">
          <div class="w-8 h-8 bg-brand-500 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold">T</span>
          </div>
          <div>
            <div class="font-semibold text-sm">TimorUp</div>
            <div class="text-xs text-muted-foreground">Admin Panel</div>
          </div>
        </div>

        <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname === '/admin' ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
            </svg>
            Dashboard
          </a>
          <a href="/admin/listings" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/listings') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Listings
          </a>
          <a href="/admin/products" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/products') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            Products
          </a>
          <a href="/admin/service-packages" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/service-packages') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
            </svg>
            Service Packages
          </a>
          <a href="/admin/businesses" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/businesses') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Businesses
          </a>
          <a href="/admin/users" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/users') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197m13.5-9a2.5 2.5 0 11-5 0 2.5 2.5 0 015 0z"/>
            </svg>
            Users
          </a>
          <a href="/admin/media" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/media') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
            Media
          </a>
          <a href="/admin/non-profits" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/non-profits') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            Non-Profits
          </a>
          <a href="/admin/public-sectors" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/public-sectors') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
            </svg>
            Public Sectors
          </a>
          <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname.startsWith('/admin/settings') ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Settings
          </a>
        </nav>

        <!-- Bottom section: AI Tools + Logout -->
        <div class="border-t p-3 space-y-1">
          <a href="/admin/ai-tools" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors {Astro.url.pathname === '/admin/ai-tools' ? 'bg-accent' : ''}">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
            </svg>
            AI Tools
          </a>
          <button id="logout-btn-desktop" class="flex w-full items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-destructive/10 text-destructive transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Log Out
          </button>
        </div>
      </aside>

      <!-- Main Content -->
      <main class="flex-1 md:ml-64 pt-14 md:pt-0 min-h-screen">
        <div class="p-4 md:p-6 lg:p-8">
          <slot />
        </div>
      </main>
    </div>

    <!-- Mobile Navigation Overlay -->
    <div id="mobile-menu" class="fixed inset-0 z-50 hidden">
      <div class="absolute inset-0 bg-black/50" id="mobile-menu-overlay"></div>
      <div class="absolute left-0 top-0 bottom-0 w-72 bg-card shadow-xl transform -translate-x-full transition-transform duration-200" id="mobile-menu-panel">
        <div class="flex items-center gap-2 p-4 border-b">
          <div class="w-8 h-8 bg-brand-500 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold">T</span>
          </div>
          <div>
            <div class="font-semibold text-sm">TimorUp</div>
            <div class="text-xs text-muted-foreground">Admin Panel</div>
          </div>
          <button id="close-mobile-menu" class="ml-auto p-2 hover:bg-accent rounded-md">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          </button>
        </div>
        <nav class="flex-1 overflow-y-auto py-4 px-3 space-y-1">
          <a href="/admin" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Dashboard</a>
          <a href="/admin/listings" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Listings</a>
          <a href="/admin/products" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Products</a>
          <a href="/admin/service-packages" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Service Packages</a>
          <a href="/admin/businesses" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Businesses</a>
          <a href="/admin/users" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Users</a>
          <a href="/admin/media" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Media</a>
          <a href="/admin/non-profits" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Non-Profits</a>
          <a href="/admin/public-sectors" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Public Sectors</a>
          <a href="/admin/settings" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">Settings</a>
          <a href="/admin/ai-tools" class="flex items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-accent transition-colors">AI Tools</a>
        </nav>
        <div class="border-t p-3">
          <button id="logout-btn-mobile" class="flex w-full items-center gap-3 px-3 py-2 rounded-md text-sm hover:bg-destructive/10 text-destructive transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
            </svg>
            Log Out
          </button>
        </div>
      </div>
    </div>

    <script>
      // Theme toggle
      function applyTheme(dark: boolean) {
        document.documentElement.classList.toggle('dark', dark);
        const sun = document.querySelectorAll('.sun-icon');
        const moon = document.querySelectorAll('.moon-icon');
        sun.forEach(el => (el as HTMLElement).style.display = dark ? 'none' : 'block');
        moon.forEach(el => (el as HTMLElement).style.display = dark ? 'block' : 'none');
      }

      document.addEventListener('astro:page-load', () => {
        const isDark = document.documentElement.classList.contains('dark');
        applyTheme(isDark);

        document.querySelectorAll('#theme-toggle-mobile, #theme-toggle-desktop').forEach(btn => {
          btn?.addEventListener('click', () => {
            const nowDark = document.documentElement.classList.toggle('dark');
            localStorage.setItem('theme', nowDark ? 'dark' : 'light');
            applyTheme(nowDark);
          });
        });

        // Mobile menu
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileMenuPanel = document.getElementById('mobile-menu-panel');
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const closeMobileMenu = document.getElementById('close-mobile-menu');
        const mobileMenuOverlay = document.getElementById('mobile-menu-overlay');

        function openMenu() {
          mobileMenu?.classList.remove('hidden');
          setTimeout(() => mobileMenuPanel?.classList.remove('-translate-x-full'), 0);
        }
        function closeMenu() {
          mobileMenuPanel?.classList.add('-translate-x-full');
          setTimeout(() => mobileMenu?.classList.add('hidden'), 200);
        }

        mobileMenuBtn?.addEventListener('click', openMenu);
        closeMobileMenu?.addEventListener('click', closeMenu);
        mobileMenuOverlay?.addEventListener('click', closeMenu);

        // Logout handlers
        async function handleLogout() {
          try {
            await actions.auth.signOut();
          } catch (e) {
            console.error('Logout error:', e);
          }
          window.location.href = '/admin/login';
        }

        document.getElementById('logout-btn-desktop')?.addEventListener('click', handleLogout);
        document.getElementById('logout-btn-mobile')?.addEventListener('click', handleLogout);
      });
    </script>
  </body>
</html>