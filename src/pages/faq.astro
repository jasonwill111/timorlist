---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { Button } from '@/components/fulldev/button';
import {
  Accordion,
  AccordionContent,
  AccordionItem,
  AccordionTrigger,
} from '@/components/fulldev/accordion';
import { Section, SectionContainer } from '@/components/fulldev/section';

// FAQ structured data (JSON-LD for SEO)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What's the difference between Business Directories and Classified Ads",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Business Directories are permanent listings for established businesses like restaurants, hotels, and shops with reviews and photos. Classified Ads are temporary listings for buying, selling, or finding jobs, vehicles, property, and services."
      }
    },
    {
      "@type": "Question",
      "name": "Are classified ads really free",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes! Classified ads are free for the first 3 days. After that, you can renew for 7, 30, or 365 days at affordable rates."
      }
    },
    {
      "@type": "Question",
      "name": "Can I list products or services directly",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Absolutely! Business directory members can add products and services with photos, descriptions, and pricing in our Products & Services section."
      }
    },
    {
      "@type": "Question",
      "name": "How do I find NGOs or government services",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Visit the Non-Profits or Public Sectors sections to discover NGOs, charitable organizations, ministries, and government agencies in Timor-Leste."
      }
    }
  ]
};

const faqs = [
  { id: "faq-0", question: "What's the difference between Business Directories and Classified Ads", answer: "Business Directories are permanent listings for established businesses like restaurants, hotels, and shops complete with reviews, photos, and contact info. Classified Ads are temporary listings for buying, selling, or finding jobs, vehicles, property, and services. Think of it like the difference between a Yelp listing and a Craigslist post." },
  { id: "faq-1", question: "How do I list my business on TimorUp", answer: "Click 'Add Your Listing' on the homepage, choose your listing type (Business, Classified Ad, NGO, or Government), fill in details, and submit. Business listings require a subscription plan; classified ads are free for the first few days." },
  { id: "faq-2", question: "Are classified ads really free", answer: "Yes! Classified ads are free for the first 3 days. After that, you can renew for 7, 30, or 365 days at affordable rates. Business directory listings offer subscription plans with enhanced features." },
  { id: "faq-3", question: "Can I list products or services directly", answer: "Absolutely! Business directory members can add products and services with photos, descriptions, and pricing. Browse the Products & Services section to see what's available from local businesses." },
  { id: "faq-4", question: "How do I find NGOs or non-profit organizations", answer: "Visit the Non-Profits section to discover NGOs and charitable organizations in Timor-Leste. Filter by category to find volunteer opportunities, community initiatives, or social services near you." },
  { id: "faq-5", question: "Where can I find government contact information", answer: "The Public Sectors section lists all ministries, government agencies, and public institutions. Each entry includes contact details, locations, and descriptions of their services." },
  { id: "faq-6", question: "What subscription plans are available for a business page", answer: "We offer three business plans: Basic ($39/month or $390/year) with up to 10 products, Pro ($69/month or $690/year) with up to 30 products and enhanced visibility, and Max ($99/month or $990/year) with up to 60 products and priority placement. NGOs and public sector organizations are always free." },
  { id: "faq-7", question: "How can I contact TimorUp support", answer: "Email us at hello@TimorUp.com or use the contact form on our website. We typically respond within 24 hours on business days." },
];

const title = "Frequently Asked Questions";
const description = "Find answers about TimorUp business directories, classified ads, NGOs, government services, and more.";
const buttons = [{ label: "Contact Us", href: "mailto:hello@TimorUp.com" }];
---

<Layout
  title="FAQ - Frequently Asked Questions"
  description={description}
  structuredData={faqSchema}
>
  <Section>
    <SectionContainer class="items-center text-center">
      <div class="flex max-w-2xl flex-col items-center gap-5">
        <h2 class="text-foreground text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          {title}
        </h2>
        <p class="text-muted-foreground text-lg leading-relaxed text-balance">
          {description}
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3">
        {buttons.map(({ href, label, ...button }, index) => (
          <Button
            as="a"
            href={href}
            size="lg"
            variant={button.variant ?? (index === 0 ? "default" : "secondary")}
          >
            {label}
          </Button>
        ))}
      </div>
    </SectionContainer>
    <SectionContainer>
      <div class="mx-auto w-full max-w-3xl">
        <Accordion collapsible>
          {faqs.map((item) => (
            <AccordionItem value={item.id}>
              <AccordionTrigger>{item.question}</AccordionTrigger>
              <AccordionContent>{item.answer}</AccordionContent>
            </AccordionItem>
          ))}
        </Accordion>
      </div>
    </SectionContainer>
  </Section>
</Layout>