---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { Button } from '../components/ui/button';
import { Input } from '../components/ui/input';
import BusinessCard from '../components/business/BusinessCard.astro';
import { getRawDb } from '@/lib/db';

const searchParams = Astro.url.searchParams;
const query = searchParams.get('q') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

// Short cache for search results (dynamic content)
Astro.response.headers.set('Cache-Control', 'public, max-age=30, s-maxage=60, stale-while-revalidate=120');

interface BusinessRecord {
  id: string;
  title: string;
  slug: string;
  category_id: string | null;
  address: string | null;
  profile_image_id: string | null;
  tags: string | null;
  likes: number | null;
  saves: number | null;
  views: number | null;
  status: string | null;
  about_us: string | null;
  categoryName: string | null;
}

interface CategoryRecord {
  id: string;
  name: string;
  parentId: string | null;
}

let categoryMap: Record<string, string> = {};
let searchResults: BusinessRecord[] = [];
let total = 0;

// Build category map for display
try {
  const db = await getRawDb();
  if (db) {
    const categories = (await db.prepare('SELECT id, name, parent_id as parentId FROM business_categories').all()).results as CategoryRecord[];
    categories.forEach(c => {
      categoryMap[c.id] = c.name;
    });
  }
} catch (e) {
  console.log('Categories error:', e);
}

// Perform server-side search
if (query) {
  try {
    const db = await getRawDb();
    if (db) {
      const searchPattern = `%${query.toLowerCase()}%`;
      
      // Count total matching results
      const countResult = await db.prepare(`
        SELECT COUNT(*) as count FROM businesses 
        WHERE status IN ('active', 'published', 'live')
          AND (LOWER(title) LIKE ? OR LOWER(about_us) LIKE ?)
      `).bind(searchPattern, searchPattern).first() as { count: number } | undefined;
      total = countResult?.count || 0;
      
      // Fetch paginated results
      const dataResult = await db.prepare(`
        SELECT id, title, slug, category_id, address, profile_image_id as profileImageId,
               tags, likes, saves, views, status, about_us as aboutUs
        FROM businesses
        WHERE status IN ('active', 'published', 'live')
          AND (LOWER(title) LIKE ? OR LOWER(about_us) LIKE ?)
        ORDER BY 
          CASE WHEN LOWER(title) LIKE ? THEN 0 ELSE 1 END,
          likes DESC
        LIMIT ? OFFSET ?
      `).bind(searchPattern, searchPattern, searchPattern, LIMIT, offset).all();
      
      searchResults = (dataResult.results as BusinessRecord[]).map(b => ({
        ...b,
        categoryName: b.category_id ? categoryMap[b.category_id] || '' : ''
      }));
    }
  } catch (e) {
    console.error('Search error:', e);
  }
}

const totalPages = Math.ceil(total / LIMIT);

// Build pagination URL helper
const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (query) p.set('q', query);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/search?${p.toString()}`;
};
---

<Layout 
  title={query ? `Search: ${query} - TimorUp` : 'Search - TimorUp'}
  description={query ? `Search results for "${query}" on TimorUp` : 'Search businesses on TimorUp'}
>
  <div class="container max-w-7xl mx-auto px-4 py-8">
    <!-- Search Header -->
    <div class="text-center mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold mb-4">
        {query ? `Search results for "${query}"` : 'Search Businesses'}
      </h1>
      
      <!-- Search Form -->
      <form method="GET" action="/search" class="max-w-xl mx-auto">
        <div class="relative">
          <Input 
            name="q" 
            type="search" 
            placeholder="Search businesses..." 
            value={query}
            class="w-full h-12 pl-12 pr-4 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all"
          />
          <Button type="submit" variant="ghost" size="sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </Button>
        </div>
      </form>
    </div>

    <!-- Results -->
    {query ? (
      <>
        <div class="text-center mb-6">
          <span class="text-lg text-muted-foreground">{total} result{total !== 1 ? 's' : ''} found</span>
        </div>

        {searchResults.length > 0 ? (
          <>
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
              {searchResults.map(b => (
                <BusinessCard
                  title={b.title}
                  slug={b.slug}
                  category={b.categoryName || ''}
                  address={b.address || ''}
                  tags={b.tags ? (b.tags.startsWith('[') ? JSON.parse(b.tags) : b.tags.split(',').map(t => t.trim())) : []}
                  likes={b.likes || 0}
                  saves={b.saves || 0}
                  views={b.views || 0}
                  ratingAverage={0}
                  ratingCount={0}
                  imageId={b.profile_image_id}
                  entityType="business"
                  aboutUs={b.about_us}
                />
              ))}
            </div>

            {/* Pagination */}
            {totalPages > 1 && (
              <nav class="flex justify-center items-center gap-2 mt-8" aria-label="Pagination">
                {page > 1 && (
                  <a href={buildUrl(page - 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
                    ← Previous
                  </a>
                )}
                
                {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
                  const pageNum = i + 1;
                  const isActive = pageNum === page;
                  return (
                    <a 
                      href={buildUrl(pageNum)} 
                      class={`px-3 py-2 rounded-md text-sm ${isActive ? 'bg-primary text-primary-foreground' : 'bg-muted hover:bg-muted/80'}`}
                      aria-current={isActive ? 'page' : undefined}
                    >
                      {pageNum}
                    </a>
                  );
                })}
                
                {page < totalPages && (
                  <a href={buildUrl(page + 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
                    Next →
                  </a>
                )}
              </nav>
            )}
          </>
        ) : (
          <div class="text-center py-16">
            <svg class="w-16 h-16 text-muted-foreground/50 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <h3 class="text-xl font-semibold text-foreground mb-2">No businesses found</h3>
            <p class="text-muted-foreground mb-4">Try different keywords or browse our directory</p>
            <a href="/businesses" class="inline-block px-4 py-2 bg-primary text-primary-foreground rounded-md">
              Browse All Businesses
            </a>
          </div>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <svg class="w-16 h-16 text-muted-foreground/50 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <h3 class="text-xl font-semibold text-foreground mb-2">Search TimorUp</h3>
        <p class="text-muted-foreground">Enter a search term to find businesses</p>
      </div>
    )}
  </div>
</Layout>
