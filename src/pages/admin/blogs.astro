---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { BlogsIsland } from '@/components/islands/admin';
import { getAdminBlogPosts } from '@/lib/db/queries';

const posts = await getAdminBlogPosts();
---

<AdminLayout title="Blog Posts">
  <div class="container py-4 px-2 md:py-6">
    <BlogsIsland posts={posts} />
  </div>
</AdminLayout>