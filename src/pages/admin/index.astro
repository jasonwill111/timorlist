---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { DashboardIsland } from '@/components/islands/admin';
import { getAdminStats } from '@/lib/db/queries/admin';
import { getAdminOrders } from '@/lib/db/queries';

const { userCount, businessCount, nonProfitCount, productCount, mtdUserCount } = await getAdminStats();
const orders = await getAdminOrders();

const stats = {
  totalUsers: userCount,
  totalBusinesses: businessCount,
  totalNonProfits: nonProfitCount,
  totalProducts: productCount,
  mtd: { revenue: 0, newSubscriptions: 0, newUsers: mtdUserCount },
};
---

<AdminLayout title="Dashboard">
  <DashboardIsland client:load stats={stats} subscriptions={orders} />
</AdminLayout>