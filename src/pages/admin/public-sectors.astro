---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { PublicSectorsIsland } from '@/components/islands/admin';
import { getAdminPublicSectors } from '@/lib/db/queries';

const publicSectors = await getAdminPublicSectors();
---

<AdminLayout title="Public Sectors">
  <div class="container py-4 px-2 md:py-6">
    <PublicSectorsIsland publicSectors={publicSectors} />
  </div>
</AdminLayout>