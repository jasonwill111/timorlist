---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { ProductsIsland } from '@/components/islands/admin';
import { getAdminProducts, getAdminBusinessOptions } from '@/lib/db/queries';

const products = await getAdminProducts();
const businessOptions = await getAdminBusinessOptions();
---

<AdminLayout title="Products">
  <div class="container py-4 px-2 md:py-6">
    <ProductsIsland products={products} businessOptions={businessOptions} />
  </div>
</AdminLayout>