---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { ReviewsIsland } from '@/components/islands/admin';
import { getAdminReviews } from '@/lib/db/queries';

const reviews = await getAdminReviews(100);
---

<AdminLayout title="Reviews">
  <div class="container py-4 px-2 md:py-6">
    <ReviewsIsland reviews={reviews} />
  </div>
</AdminLayout>