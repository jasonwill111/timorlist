---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { ServicePackagesIsland } from '@/components/islands/admin';
import { getAdminServicePackages } from '@/lib/db/queries';

const packages = await getAdminServicePackages();
---

<AdminLayout title="Service Packages">
  <div class="container py-4 px-2 md:py-6">
    <ServicePackagesIsland packages={packages} />
  </div>
</AdminLayout>