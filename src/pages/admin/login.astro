---
export const prerender = false;
import '../../styles/globals.css';
import LoginIsland from '@/components/islands/admin/LoginIsland.astro';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Login - TimorUp</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="min-h-screen bg-background flex items-center justify-center p-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <a href="/admin" class="inline-flex items-center gap-2">
          <div class="w-12 h-12 bg-brand-500 rounded-lg flex items-center justify-center">
            <span class="text-white font-bold text-xl">T</span>
          </div>
        </a>
        <h1 class="text-3xl font-bold leading-tight mt-4">Admin Login</h1>
        <p class="text-muted-foreground mt-2">Sign in to manage the site</p>
      </div>
      <div class="bg-card border rounded-lg p-6">
        <LoginIsland />
      </div>
      <div class="text-center mt-6 space-y-2">
        <a href="/" class="text-sm text-muted-foreground hover:text-foreground">
          ← Back to Website
        </a>
        <div class="text-sm text-muted-foreground">
          Don't have an account <a href="/register" class="text-primary hover:underline">Sign up</a>
        </div>
      </div>
    </div>
  </body>
</html>
