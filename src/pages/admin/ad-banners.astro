---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { AdBannersIsland } from '@/components/islands/admin';
import { getAdminHeroes, getAdminBusinessesForDropdown } from '@/lib/db/queries';

// Server-side data fetch (no client-side loading needed)
const [heroes, businesses] = await Promise.all([
  getAdminHeroes(),
  getAdminBusinessesForDropdown(),
]);
---

<AdminLayout title="Ad Banners">
  <div class="container py-4 px-2 md:py-6">
    <AdBannersIsland heroes={heroes} businesses={businesses} />
  </div>
</AdminLayout>