---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import Select from '@components/ui/Select.astro';
import Button from '@components/ui/Button.astro';
import Textarea from '@components/ui/Textarea.astro';
import Input from '@components/ui/Input.astro';
---

<AdminLayout title="NonProfits">
  <div class="container py-4 px-2 md:py-6">
    <!-- Page Header -->
    <div class="mb-4 md:mb-6 flex items-start justify-between gap-2">
      <h1 class="text-lg md:text-2xl font-bold min-w-0 truncate">All NonProfits</h1>
      <Button id="add-business-btn" data-action="modal-add" class="text-xs px-2 py-1 h-7 flex-shrink-0 whitespace-nowrap md:text-sm md:px-4 md:h-9">+ Add NonProfit</Button>
    </div>

    <!-- Search and Filters -->
    <div class="bg-card border rounded-lg p-3 md:p-4 mb-4">
      <div class="flex flex-col md:flex-row gap-3">
        <div class="flex-1">
          <Input
            type="text"
            id="search-input"
            placeholder="Search by name or slug..."
            class="w-full px-3 py-2 border rounded-lg text-sm"
          />
        </div>
        <div class="flex gap-2">
          <Select
            id="status-filter"
            class="px-3 py-2 border rounded-lg text-sm bg-background"
            options={[
              { value: "", label: "All Status" },
              { value: "draft", label: "Draft" },
              { value: "live", label: "Live" },
              { value: "paid", label: "Paid" },
              { value: "expired", label: "Expired" },
            ]}
          />
        </div>
      </div>
    </div>

    <!-- NonProfits List -->
    <div class="bg-card border rounded-lg p-3 md:p-4">
      <div class="flex items-center justify-between mb-4">
        <span id="non-profits-count" class="text-xs text-muted-foreground">Loading...</span>
      </div>
      <div id="non-profits-list" class="space-y-2">
        <p class="text-center text-muted-foreground py-4 text-sm">Loading...</p>
      </div>
    </div>
  </div>

  <!-- Create NonProfit Modal -->
  <div id="business-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
    <div class="bg-card border rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="p-4 border-b flex items-center justify-between">
        <h2 class="text-lg font-semibold leading-snug" id="modal-title">Create Non-Profit</h2>
        <Button id="close-modal" data-action="modal-close" class="p-1 hover:bg-muted rounded" variant="ghost" size="icon">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </Button>
      </div>
      <form id="business-form" class="p-4 space-y-4">
        <div>
          <label for="biz-title" class="block text-sm font-medium mb-1">Non-Profit Name *</label>
          <Input type="text" id="biz-title" name="title" required class="w-full px-3 py-2 border rounded-md text-sm" />
        </div>
        <div>
          <label for="biz-slug" class="block text-sm font-medium mb-1">Slug *</label>
          <Input type="text" id="biz-slug" name="slug" required class="w-full px-3 py-2 border rounded-md text-sm" />
        </div>
        <div>
          <label for="biz-email" class="block text-sm font-medium mb-1">Email</label>
          <Input type="email" id="biz-email" name="email" class="w-full px-3 py-2 border rounded-md text-sm" />
        </div>
        <div>
          <label for="biz-phone" class="block text-sm font-medium mb-1">Phone</label>
          <Input type="tel" id="biz-phone" name="phone" class="w-full px-3 py-2 border rounded-md text-sm" />
        </div>
        <div>
          <label for="biz-about" class="block text-sm font-medium mb-1">About Us</label>
          <div id="about-editor-container" class="min-h-[150px] border rounded-md overflow-hidden"></div>
        </div>
        <div>
          <label for="biz-updates" class="block text-sm font-medium mb-1">Latest Updates</label>
          <div id="updates-editor-container" class="min-h-[150px] border rounded-md overflow-hidden"></div>
        </div>
        <div class="flex gap-2 justify-end">
          <Button type="button" id="cancel-btn" data-action="modal-cancel" variant="outline" class="text-xs py-1 h-8">Cancel</Button>
          <Button type="submit" class="text-xs py-1 h-8">Create</Button>
        </div>
      </form>
    </div>
  </div>
</AdminLayout>

<script>
  interface NonProfitData {
    id: string;
    title: string;
    slug: string;
    email?: string;
    contactNumber?: string;
    aboutUs?: string;
    latestUpdates?: string;
    status: string;
  }

  // Auth fetch helper
  async function authFetch(url: string, options: RequestInit = {}): Promise<Response> {
    return fetch(url, {
      ...options,
      credentials: 'include',
      headers: {
        ...(options.body ? { 'Content-Type': 'application/json' } : {}),
        ...options.headers,
      },
    });
  }

  let businessList: NonProfitData[] = [];
  let aboutContent = '';
  let updatesContent = '';
  let editingId: string | null = null;

  // Load non-profits
  async function loadNonProfits() {
    try {
      const res = await authFetch('/api/admin/non-profits');
      const data = await res.json();

      const container = document.getElementById('non-profits-list');
      const countEl = document.getElementById('non-profits-count');
      if (!container) return;

      if (!data.success || data.data.length === 0) {
        container.innerHTML = '<p class="text-center text-muted-foreground py-8">No non-profits yet</p>';
        if (countEl) countEl.textContent = '0 non-profits';
        return;
      }

      businessList = data.data;
      renderNonProfits();
    } catch (err) {
      console.error('Error loading non-profits:', err);
    }
  }

  // Render non-profits with filters
  function renderNonProfits() {
    const container = document.getElementById('non-profits-list');
    const countEl = document.getElementById('non-profits-count');
    if (!container) return;

    const search = (document.getElementById('search-input') as HTMLInputElement)?.value.toLowerCase() || '';
    const status = (document.getElementById('status-filter') as HTMLSelectElement)?.value || '';

    const filtered = businessList.filter(biz => {
      const matchesSearch = !search ||
        biz.title?.toLowerCase().includes(search) ||
        biz.slug?.toLowerCase().includes(search);
      const matchesStatus = !status || biz.status === status;
      return matchesSearch && matchesStatus;
    });

    if (countEl) countEl.textContent = `${filtered.length} of ${businessList.length} non-profits`;

    if (filtered.length === 0) {
      container.innerHTML = '<p class="text-center text-muted-foreground py-8">No non-profits found</p>';
      return;
    }

    container.innerHTML = filtered.map((biz) => `
      <div class="flex items-center justify-between p-2 md:p-3 border rounded text-sm hover:bg-muted/30">
        <div class="min-w-0 flex-1">
          <p class="font-medium truncate">${escapeHtml(biz.title)}</p>
          <p class="text-xs text-muted-foreground">/${escapeHtml(biz.slug)}</p>
        </div>
        <div class="flex items-center gap-2 ml-2">
          <button class="text-xs px-2 py-1 border rounded hover:bg-muted" data-action="edit" data-id="${biz.id}">Edit</button>
          <span class="px-2 py-0.5 text-xs rounded-full ${biz.status === 'live' || biz.status === 'paid' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200'}">${capitalizeFirst(biz.status)}</span>
          <select class="text-xs border rounded px-1 py-0.5 bg-background" data-action="status-update" data-id="${biz.id}">
            <option value="draft" ${biz.status === 'draft' ? 'selected' : ''}>Draft</option>
            <option value="live" ${biz.status === 'live' ? 'selected' : ''}>Live</option>
            <option value="paid" ${biz.status === 'paid' ? 'selected' : ''}>Paid</option>
            <option value="expired" ${biz.status === 'expired' ? 'selected' : ''}>Expired</option>
          </select>
        </div>
      </div>
    `).join('');
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g, '&#39;');
  }

  function capitalizeFirst(str: string | null | undefined): string {
    if (!str) return '-';
    return str.charAt(0).toUpperCase() + str.slice(1);
  }

  // Render editors with simple textareas
  function renderEditors(initialAbout = '', initialUpdates = '') {
    aboutContent = initialAbout;
    updatesContent = initialUpdates;

    const aboutContainer = document.getElementById('about-editor-container')!;
    const updatesContainer = document.getElementById('updates-editor-container')!;

    aboutContainer.innerHTML = `<textarea name="aboutUs" rows="4" class="flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2.5 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-y" placeholder="Write about your non-profit...">${escapeHtml(initialAbout)}</textarea>`;
    updatesContainer.innerHTML = `<textarea name="latestUpdates" rows="4" class="flex min-h-[80px] w-full rounded-md border border-input bg-background px-3 py-2.5 text-base ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-50 resize-y" placeholder="Latest news and updates...">${escapeHtml(initialUpdates)}</textarea>`;
  }

  // Modal reference
  const modal = document.getElementById('business-modal');

  // Auto-generate slug from title
  document.getElementById('biz-title')?.addEventListener('input', (e) => {
    const title = (e.target as HTMLInputElement).value;
    const slugInput = document.getElementById('biz-slug') as HTMLInputElement;
    if (slugInput && !slugInput.dataset.userModified) {
      slugInput.value = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
  });

  document.getElementById('biz-slug')?.addEventListener('input', (e) => {
    (e.target as HTMLInputElement).dataset.userModified = 'true';
  });

  // Form submission
  document.getElementById('business-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);

    const aboutTextarea = document.querySelector('#about-editor-container textarea') as HTMLTextAreaElement;
    const updatesTextarea = document.querySelector('#updates-editor-container textarea') as HTMLTextAreaElement;
    
    const businessData = {
      title: String(formData.get('title') || ''),
      slug: String(formData.get('slug') || ''),
      email: String(formData.get('email') || ''),
      contactNumber: String(formData.get('phone') || ''),
      aboutUs: aboutTextarea?.value || aboutContent,
      status: 'draft',
    };

    try {
      const isEdit = editingId !== null;
      const res = await authFetch('/api/admin/non-profits' + (isEdit ? '/' + editingId : ''), {
        method: isEdit ? 'PUT' : 'POST',
        body: JSON.stringify(businessData),
      });

      const data = await res.json();

      if (data.success) {
        alert(isEdit ? 'Non-Profit updated successfully!' : 'Non-Profit created successfully!');
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        (e.target as HTMLFormElement).reset();
        editingId = null;
        loadNonProfits();
      } else {
        alert(data.error?.message || 'Failed to save non-profit');
      }
    } catch (err) {
      console.error('Error saving non-profit:', err);
      alert('Error saving non-profit');
    }
  });

  // Status update handler via document delegation
  document.addEventListener('change', async (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest('[data-action="status-update"]')) return;
    
    const select = target.closest('select') as HTMLSelectElement;
    if (!select) return;
    
    const id = select.dataset.id;
    const status = select.value;
    if (!id) return;

    try {
      const res = await fetch(`/api/admin/non-profits/${id}/status`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status }),
      });
      const data = await res.json();
      
      if (!data.success) {
        alert('Failed to update status');
        loadNonProfits();
      } else {
        alert('Status updated');
      }
    } catch (err) {
      console.error('Error updating status:', err);
      alert('Error updating status');
    }
  });

  // Document-level click handler for all actions
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    
    // Handle edit buttons
    const editBtn = target.closest('[data-action="edit"]');
    if (editBtn) {
      const id = (editBtn as HTMLElement).dataset.id;
      if (!id) return;

      const entity = businessList.find(b => b.id === id);
      if (!entity) return;

      (document.getElementById('biz-title') as HTMLInputElement).value = entity.title || '';
      (document.getElementById('biz-slug') as HTMLInputElement).value = entity.slug || '';
      (document.getElementById('biz-email') as HTMLInputElement).value = entity.email || '';
      (document.getElementById('biz-phone') as HTMLInputElement).value = entity.contactNumber || '';

      const modalTitle = document.getElementById('modal-title');
      if (modalTitle) modalTitle.textContent = 'Edit Non-Profit';
      editingId = id;
      aboutContent = entity.aboutUs || '';
      updatesContent = entity.latestUpdates || '';
      renderEditors(aboutContent, updatesContent);

      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      return;
    }

    // Handle modal controls
    if (target.closest('[data-action="modal-add"]')) {
      aboutContent = '';
      updatesContent = '';
      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
      renderEditors('', '');
      return;
    }

    if (target.closest('[data-action="modal-close"]') || target.closest('[data-action="modal-cancel"]')) {
      modal?.classList.add('hidden');
      modal?.classList.remove('flex');
      return;
    }

    // Close modal on backdrop click
    if (target === modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  });

  // Event listeners for search and filter
  document.getElementById('search-input')?.addEventListener('input', renderNonProfits);
  document.getElementById('status-filter')?.addEventListener('change', renderNonProfits);

  // Initialize
  loadNonProfits();
</script>