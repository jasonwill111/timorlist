---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { NonProfitsIsland } from '@/components/islands/admin';
import { getAdminNonProfits } from '@/lib/db/queries';

const nonProfits = await getAdminNonProfits();
---

<AdminLayout title="NonProfits">
  <div class="container py-4 px-2 md:py-6">
    <NonProfitsIsland nonProfits={nonProfits} />
  </div>
</AdminLayout>