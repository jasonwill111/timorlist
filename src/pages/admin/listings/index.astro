---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { ListingsIsland } from '@/components/islands/admin';
import { getAdminListings, getAdminListingStats } from '@/lib/db/queries';

const listings = await getAdminListings();
const stats = await getAdminListingStats();
---

<AdminLayout title="Listing Management">
  <div class="container py-8">
    <ListingsIsland listings={listings} stats={stats} />
  </div>
</AdminLayout>