import Input from '../../../components/ui/Input.astro';
---
import Select from '../../../components/ui/Select.astro';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Button from '../../../components/ui/Button.astro';

// Admin listing management page - API driven (listings table)
export const prerender = false;
---


<AdminLayout title="Listing Management">
  <div class="container py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-3xl font-bold leading-tight">Listing Management</h1>
        <p class="text-sm text-muted-foreground">Manage classified listings</p>
      </div>
      <a href="/admin/listings/new">
        <Button>
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
          </svg>
          New Listing
        </Button>
      </a>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
      <div class="bg-card rounded-lg border p-4">
        <div class="text-2xl font-bold" id="stat-total">-</div>
        <div class="text-xs text-muted-foreground">Total</div>
      </div>
      <div class="bg-card rounded-lg border p-4">
        <div class="text-2xl font-bold text-green-600" id="stat-published">-</div>
        <div class="text-xs text-muted-foreground">Published</div>
      </div>
      <div class="bg-card rounded-lg border p-4">
        <div class="text-2xl font-bold text-gray-600" id="stat-draft">-</div>
        <div class="text-xs text-muted-foreground">Draft</div>
      </div>
      <div class="bg-card rounded-lg border p-4">
        <div class="text-2xl font-bold text-red-600" id="stat-expired">-</div>
        <div class="text-xs text-muted-foreground">Expired</div>
      </div>
    </div>

    <!-- Filters -->
    <div class="flex flex-wrap gap-4 mb-6">
      <Select id="filter-status" options={[
        { value: '', label: 'All Status' },
        { value: 'draft', label: 'Draft' },
        { value: 'published', label: 'Published' },
      ]} />
      <Input
        id="search"
        type="search"
        placeholder="Search listings..."
        class="w-64"
      />
    </div>

    <!-- Listings Table -->
    <div class="bg-card rounded-lg border">
      <Table class="divide-y">
        <TableHeader>
          <TableRow>
            <TableHead>Title</TableHead>
            <TableHead>Status</TableHead>
            <TableHead>Price</TableHead>
            <TableHead class="text-right">Actions</TableHead>
          </TableRow>
        </TableHeader>
        <tbody id="listings-body" class="divide-y">
          <tr>
            <td colspan="4" class="text-center py-8 text-muted-foreground">
              <div class="flex justify-center">
                <div class="animate-spin rounded-full h-6 w-6 border-b-2 border-primary"></div>
              </div>
            </td>
          </tr>
        </tbody>
      </Table>

      <div id="no-results" class="hidden text-center py-12 text-muted-foreground">
        No listings found
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  // Auth fetch helper
  async function authFetch(url: string, options: RequestInit = {}): Promise<Response> {
    return fetch(url, {
      ...options,
      credentials: 'include',
      headers: {
        ...(options.body ? { 'Content-Type': 'application/json' } : {}),
        ...options.headers,
      },
    });
  }

  interface Listing {
    id: string;
    title: string;
    slug: string;
    status: string;
    price: string | null;
    createdAt: number;
    planExpiresAt: number | null;
  }

  const statusColors: Record<string, string> = {
    draft: 'bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300',
    published: 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
  };

  function formatDate(timestamp: number): string {
    return new Date(timestamp * 1000).toLocaleDateString();
  }

  function escapeHtml(str: string): string {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g, '&#39;');
  }

  const statusFilter = document.getElementById('filter-status') as HTMLSelectElement;
  const searchInput = document.getElementById('search') as HTMLInputElement;
  const tbody = document.getElementById('listings-body') as HTMLTableSectionElement;
  const noResults = document.getElementById('no-results') as HTMLDivElement;

  let listings: Listing[] = [];

  async function loadListings() {
    try {
      const res = await authFetch('/api/admin/listing');
      const data = await res.json();

      if (data.success) {
        listings = data.data || [];
        updateStats();
        renderListings();
      } else {
        console.error('API error:', data.error);
        tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-red-500">Failed to load listings</td></tr>';
      }
    } catch (err) {
      console.error('Failed to load listings:', err);
      tbody.innerHTML = '<tr><td colspan="4" class="text-center py-8 text-red-500">Failed to load listings</td></tr>';
    }
  }

  function updateStats() {
    const now = Date.now() / 1000;
    const total = listings.length;
    const published = listings.filter(l => l.status === 'published').length;
    const draft = listings.filter(l => l.status === 'draft').length;
    const expired = listings.filter(l => l.planExpiresAt && l.planExpiresAt < now).length;

    document.getElementById('stat-total')!.textContent = String(total);
    document.getElementById('stat-published')!.textContent = String(published);
    document.getElementById('stat-draft')!.textContent = String(draft);
    document.getElementById('stat-expired')!.textContent = String(expired);
  }

  function renderListings() {
    const search = searchInput?.value.toLowerCase() || '';
    const status = statusFilter?.value || '';

    const filtered = listings.filter(l => {
      if (search && !l.title.toLowerCase().includes(search)) return false;
      if (status && l.status !== status) return false;
      return true;
    });

    if (filtered.length === 0) {
      tbody.innerHTML = '';
      noResults.classList.remove('hidden');
      return;
    }

    noResults.classList.add('hidden');

    tbody.innerHTML = filtered.map(listing => `
      <tr class="hover:bg-muted/30">
        <td class="px-4 py-3">
          <div class="font-medium">${escapeHtml(listing.title)}</div>
          <div class="text-xs text-muted-foreground">
            Created ${formatDate(listing.createdAt)}
          </div>
        </td>
        <td class="px-4 py-3">
          <span class="px-2 py-0.5 text-xs rounded-full ${statusColors[listing.status] || statusColors.draft}">
            ${listing.status || 'draft'}
          </span>
        </td>
        <td class="px-4 py-3">
          ${listing.price || '-'}
        </td>
        <td class="px-4 py-3 text-right">
          <div class="flex items-center justify-end gap-2">
            <a
              href="/admin/listings/${listing.id}/edit"
              data-action="edit-listing"
              data-id="${listing.id}"
              class="edit-listing text-sm text-primary hover:underline"
            >
              Edit
            </a>
            <button
              data-action="toggle-status"
              data-id="${listing.id}"
              data-status="${listing.status}"
              class="toggle-status text-sm text-primary hover:underline"
            >
              ${listing.status === 'published' ? 'Unpublish' : 'Publish'}
            </button>
            <button
              data-action="delete-listing"
              data-id="${listing.id}"
              class="delete-listing text-sm text-red-500 hover:underline"
            >
              Delete
            </button>
            <a href="/listing/${listing.slug}" target="_blank" class="text-sm text-muted-foreground hover:text-foreground">
              View →
            </a>
          </div>
        </td>
      </tr>
    `).join('');

    // Event delegation handles all actions via data-action attributes
  }
  async function handleToggleStatus(id: string, currentStatus: string) {
    const newStatus = currentStatus === 'published' ? 'draft' : 'published';
    try {
      const res = await authFetch('/api/admin/listing', {
        method: 'PUT',
        body: JSON.stringify({ id, status: newStatus }),
      });
      const data = await res.json();
      if (data.success) {
        loadListings();
      } else {
        alert('Failed to update listing');
      }
    } catch (err) {
      console.error('Error:', err);
      alert('Failed to update listing');
    }
  }
  async function handleDeleteListing(id: string) {
    if (!confirm('Are you sure you want to delete this listing?')) return;
    try {
      const res = await authFetch('/api/admin/listing', {
        method: 'DELETE',
        body: JSON.stringify({ id }),
      });
      const data = await res.json();
      if (data.success) {
        loadListings();
      } else {
        alert('Failed to delete listing');
      }
    } catch (err) {
      console.error('Error:', err);
      alert('Failed to delete listing');
    }
  }
  // Event delegation - single listener for all listing actions
  document.addEventListener('click', (e) => {
    const btn = e.target.closest('[data-action]');
    if (!btn) return;
    const action = btn.dataset.action;
    const id = btn.dataset.id;
    const status = btn.dataset.status;
    switch (action) {
      case 'edit-listing':
        window.location.href = `/admin/listings/${id}/edit`;
        break;
      case 'toggle-status':
        handleToggleStatus(id!, status!);
        break;
      case 'delete-listing':
        handleDeleteListing(id!);
        break;
    }
  });

  // Filter listeners
  statusFilter?.addEventListener('change', renderListings);
  searchInput?.addEventListener('input', renderListings);

  // Initial load
  loadListings();
</script>