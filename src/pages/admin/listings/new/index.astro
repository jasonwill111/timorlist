---
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';
import { Select } from '@/components/ui/select';
// Admin new listing page - for listings table
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { getDb } from '@/lib/db';
import { listingCategories } from '@/db/schema';
import { eq } from 'drizzle-orm';

const db = await getDb();

// Get all listing categories grouped by parent
const allCategories = await db
  .select()
  .from(listingCategories)
  .orderBy(listingCategories.name)
  .all();
const parentCategories = allCategories.filter(c => !c.parentId);
const getChildren = (parentId: string) => allCategories.filter(c => c.parentId === parentId);

const conditions = [
  { value: 'new', label: 'New' },
  { value: 'like-new', label: 'Like New' },
  { value: 'good', label: 'Good' },
  { value: 'fair', label: 'Fair' },
  { value: 'poor', label: 'Poor' },
];
---

<AdminLayout title="New Listing - Admin">
  <div class="container py-8 max-w-4xl">
    <div class="mb-6">
      <a href="/admin/listings" class="text-sm text-muted-foreground hover:text-foreground flex items-center gap-1 mb-2">
        &larr; Back to Listings
      </a>
      <h1 class="text-3xl font-bold leading-tight">Create New Listing</h1>
    </div>

    <form id="listing-form" class="space-y-6">
      <!-- Basic Info -->
      <div class="bg-card rounded-lg border p-6">
        <h2 class="text-lg font-semibold leading-snug mb-4">Basic Information</h2>
        <div class="space-y-4">
          <div>
            <Input
              type="text"
              name="title"
              required
              placeholder="What are you listing?"
            />
          </div>

          <div>
            <Select name="categoryId" class="w-full h-10 px-3 rounded-md border border-input bg-background">
              <option value="">Select category...</option>
              {parentCategories.map(parent => (
                <optgroup label={parent.name}>
                  {getChildren(parent.id).map(child => (
                    <option value={child.id}>{child.name}</option>
                  ))}
                </optgroup>
              ))}
            </Select>
          </div>

          <div>
            <Input
              type="text"
              name="price"
              placeholder="$100 or Negotiable"
            />
          </div>

          <div>
            <label class="block text-sm font-medium mb-1">Condition</label>
            <Select name="condition" class="w-full h-10 px-3 rounded-md border border-input bg-background">
              <option value="">Select condition...</option>
              {conditions.map(cond => (
                <option value={cond.value}>{cond.label}</option>
              ))}
            </Select>
          </div>
        </div>
      </div>

      <!-- Description -->
      <div class="bg-card rounded-lg border p-6">
        <Textarea
          name="description"
          required
          rows={6}
          placeholder="Describe your listing..."
        />
      </div>

      <!-- Location & Contact -->
      <div class="bg-card rounded-lg border p-6">
        <h2 class="text-lg font-semibold leading-snug mb-4">Location & Contact</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <Input
              type="text"
              name="location"
              placeholder="Dili, Timor-Leste"
            />
          </div>
          <div>
            <Input
              type="text"
              name="contactName"
              placeholder="Your name"
            />
          </div>
          <div>
            <Input
              type="tel"
              name="contactNumber"
              placeholder="7700 0000"
            />
          </div>
          <div>
            <Input
              type="email"
              name="email"
              placeholder="email@example.com"
            />
          </div>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex gap-4">
        <Button
          type="submit"
          name="status"
          value="draft"
          variant="outline"
        >
          Save as Draft
        </Button>
        <Button
          type="submit"
          name="status"
          value="published"
        >
          Publish Now
        </Button>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById('listing-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const data = Object.fromEntries(formData);

    // Get status from button
    const submitter = (e as SubmitEvent).submitter as HTMLButtonElement;
    const status = submitter?.value || 'draft';

    try {
      const result = await actions.admin.listings.create({
        title: data.get('title') as string,
        categoryId: data.get('categoryId') as string || undefined,
        description: data.get('description') as string,
        price: data.get('price') as string || undefined,
        condition: data.get('condition') as 'new' | 'like-new' | 'good' | 'fair' | 'poor' || undefined,
        location: data.get('location') as string || undefined,
        contactName: data.get('contactName') as string || undefined,
        contactNumber: data.get('contactNumber') as string || undefined,
        email: data.get('email') as string || undefined,
        status: status as 'draft' | 'published',
      });
      if (result.success) {
        window.location.href = '/admin/listings';
      } else {
        alert('Failed: ' + (result.error?.message || 'Unknown error'));
      }
    } catch (err) {
      console.error('Error:', err);
      alert('Failed to create listing');
    }
  });
</script>
