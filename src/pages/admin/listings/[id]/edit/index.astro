---
// Admin edit listing page
export const prerender = false;

import Layout from '../../../../../layouts/Layout.astro';
import { Button } from '../../../../../components/fulldev/button';
import { Label } from '../../../../../components/fulldev/label';
import { Input } from '../../../../../components/fulldev/input';
import { Textarea } from '../../../../../components/fulldev/textarea';
import { Select } from '../../../../../components/fulldev/select';
import { getAllListingCategories } from '@/lib/db/queries/listings';
import { getListingById } from '@/lib/db/queries/admin-listings';
import { actions } from 'astro:actions';
import { HiddenField } from '@/components/fulldev/hidden';

const { id } = Astro.params;

const listing = await getListingById(id ?? '');
if (!listing) {
  return Astro.redirect('/admin/listings');
}

const allCategories = await getAllListingCategories();
---

<Layout title={`Edit ${listing.title} - Admin`} requireAuth adminOnly>
  <div class="container py-8 max-w-4xl">
    <div class="mb-6">
      <a href="/admin/listings" class="text-sm text-muted-foreground hover:text-foreground flex items-center gap-1 mb-2">
        ← Back to Listings
      </a>
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-bold leading-tight">Edit Listing</h1>
        <span class={`px-2 py-0.5 text-xs rounded-full ${
          listing.status === 'published' ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-700'
        }`}>
          {listing.status || 'draft'}
        </span>
      </div>
    </div>

    <form id="listing-form" class="space-y-6">
      <!-- Type (read-only) -->
      <div class="bg-card rounded-lg border p-6">
        <h2 class="text-lg font-semibold leading-snug mb-4">Listing Type</h2>
        <div class="flex items-center gap-4">
          <span class="text-3xl">🏪</span>
          <div>
            <div class="font-medium">Business</div>
            <div class="text-xs text-muted-foreground">Type cannot be changed after creation</div>
          </div>
        </div>
        <HiddenField name="entityType" value="business" />
      </div>

      <!-- Basic Info -->
      <div class="bg-card rounded-lg border p-6">
        <h2 class="text-lg font-semibold leading-snug mb-4">Basic Information</h2>
        <div class="grid gap-4">
          <div>
            <Label for="title">Title *</Label>
            <Input name="title" value={listing.title} required />
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <Label for="category">Category *</Label>
              <Select
                name="categoryId"
                required
                options={allCategories.map(cat => ({ value: cat.id, label: cat.name }))}
                value={listing.categoryId}
              />
            </div>
          </div>
      </div>

      <!-- Contact Info -->
      <div class="bg-card rounded-lg border p-6">
        <h2 class="text-lg font-semibold leading-snug mb-4">Contact Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <Label for="contactName">Contact Name</Label>
            <Input name="contactName" value={listing.contactName || ''} />
          </div>
          <div class="grid grid-cols-3 gap-2">
            <div>
              <Label for="countryCode">Code</Label>
              <Input name="countryCode" value={listing.countryCode || '+670'} />
            </div>
            <div class="col-span-2">
              <Label for="contactNumber">Phone</Label>
              <Input name="contactNumber" value={listing.contactNumber || ''} />
            </div>
          </div>
          <div>
            <Label for="email">Email</Label>
            <Input name="email" type="email" value={listing.email || ''} />
          </div>
          <div>
                     </div>
        </div>
        <div class="mt-4">
          <Label for="address">Address</Label>
          <Input name="address" value={listing.address || ''} />
        </div>
      </div>

      <!-- Status -->
      <div class="bg-card rounded-lg border p-6">
        <h2 class="text-lg font-semibold leading-snug mb-4">Status</h2>
        <div class="flex flex-wrap gap-4">
          <Label for="status-draft">
            <Input id="status-draft" type="radio" name="status" value="draft" checked={listing.status === 'draft'} />
            <span>Draft</span>
          </label>
          <Label for="status-published">
            <Input id="status-published" type="radio" name="status" value="published" checked={listing.status === 'published'} />
            <span>Published</span>
          </label>
        </div>
      </div>

      <!-- Submit -->
      <div class="flex items-center justify-end gap-4">
        <a href="/admin/listings">
          <Button type="button" variant="outline">Cancel</Button>
        </a>
        <Button type="submit">Save Changes</Button>
      </div>
    </form>
  </div>
</Layout>

<script>
  const form = document.getElementById('listing-form') as HTMLFormElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(form);

    const data = {
      title: formData.get('title'),
      categoryId: formData.get('categoryId'),
      contactName: formData.get('contactName') || null,
      countryCode: formData.get('countryCode') || '+670',
      contactNumber: formData.get('contactNumber') || null,
      email: formData.get('email') || null,
           address: formData.get('address') || null,
      tags: formData.get('tags') ? formData.get('tags')?.toString().split(',').map(t => t.trim()) : null,
      status: formData.get('status'),
    };

    try {
      const result = await actions.admin.listings.update({ id: window.location.pathname.split('/').pop()!, ...data });
      if (result.success) {
        alert('Listing updated successfully!');
        window.location.href = '/admin/listings';
      } else {
        alert('Failed: ' + (result.error?.message || 'Unknown error'));
      }
    } catch (err) {
      alert('Failed to update listing');
    }
  });
</script>
