---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { BusinessesIsland } from '@/components/islands/admin';
import { getAdminBusinesses } from '@/lib/db/queries';

const businesses = await getAdminBusinesses();
---

<AdminLayout title="Businesses">
  <div class="container py-4 px-2 md:py-6">
    <BusinessesIsland businesses={businesses} />
  </div>
</AdminLayout>