---

import AdminLayout from '@/layouts/AdminLayout.astro';
import { actions } from 'astro:actions';
import { getAdminUser } from '@/lib/admin-auth';
import { getMediaList } from '@/lib/db/queries/media-listing';
import { Select } from '@/components/fulldev/select';
import { Input } from '@/components/fulldev/input';
import { Label } from '@/components/fulldev/label';
import { Button } from '@/components/fulldev/button';
import { Dropzone } from '@/components/starwind/dropzone';
import MediaIsland from '@/components/islands/admin/MediaIsland.astro';
import Pagination from '@/components/starwind/pagination/Pagination.astro';
import PaginationContent from '@/components/starwind/pagination/PaginationContent.astro';
import PaginationItem from '@/components/starwind/pagination/PaginationItem.astro';
import PaginationLink from '@/components/starwind/pagination/PaginationLink.astro';
import PaginationPrevious from '@/components/starwind/pagination/PaginationPrevious.astro';
import PaginationNext from '@/components/starwind/pagination/PaginationNext.astro';


// Check admin auth using KV session
const adminUser = await getAdminUser(Astro.request);

if (!adminUser) {
  return Astro.redirect('/admin/login');
}

// Get query params for filtering
const url = new URL(Astro.request.url);
const entityTypeFilter = url.searchParams.get('entityType') || '';
const entityIdFilter = url.searchParams.get('entityId') || '';
const categoryFilter = url.searchParams.get('category') || '';
const page = parseInt(url.searchParams.get('page') || '1');
const limit = 24;

// Load data via query function
const { items: mediaItems, total, totalPages, totalSizeMB, entityTypes, categories } = await getMediaList(
  entityTypeFilter, entityIdFilter, categoryFilter, page, limit
);

// Helper to format file size
function formatSize(bytes: number | null): string {
  if (!bytes) return '0 B';
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
}

// Helper to get media icon
function getMediaIcon(type: string | null): string {
  if (type === 'video') return '🎬';
  if (type === 'image') return '🖼️';
  return '📄';
}

// Helper to get media thumbnail URL
function getThumbnailUrl(item: MediaData): string {
  if (item.url?.startsWith('data:')) return item.url;
  if (item.url?.startsWith('http')) return item.url;
  return `/api/media/${item.id}`;
}

// Build pagination URL helper for admin/media
const buildMediaUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (entityTypeFilter) p.set('entityType', entityTypeFilter);
  if (categoryFilter) p.set('category', categoryFilter);
  if (entityIdFilter) p.set('entityId', entityIdFilter);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/admin/media?${p.toString()}`;
}
---

<AdminLayout title="Media Library">
  <div class="p-6">
    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-6">
      <div class="min-w-0">
        <h1 class="text-3xl font-bold leading-tight truncate">Media Library</h1>
        <p class="text-muted-foreground text-xs md:text-sm">
          {total} files • {totalSizeMB} MB total
        </p>
      </div>
      <div class="flex gap-2 flex-shrink-0">
        <Button form="upload-form" type="submit" class="text-xs px-2 py-1 h-7 border rounded-lg hover:bg-muted flex items-center gap-1 md:text-sm md:px-4 md:h-9">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/>
          </svg>
          Upload
        </Button>
      </div>
    </div>

    <!-- Filters -->
    <div class="bg-card border rounded-xl p-4 mb-6">
      <form id="filter-form" class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[150px]">
          <Label>Entity Type</Label>
          <Select name="entityType" value={entityTypeFilter} options={[
            { value: "", label: "All Types" },
            { value: "business", label: "Business" },
            { value: "nonprofit", label: "Nonprofit" },
            { value: "blog", label: "Blog" },
            { value: "page", label: "Page" },
            { value: "general", label: "General" },
          ]} />
        </div>

        <div class="flex-1 min-w-[150px]">
          <Label>Category</Label>
          <Select name="category" value={categoryFilter} options={[
            { value: "", label: "All Categories" },
            { value: "profile", label: "Profile" },
            { value: "banner", label: "Banner" },
            { value: "gallery", label: "Gallery" },
            { value: "sku", label: "SKU" },
            { value: "updates", label: "Updates" },
            { value: "cover", label: "Cover" },
            { value: "thumbnail", label: "Thumbnail" },
            { value: "hero", label: "Hero" },
            { value: "files", label: "Files (PDF/Doc)" },
            { value: "avatar", label: "Avatar" },
          ]} />
        </div>

        <div class="flex-1 min-w-[200px]">
          <Label>Entity ID</Label>
          <Input
            type="text"
            name="entityId"
            value={entityIdFilter}
            placeholder="Filter by ID..."
          />
        </div>


        <Button type="submit" class="text-xs px-2 py-1 h-7 bg-primary text-primary-foreground rounded-lg hover:bg-primary/90 md:text-sm md:px-4 md:h-9">
          Filter
        </Button>
        <a href="/admin/media" class="text-xs px-2 py-1 h-7 border rounded-lg hover:bg-muted md:text-sm md:px-4 md:h-9">
          Reset
        </a>
      </form>
    </div>

    <!-- Media Grid -->
    {mediaItems.length === 0 ? (
      <div class="bg-card border rounded-xl p-12 text-center">
        <div class="text-6xl mb-4">📁</div>
        <h3 class="text-lg font-medium leading-snug mb-2">No media found</h3>
        <p class="text-muted-foreground">Upload some files to get started</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
        {mediaItems.map((item) => (
          <div class="bg-card border rounded-xl overflow-hidden group" data-media-item={item.id}>
            <div class="aspect-square bg-muted relative">
              {item.type === 'image' ? (
                <img
                  src={getThumbnailUrl(item)}
                  alt={item.alt || item.filename}
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              ) : item.type === 'video' ? (
                <div class="w-full h-full flex items-center justify-center text-4xl">
                  🎬
                </div>
              ) : (
                <div class="w-full h-full flex items-center justify-center text-4xl">
                  📄
                </div>
              )}

              <!-- Overlay with actions -->
              <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2">
                <Button
                  class="p-2 bg-white/20 hover:bg-white/30 rounded-lg text-white copy-url"
                  data-action="copy-url"
                  data-url={item.url}
                  title="Copy URL"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                  </svg>
                </Button>
                <Button
                  class="p-2 bg-red-500/80 hover:bg-red-500 rounded-lg text-white delete-media"
                  data-action="delete-media"
                  data-id={item.id}
                  title="Delete"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                </Button>
              </div>

              <!-- Type badge -->
              <div class="absolute top-2 left-2 px-2 py-1 bg-black/50 rounded text-xs text-white">
                {item.type || 'file'}
              </div>
            </div>

            <div class="p-2">
              <p class="text-sm truncate" title={item.filename}>{item.filename}</p>
              <p class="text-xs text-muted-foreground">{formatSize(item.size)}</p>
              {item.entityType && (
                <p class="text-xs text-muted-foreground/70 truncate" title={`${item.entityType}/${item.entityId}`}>
                  {item.entityType} {item.category && `• ${item.category}`}
                </p>
              )}
            </div>
          </div>
        ))}
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <Pagination class="mt-6">
        <PaginationContent>
          {page > 1 && (
            <PaginationItem>
              <PaginationPrevious href={buildMediaUrl(page - 1)} />
            </PaginationItem>
          )}
          <PaginationItem>
            <PaginationLink class="px-4 py-2 border rounded-lg">
              Page {page} of {totalPages}
            </PaginationLink>
          </PaginationItem>
          {page < totalPages && (
            <PaginationItem>
              <PaginationNext href={buildMediaUrl(page + 1)} />
            </PaginationItem>
          )}
        </PaginationContent>
      </Pagination>
    )}
  </div>
</AdminLayout>

<MediaIsland />
