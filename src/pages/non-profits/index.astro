---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { Button } from '@/components/fulldev/button';
import CarouselBanner from '../../components/fulldev/CarouselBanner.astro';
import { getNonProfitCategories, getNonProfits } from '@/lib/db/queries/non-profits';

const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const parentCat = searchParams.get('parent') || '';
const childCat = searchParams.get('child') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;

Astro.response.headers.set('Cache-Control', search || parentCat || childCat
  ? 'public, max-age=30, s-maxage=60, stale-while-revalidate=120'
  : 'public, max-age=60, s-maxage=120, stale-while-revalidate=300');

const { parentCats, categoryMap, childMap } = await getNonProfitCategories();
const { results, total, totalPages } = await getNonProfits(search, parentCat, childCat, page, LIMIT);

for (const r of results) {
  r.categoryName = r.category_id ? categoryMap[r.category_id] || '' : '';
}

const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (search) p.set('q', search);
  if (parentCat) p.set('parent', parentCat);
  if (childCat) p.set('child', childCat);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/non-profits?${p.toString()}`;
};
---

<Layout title="Non-Profits - TimorUp">
  <div class="max-w-7xl mx-auto px-4" data-page-content>
    <CarouselBanner position="nonprofits" class="mb-6" />

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Non-Profits</h1>
      <span class="text-sm text-muted-foreground">{total} organizations</span>
    </div>

    {parentCats.length > 0 && (
      <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
        <Button as="a" href="/non-profits" variant={!parentCat ? 'default' : 'secondary'} size="sm">
          All
        </Button>
        {parentCats.map(c => (
          <Button
            as="a"
            href={`/non-profits?parent=${c.id}`}
            variant={parentCat === c.id ? 'default' : 'secondary'}
            size="sm"
          >
            {c.name}
          </Button>
        ))}
      </div>
    )}

    {results.length > 0 ? (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {results.map(n => (
            <BusinessCard
              title={n.title}
              slug={n.slug}
              category={n.categoryId ? categoryMap[n.categoryId] || '' : ''}
              address={n.address || ''}
              tags={n.tags ? (n.tags.startsWith('[') ? JSON.parse(n.tags) : n.tags.split(',').map(t => t.trim())) : []}
              likes={n.likes || 0}
              saves={n.saves || 0}
              views={n.views || 0}
              ratingAverage={0}
              ratingCount={0}
              imageId={n.profile_image_id}
              entityType="nonprofit"
              aboutUs={n.aboutUs}
            />
          ))}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-2 mt-8" aria-label="Pagination">
            {page > 1 && (
              <Button as="a" href={buildUrl(page - 1)} variant="secondary" size="sm">
                ← Previous
              </Button>
            )}
            {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
              const pageNum = i + 1;
              const isActive = pageNum === page;
              return (
                <Button
                  as="a"
                  href={buildUrl(pageNum)}
                  variant={isActive ? 'default' : 'secondary'}
                  size="sm"
                >
                  {pageNum}
                </Button>
              );
            })}
            {page < totalPages && (
              <Button as="a" href={buildUrl(page + 1)} variant="secondary" size="sm">
                Next →
              </Button>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <h3 class="text-lg font-medium mb-2">No non-profits found</h3>
        <p class="text-muted-foreground">Try a different category or search term</p>
        <Button as="a" href="/non-profits" class="mt-4">
          View all non-profits
        </Button>
      </div>
    )}
  </div>
</Layout>
