---
import Layout from '@/layouts/Layout.astro';
import { getBlogListing } from '@/lib/db/queries/blog-listing';
import { Button } from '@/components/fulldev/button';
import { Badge } from '@/components/fulldev/badge';
import Pagination from '@/components/starwind/pagination/Pagination.astro';
import PaginationContent from '@/components/starwind/pagination/PaginationContent.astro';
import PaginationItem from '@/components/starwind/pagination/PaginationItem.astro';
import PaginationLink from '@/components/starwind/pagination/PaginationLink.astro';
import PaginationPrevious from '@/components/starwind/pagination/PaginationPrevious.astro';
import PaginationNext from '@/components/starwind/pagination/PaginationNext.astro';

export const prerender = false;

const searchParams = Astro.url.searchParams;
const categorySlug = searchParams.get('category') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=1800, stale-while-revalidate=3600');

const { posts, categories, total, totalPages } = await getBlogListing(categorySlug, page, LIMIT);

const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (categorySlug) p.set('category', categorySlug);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/blog?${p.toString()}`;
};

const blogSchema = {
  "@context": "https://schema.org",
  "@type": "Blog",
  "name": "Timor-Leste Blog",
  "description": "Travel guides, local insights, and news about Timor-Leste",
  "url": "https://timorup.com/blog",
  "publisher": {
    "@type": "Organization",
    "name": "TimorUp",
    "url": "https://timorup.com"
  }
};
---

<Layout 
  title="Blog - TimorUp" 
  description="Travel guides, local insights, and news about Timor-Leste"
  structuredData={blogSchema}
>
  <main class="container mx-auto px-4 py-8 max-w-6xl">
    <!-- Header -->
    <div class="text-center mb-12">
      <h1 class="text-4xl font-bold text-foreground mb-4">Timor-Leste Blog</h1>
      <p class="text-lg text-muted-foreground max-w-2xl mx-auto">
        Discover travel guides, local insights, and the latest news about Timor-Leste
      </p>
      <span class="text-sm text-muted-foreground mt-2">{total} articles</span>
    </div>

    <!-- Category Pills -->
    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 justify-center mb-8">
        <Button as="a" href="/blog" variant={!categorySlug ? 'default' : 'secondary'} size="sm">
          All
        </Button>
        {categories.map((category) => (
          <Button
            as="a"
            href={`/blog?category=${(category as { slug: string }).slug}`}
            variant={categorySlug === (category as { slug: string }).slug ? 'default' : 'secondary'}
            size="sm"
          >
            {(category as { name: string }).name}
          </Button>
        ))}
      </div>
    )}

    <!-- Blog Grid -->
    {posts.length > 0 ? (
      <>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post) => {
            const postTags = (post as { tags?: string }).tags ? JSON.parse((post as { tags: string }).tags) : [];
            const publishedAt = (post as { publishedAt?: string | Date }).publishedAt;
            const createdAt = (post as { createdAt?: string | Date }).createdAt;
            const publishDate = publishedAt
              ? new Date(publishedAt).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric',
                })
              : createdAt
                ? new Date(createdAt).toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })
                : '';

            return (
              <a
                href={`/blog/${(post as { slug: string }).slug}`}
                class="group block bg-card rounded-2xl overflow-hidden border border-border/50 hover:border-primary/40 hover:shadow-lg transition-all duration-300"
              >
                {/* Cover Image */}
                <div class="aspect-video bg-gradient-to-br from-primary/20 to-primary/5 flex items-center justify-center overflow-hidden">
                  {(post as { coverImageId: string | null }).coverImageId ? (
                    <img 
                      src={`/api/media/${(post as { coverImageId: string }).coverImageId}`}
                      alt={(post as { title: string }).title}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <svg
                      class="w-16 h-16 text-primary/40"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
                      />
                    </svg>
                  )}
                </div>

                {/* Content */}
                <div class="p-5">
                  {/* Tags */}
                  {postTags.length > 0 && (
                    <div class="flex flex-wrap gap-1 mb-3">
                      {postTags.slice(0, 2).map((tag: string) => (
                        <Badge variant="outline" class="bg-primary/10 text-primary border-primary/20 text-xs font-normal">
                          {tag}
                        </Badge>
                      ))}
                    </div>
                  )}

                  {/* Title */}
                  <h2 class="text-xl font-bold text-foreground mb-2 line-clamp-2 group-hover:text-primary transition-colors">
                    {(post as { title: string }).title}
                  </h2>

                  {/* Excerpt */}
                  {(post as { excerpt?: string }).excerpt && (
                    <p class="text-muted-foreground text-sm mb-4 line-clamp-3">
                      {(post as { excerpt: string }).excerpt}
                    </p>
                  )}

                  {/* Meta */}
                  <div class="flex items-center justify-between text-sm text-muted-foreground">
                    <span>{(post as { authorName?: string }).authorName || 'TimorUp'}</span>
                    <span>{publishDate}</span>
                  </div>
                </div>
              </a>
            );
          })}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <Pagination class="mt-8">
            <PaginationContent>
              {page > 1 && (
                <PaginationItem>
                  <PaginationPrevious href={buildUrl(page - 1)} />
                </PaginationItem>
              )}
              {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
                const pageNum = i + 1;
                const isActive = pageNum === page;
                return (
                  <PaginationItem>
                    <PaginationLink href={buildUrl(pageNum)} isActive={isActive}>
                      {pageNum}
                    </PaginationLink>
                  </PaginationItem>
                );
              })}
              {page < totalPages && (
                <PaginationItem>
                  <PaginationNext href={buildUrl(page + 1)} />
                </PaginationItem>
              )}
            </PaginationContent>
          </Pagination>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <svg
          class="w-16 h-16 text-muted-foreground/50 mx-auto mb-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"
          />
        </svg>
        <h3 class="text-xl font-semibold text-foreground mb-2">No blog posts found</h3>
        <p class="text-muted-foreground">
          {categorySlug ? 'Try a different category or browse all posts.' : 'Check back soon for travel guides and local insights about Timor-Leste.'}
        </p>
        <Button as="a" href="/blog" class="mt-4">
          View all posts
        </Button>
      </div>
    )}
  </main>
</Layout>
