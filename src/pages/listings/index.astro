---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import CarouselBanner from '../../components/fulldev/CarouselBanner.astro';
import ListingCard from '../../components/business/ListingCard.astro';
import { Input } from '../../components/fulldev/input';
import { Select } from '../../components/fulldev/select';
import { getListings, TYPE_TO_CATEGORY_SLUGS } from '@/lib/db/queries/listings-listing';
import Pagination from '@/components/starwind/pagination/Pagination.astro';
import PaginationContent from '@/components/starwind/pagination/PaginationContent.astro';
import PaginationItem from '@/components/starwind/pagination/PaginationItem.astro';
import PaginationLink from '@/components/starwind/pagination/PaginationLink.astro';
import PaginationPrevious from '@/components/starwind/pagination/PaginationPrevious.astro';
import PaginationNext from '@/components/starwind/pagination/PaginationNext.astro';

const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const type = searchParams.get('type') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;

const hasSearchParams = search || type;
Astro.response.headers.set('Cache-Control', hasSearchParams
  ? 'public, max-age=30, s-maxage=60, stale-while-revalidate=120'
  : 'public, max-age=60, s-maxage=120, stale-while-revalidate=300');

const { results, total, totalPages } = await getListings(search, type, page, LIMIT);

const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (search) p.set('q', search);
  if (type) p.set('type', type);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/listings?${p.toString()}`;
};
---

<Layout title="Classified Ads - TimorUp">
  <div class="max-w-7xl mx-auto px-4" data-page-content>
    <CarouselBanner position="listings" class="mb-6" />

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold leading-tight">Classified Ads</h1>
      <span class="text-sm text-muted-foreground">{total} total</span>
    </div>

    <form method="GET" action="/listings" class="bg-card rounded-2xl border border-border/50 p-4 mb-6 shadow-sm">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <Input name="q" type="search" placeholder="Search listings..." value={search}
            class="pl-10 pr-4 border-border focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-200" />
        </div>
        <div class="flex gap-2">
          <Select
            name="type"
            class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors"
            options={[
              { value: '', label: 'All Types' },
              { value: 'product', label: 'Product' },
              { value: 'vehicle', label: 'Vehicle' },
              { value: 'property', label: 'Property' },
              { value: 'job', label: 'Job' },
              { value: 'service', label: 'Service' },
              { value: 'wanted', label: 'Wanted' },
            ]}
            value={type}
            onchange="this.form.submit()"
          />
    </form>

    {results.length > 0 ? (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {results.map(l => (
            <ListingCard
              title={l.title}
              slug={l.slug}
              price={l.price || ''}
              listingType={type || 'product'}
              location={l.location?.split(',')[0] || ''}
              imageIds={l.imageIds ? (typeof l.imageIds === 'string' ? JSON.parse(l.imageIds) : l.imageIds) : []}
              likes={l.likes || 0}
              views={l.views || 0}
            />
          ))}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <Pagination class="mt-8">
            <PaginationContent>
              {page > 1 && (
                <PaginationItem>
                  <PaginationPrevious href={buildUrl(page - 1)} />
                </PaginationItem>
              )}
              {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
                const pageNum = i + 1;
                const isActive = pageNum === page;
                return (
                  <PaginationItem>
                    <PaginationLink href={buildUrl(pageNum)} isActive={isActive}>
                      {pageNum}
                    </PaginationLink>
                  </PaginationItem>
                );
              })}
              {page < totalPages && (
                <PaginationItem>
                  <PaginationNext href={buildUrl(page + 1)} />
                </PaginationItem>
              )}
            </PaginationContent>
          </Pagination>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <h3 class="text-lg font-medium mb-2">No listings found</h3>
        <p class="text-muted-foreground">Try adjusting your search or filters</p>
        <a href="/listings" class="inline-block mt-4 px-4 py-2 bg-primary text-primary-foreground rounded-md">
          View all listings
        </a>
      </div>
    )}
  </div>
</Layout>
