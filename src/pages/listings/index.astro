---
import Layout from '../../layouts/Layout.astro';
import CarouselBanner from '../../components/ui/CarouselBanner.astro';
import ListingCard from '../../components/business/ListingCard.astro';
import Input from '../../components/ui/Input.astro';
import Select from '../../components/ui/Select.astro';
import { getRawDb } from '@/lib/db';

const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const type = searchParams.get('type') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

// Cache: Dynamic content with search/filter - short cache
const hasSearchParams = search || type;
Astro.response.headers.set('Cache-Control', hasSearchParams 
  ? 'public, max-age=30, s-maxage=60, stale-while-revalidate=120'
  : 'public, max-age=60, s-maxage=120, stale-while-revalidate=300');

interface ListingRecord {
  id: string;
  title: string;
  slug: string;
  description: string | null;
  price: string | null;
  categoryId: string | null;
  location: string | null;
  imageIds: string | null;
  likes: number | null;
  views: number | null;
  status: string | null;
  createdAt: number | null;
}

// Map UI type filter values → listing category slugs
// (listings table has no `listing_type` column; type is derived from category)
const TYPE_TO_CATEGORY_SLUGS: Record<string, string[]> = {
  product: ['for-sale', 'product'],
  vehicle: ['vehicles'],
  property: ['property-sale'],
  job: ['jobs'],
  service: ['services'],
  wanted: ['wanted'],
};

// Build WHERE clause dynamically
const conditions: string[] = ["status IN ('active', 'published', 'live')"];
const params: (string | number)[] = [];

// Search filter
if (search) {
  conditions.push("(LOWER(title) LIKE ? OR LOWER(description) LIKE ?)");
  const searchPattern = `%${search.toLowerCase()}%`;
  params.push(searchPattern, searchPattern);
}

// Type filter - resolves to category slug match via subquery
if (type) {
  const categorySlugs = TYPE_TO_CATEGORY_SLUGS[type] || [];
  if (categorySlugs.length > 0) {
    const placeholders = categorySlugs.map(() => '?').join(',');
    conditions.push(`category_id IN (SELECT id FROM listing_categories WHERE slug IN (${placeholders}) OR parent_id IN (SELECT id FROM listing_categories WHERE slug IN (${placeholders})))`);
    params.push(...categorySlugs, ...categorySlugs);
  }
}

const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(' AND ')}` : '';

// Count total (without LIMIT/OFFSET)
let total = 0;
try {
  const db = await getRawDb();
  if (db) {
    const countResult = await db.prepare(`SELECT COUNT(*) as count FROM listings ${whereClause}`).bind(...params).first() as { count: number } | undefined;
    total = countResult?.count || 0;
  }
} catch (e) {
  console.error('Listings count error:', e);
}

// Fetch paginated results (with OFFSET/LIMIT)
const entities: ListingRecord[] = [];
try {
  const db = await getRawDb();
  if (db) {
    const result = await db.prepare(`
      SELECT id, title, slug, description, price, category_id as categoryId, location, image_ids as imageIds, likes, views, status, created_at as createdAt
      FROM listings
      ${whereClause}
      ORDER BY created_at DESC
      LIMIT ? OFFSET ?
    `).bind(...params, LIMIT, offset).all();
    entities.push(...(result.results as ListingRecord[]));
  }
} catch (e) {
  console.error('Listings query failed:', e);
}

const totalPages = Math.ceil(total / LIMIT);

// Build pagination URL helper
const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (search) p.set('q', search);
  if (type) p.set('type', type);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/listings?${p.toString()}`;
};
---

<Layout title="Classified Ads - TimorUp">
  <div class="max-w-7xl mx-auto px-4" data-page-content>
    <CarouselBanner position="listings" class="mb-6" />

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold leading-tight">Classified Ads</h1>
      <span class="text-sm text-muted-foreground">{total} total</span>
    </div>

    <form method="GET" action="/listings" class="bg-card rounded-2xl border border-border/50 p-4 mb-6 shadow-sm">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <Input name="q" type="search" placeholder="Search listings..." value={search}
            class="pl-10 pr-4 border-border focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-200" />
        </div>
        <div class="flex gap-2">
          <Select
            name="type"
            class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors"
            options={[
              { value: '', label: 'All Types' },
              { value: 'product', label: 'Product' },
              { value: 'vehicle', label: 'Vehicle' },
              { value: 'property', label: 'Property' },
              { value: 'job', label: 'Job' },
              { value: 'service', label: 'Service' },
              { value: 'wanted', label: 'Wanted' },
            ]}
            value={type}
            onchange="this.form.submit()"
          />
    </form>

    {entities.length > 0 ? (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {entities.map(l => (
            <ListingCard
              title={l.title}
              slug={l.slug}
              price={l.price || ''}
              listingType={type || 'product'}
              location={l.location?.split(',')[0] || ''}
              imageIds={l.imageIds ? (typeof l.imageIds === 'string' ? JSON.parse(l.imageIds) : l.imageIds) : []}
              likes={l.likes || 0}
              views={l.views || 0}
            />
          ))}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-2 mt-8" aria-label="Pagination">
            {page > 1 && (
              <a href={buildUrl(page - 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
                ← Previous
              </a>
            )}
            
            {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
              const pageNum = i + 1;
              const isActive = pageNum === page;
              return (
                <a 
                  href={buildUrl(pageNum)} 
                  class={`px-3 py-2 rounded-md text-sm ${isActive ? 'bg-primary text-primary-foreground' : 'bg-muted hover:bg-muted/80'}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {pageNum}
                </a>
              );
            })}
            
            {page < totalPages && (
              <a href={buildUrl(page + 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
                Next →
              </a>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <h3 class="text-lg font-medium mb-2">No listings found</h3>
        <p class="text-muted-foreground">Try adjusting your search or filters</p>
        <a href="/listings" class="inline-block mt-4 px-4 py-2 bg-primary text-primary-foreground rounded-md">
          View all listings
        </a>
      </div>
    )}
  </div>
</Layout>
