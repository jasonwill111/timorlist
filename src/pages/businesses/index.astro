---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { Button } from '@/components/fulldev/button';
import CarouselBanner from '../../components/fulldev/CarouselBanner.astro';
import BusinessCard from '../../components/business/BusinessCard.astro';
import { getBusinessCategories, getBusinessListing } from '@/lib/db/queries/businesses-listing';

const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const parentCat = searchParams.get('parent') || '';
const childCat = searchParams.get('child') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;

const hasSearchParams = search || parentCat || childCat;
Astro.response.headers.set('Cache-Control', hasSearchParams
  ? 'public, max-age=30, s-maxage=60, stale-while-revalidate=120'
  : 'public, max-age=60, s-maxage=120, stale-while-revalidate=300');

const { parentCats, categoryMap, childMap } = await getBusinessCategories();
const { results, total, totalPages } = await getBusinessListing(search, parentCat, childCat, page, LIMIT);

// Enrich results with category names
for (const b of results) {
  b.categoryName = b.category_id ? categoryMap[b.category_id] || '' : '';
}

const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (search) p.set('q', search);
  if (parentCat) p.set('parent', parentCat);
  if (childCat) p.set('child', childCat);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/businesses?${p.toString()}`;
};
---

<Layout title="Businesses - TimorUp">
  <div class="max-w-7xl mx-auto px-4" data-page-content>
    <CarouselBanner position="businesses" class="mb-6" />

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold leading-tight">Businesses</h1>
      <span class="text-sm text-muted-foreground">{total} total</span>
    </div>

    {parentCats.length > 0 && (
      <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
        <Button as="a" href="/businesses" variant={!parentCat ? 'default' : 'secondary'} size="sm">
          All
        </Button>
        {parentCats.map(c => (
          <Button
            as="a"
            href={`/businesses?parent=${c.id}`}
            variant={parentCat === c.id ? 'default' : 'secondary'}
            size="sm"
          >
            {c.name}
          </Button>
        ))}
      </div>
    )}

    {results.length > 0 ? (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {results.map(b => (
            <BusinessCard
              title={b.title}
              slug={b.slug}
              category={b.category_id ? categoryMap[b.category_id] || '' : ''}
              address={b.address || ''}
              tags={b.tags ? (b.tags.startsWith('[') ? JSON.parse(b.tags) : b.tags.split(',').map(t => t.trim())) : []}
              likes={b.likes || 0}
              saves={b.saves || 0}
              views={b.views || 0}
              ratingAverage={b.rating_average || 0}
              ratingCount={b.rating_count || 0}
              imageId={b.profile_image_id}
              entityType="business"
              aboutUs={b.about_us}
            />
          ))}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-2 mt-8" aria-label="Pagination">
            {page > 1 && (
              <Button as="a" href={buildUrl(page - 1)} variant="secondary" size="sm">
                ← Previous
              </Button>
            )}
            {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
              const pageNum = i + 1;
              const isActive = pageNum === page;
              return (
                <Button
                  as="a"
                  href={buildUrl(pageNum)}
                  variant={isActive ? 'default' : 'secondary'}
                  size="sm"
                >
                  {pageNum}
                </Button>
              );
            })}
            {page < totalPages && (
              <Button as="a" href={buildUrl(page + 1)} variant="secondary" size="sm">
                Next →
              </Button>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <h3 class="text-lg font-medium mb-2">No businesses found</h3>
        <p class="text-muted-foreground">Try a different category or search term</p>
        <Button as="a" href="/businesses" class="mt-4">
          View all businesses
        </Button>
      </div>
    )}
  </div>
</Layout>
