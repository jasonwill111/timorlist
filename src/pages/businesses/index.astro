---
// Businesses page - Direct SSR with BusinessCard component
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import CarouselBanner from '../../components/ui/CarouselBanner.astro';
import BusinessCard from '../../components/business/BusinessCard.astro';
import { getDb } from '@/lib/db';
import { businesses, businessCategories } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

// Get URL params
const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const parentCat = searchParams.get('parent') || '';
const childCat = searchParams.get('child') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

// Initialize DB
const db = await getDb();

// Fetch categories
let categoryMap: Record<string, string> = {};
let parentCats: { id: string; name: string }[] = [];
let getChildren = (_pid: string) => [];

if (db) {
  try {
    const allCats = await db.select({
      id: businessCategories.id,
      name: businessCategories.name,
      parentId: businessCategories.parentId,
    }).from(businessCategories).all();

    categoryMap = Object.fromEntries(allCats.map(c => [c.id, c.name]));
    parentCats = allCats.filter(c => !c.parentId);
    getChildren = (pid: string) => allCats.filter(c => c.parentId === pid);
  } catch (e) {
    console.error('Categories query failed:', e);
  }
}

// Fetch businesses with SSR
let allEntities: Array<{
  id: string;
  title: string;
  slug: string;
  categoryId: string | null;
  address: string | null;
  profileImageId: string | null;
  likes: number | null;
  views: number | null;
  ratingAverage: number | null;
  ratingCount: number | null;
  status: string | null;
}> = [];

if (db) {
  try {
    const raw = await db.select({
      id: businesses.id,
      title: businesses.title,
      slug: businesses.slug,
      categoryId: businesses.categoryId,
      address: businesses.address,
      profileImageId: businesses.profileImageId,
      likes: businesses.likes,
      views: businesses.views,
      ratingAverage: businesses.ratingAverage,
      ratingCount: businesses.ratingCount,
      status: businesses.status,
    })
    .from(businesses)
    .orderBy(desc(businesses.createdAt))
    .all();

    // Filter for visible statuses
    allEntities = raw.filter(e =>
      e.status === 'active' || e.status === 'live' || e.status === 'published'
    );
  } catch (e) {
    console.error('Businesses query failed:', e);
  }
}

// Apply search filter
if (search) {
  allEntities = allEntities.filter(e =>
    e.title?.toLowerCase().includes(search.toLowerCase())
  );
}

const total = allEntities.length;
const totalPages = Math.ceil(total / LIMIT);
const entities = allEntities.slice(offset, offset + LIMIT);
---

<Layout title="Businesses - TimorUp">
  <div class="max-w-7xl mx-auto px-4">
    <CarouselBanner position="businesses" class="mb-6" />

    <!-- Header with count -->
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Businesses</h1>
      <span class="text-sm text-muted-foreground">{total} total</span>
    </div>

    <!-- Search & Filter -->
    <form method="GET" action="/businesses" class="bg-card rounded-2xl border border-border/50 p-4 mb-6 shadow-sm">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input name="q" type="search" placeholder="Search businesses..." value={search}
            class="w-full h-11 pl-10 pr-4 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all duration-200" />
        </div>
        <div class="flex gap-2">
          <select name="parent" onchange="this.form.submit()"
            class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors">
            <option value="">All Categories</option>
            {parentCats.map(p => <option value={p.id} selected={parentCat === p.id}>{p.name}</option>)}
          </select>
          <select name="child" onchange="this.form.submit()"
            class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors">
            <option value="">Subcategory</option>
            {getChildren(parentCat).map(c => <option value={c.id} selected={childCat === c.id}>{c.name}</option>)}
          </select>
        </div>
      </div>
    </form>

    <!-- Business Grid using BusinessCard component -->
    {entities.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {entities.map(e => (
          <BusinessCard
            title={e.title}
            slug={e.slug}
            category={categoryMap[e.categoryId || ''] || ''}
            profileImageId={e.profileImageId}
            rating={e.ratingAverage || 0}
            likes={e.likes || 0}
            reviews={e.ratingCount || 0}
            views={e.views || 0}
            location={e.address?.split(',')[0] || ''}
            entityType="business"
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <svg class="w-16 h-16 mx-auto text-muted-foreground/50 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/>
        </svg>
        <h3 class="text-lg font-medium mb-2">No businesses found</h3>
        <p class="text-muted-foreground">Try adjusting your search or filters</p>
      </div>
    )}

    <!-- Pagination -->
    {totalPages > 1 && (
      <nav class="flex justify-center gap-2 mt-8" aria-label="Pagination">
        {page > 1 && (
          <a href={`/businesses?page=${page - 1}${search ? `&q=${search}` : ''}`} class="px-4 py-2 rounded-lg border hover:bg-muted transition-colors">
            Previous
          </a>
        )}
        {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
          const p = i + 1;
          return (
            <a href={`/businesses?page=${p}${search ? `&q=${search}` : ''}`} class={`px-4 py-2 rounded-lg border ${p === page ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'}`}>
              {p}
            </a>
          );
        })}
        {page < totalPages && (
          <a href={`/businesses?page=${page + 1}${search ? `&q=${search}` : ''}`} class="px-4 py-2 rounded-lg border hover:bg-muted transition-colors">
            Next
          </a>
        )}
      </nav>
    )}
  </div>
</Layout>
