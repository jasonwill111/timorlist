---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import CarouselBanner from '../../components/ui/CarouselBanner.astro';
import BusinessCard from '../../components/business/BusinessCard.astro';
import { getRawDb } from '@/lib/db';

const db = await getRawDb();
const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const parentCat = searchParams.get('parent') || '';
const childCat = searchParams.get('child') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

// Cache: Dynamic content with search/filter - short cache
const hasSearchParams = search || parentCat || childCat;
Astro.response.headers.set('Cache-Control', hasSearchParams 
  ? 'public, max-age=30, s-maxage=60, stale-while-revalidate=120'
  : 'public, max-age=60, s-maxage=120, stale-while-revalidate=300');

interface CategoryRecord {
  id: string;
  name: string;
  parentId: string | null;
}
let parentCats: CategoryRecord[] = [];
const categoryMap: Record<string, string> = {};
let childMap: Record<string, string[]> = {};

try {
  if (db) {
    const allCats = (await db.prepare('SELECT id, name, parent_id as parentId FROM public_sector_categories').all()).results as CategoryRecord[];
    parentCats = allCats.filter(c => !c.parentId);
    allCats.forEach(c => {
      categoryMap[c.id] = c.name;
      if (c.parentId) {
        if (!childMap[c.parentId]) childMap[c.parentId] = [];
        childMap[c.parentId].push(c.id);
      }
    });
  }
} catch (e) { console.log('Categories error:', e); }

interface PublicSectorRecord {
  id: string;
  title: string;
  slug: string;
  categoryId: string | null;
  address: string | null;
  profile_image_id: string | null;
  tags: string | null;
  likes: number | null;
  saves: number | null;
  views: number | null;
  status: string | null;
  about_us: string | null;
  createdAt: number | null;
}

// Build WHERE clause dynamically
const conditions: string[] = ["status IN ('live', 'published', 'active')"];
const params: (string | number)[] = [];

// Search filter
if (search) {
  conditions.push("(LOWER(title) LIKE ? OR LOWER(about_us) LIKE ?)");
  const searchPattern = `%${search.toLowerCase()}%`;
  params.push(searchPattern, searchPattern);
}

// Category filter - handle both parent and child
if (childCat) {
  conditions.push("category_id = ?");
  params.push(childCat);
} else if (parentCat) {
  const childIds = childMap[parentCat] || [];
  if (childIds.length > 0) {
    const placeholders = childIds.map(() => '?').join(', ');
    conditions.push(`category_id IN (${placeholders})`);
    params.push(...childIds);
  }
}

const whereClause = conditions.length > 0 ? `WHERE ${conditions.join(' AND ')}` : '';

// Count total (without LIMIT/OFFSET)
let total = 0;
try {
  if (db) {
    const countResult = await db.prepare(`SELECT COUNT(*) as count FROM public_sectors ${whereClause}`).bind(...params).first() as { count: number } | undefined;
    total = countResult?.count || 0;
  }
} catch (e) { console.log('Count error:', e); }

// Fetch paginated results (with OFFSET/LIMIT)
const entities: PublicSectorRecord[] = [];
try {
  if (db) {
    const dataResult = await db.prepare(`
      SELECT id, title, slug, category_id as categoryId, address, profile_image_id,
             tags, likes, saves, views, status, aboutUs, created_at as createdAt
      FROM public_sectors
      ${whereClause}
      ORDER BY created_at DESC
      LIMIT ? OFFSET ?
    `).bind(...params, LIMIT, offset).all();
    entities.push(...(dataResult.results as PublicSectorRecord[]));
  }
} catch (e) { console.log('Public sectors query error:', e); }

const totalPages = Math.ceil(total / LIMIT);

// Build pagination URL helper
const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (search) p.set('q', search);
  if (parentCat) p.set('parent', parentCat);
  if (childCat) p.set('child', childCat);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/public-sectors?${p.toString()}`;
};
---

<Layout title="Public Sectors - TimorUp">
  <div class="max-w-7xl mx-auto px-4" data-page-content>
    <CarouselBanner position="publicsectors" class="mb-6" />

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Public Sectors</h1>
      <span class="text-sm text-muted-foreground">{total} organizations</span>
    </div>

    {parentCats.length > 0 && (
      <div class="flex gap-2 mb-6 overflow-x-auto pb-2">
        <a href="/public-sectors" class={`px-4 py-2 rounded-full text-sm whitespace-nowrap ${!parentCat ? 'bg-primary text-primary-foreground' : 'bg-muted hover:bg-muted/80'}`}>All</a>
        {parentCats.map(c => (
          <a href={`/public-sectors?parent=${c.id}`} class={`px-4 py-2 rounded-full text-sm whitespace-nowrap ${parentCat === c.id ? 'bg-primary text-primary-foreground' : 'bg-muted hover:bg-muted/80'}`}>{c.name}</a>
        ))}
      </div>
    )}

    {entities.length > 0 ? (
      <>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {entities.map(p => (
            <BusinessCard
              title={p.title}
              slug={p.slug}
              category={p.categoryId ? categoryMap[p.categoryId] || '' : ''}
              address={p.address || ''}
              tags={p.tags ? (p.tags.startsWith('[') ? JSON.parse(p.tags) : p.tags.split(',').map(t => t.trim())) : []}
              likes={p.likes || 0}
              saves={p.saves || 0}
              views={p.views || 0}
              ratingAverage={0}
              ratingCount={0}
              imageId={p.profile_image_id}
              entityType="publicsector"
              aboutUs={p.aboutUs}
            />
          ))}
        </div>

        {/* Pagination */}
        {totalPages > 1 && (
          <nav class="flex justify-center items-center gap-2 mt-8" aria-label="Pagination">
            {page > 1 && (
              <a href={buildUrl(page - 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
                ← Previous
              </a>
            )}
            
            {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
              const pageNum = i + 1;
              const isActive = pageNum === page;
              return (
                <a 
                  href={buildUrl(pageNum)} 
                  class={`px-3 py-2 rounded-md text-sm ${isActive ? 'bg-primary text-primary-foreground' : 'bg-muted hover:bg-muted/80'}`}
                  aria-current={isActive ? 'page' : undefined}
                >
                  {pageNum}
                </a>
              );
            })}
            
            {page < totalPages && (
              <a href={buildUrl(page + 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
                Next →
              </a>
            )}
          </nav>
        )}
      </>
    ) : (
      <div class="text-center py-16">
        <h3 class="text-lg font-medium mb-2">No public sectors found</h3>
        <p class="text-muted-foreground">Try a different category or search term</p>
        <a href="/public-sectors" class="inline-block mt-4 px-4 py-2 bg-primary text-primary-foreground rounded-md">
          View all public sectors
        </a>
      </div>
    )}
  </div>
</Layout>
