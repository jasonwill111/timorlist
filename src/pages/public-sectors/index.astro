---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import CarouselBanner from '../../components/ui/CarouselBanner.astro';
import BusinessCard from '../../components/business/BusinessCard.astro';
import { getDb } from '@/lib/db';
import { publicSectors, publicSectorCategories } from '@/db/schema';
import { desc } from 'drizzle-orm';

const db = await getDb();
const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const parentCat = searchParams.get('parent') || '';
const childCat = searchParams.get('child') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

const hasSearchParams = search || parentCat || childCat;
Astro.response.headers.set('Cache-Control', hasSearchParams ? 'public, max-age=30, s-maxage=60, stale-while-revalidate=120' : 'public, max-age=60, s-maxage=120, stale-while-revalidate=300');

interface CategoryRecord {
  id: string;
  name: string;
  parentId: string | null;
}
let parentCats: CategoryRecord[] = [];
let getChildCategories = (_pid: string): CategoryRecord[] => [];
const categoryMap: Record<string, string> = {};
try {
  const allCats = await db.select().from(publicSectorCategories).all();
  parentCats = allCats.filter((c: CategoryRecord) => !c.parentId);
  getChildCategories = (pid: string) => allCats.filter((c: CategoryRecord) => c.parentId === pid);
  allCats.forEach((c: CategoryRecord) => { categoryMap[c.id] = c.name; });
} catch (e) { console.log('Categories error:', e); }

interface PublicSectorRecord {
  id: string;
  title: string;
  slug: string;
  categoryId: string | null;
  address: string | null;
  profileImageId: string | null;
  tags: string[];
  likes: number;
  saves: number;
  views: number;
  ratingAverage: number;
  ratingCount: number;
  status: string;
  aboutUs: string | null;
  createdAt: number;
}
let allEntities: PublicSectorRecord[] = [];
try {
  const searchLower = search.toLowerCase();
  allEntities = await db.select()
    .from(publicSectors)
    .orderBy(desc(publicSectors.createdAt))
    .all();

  allEntities = allEntities.filter((e: PublicSectorRecord) => {
    const statusOk = e.status === 'live' || e.status === 'published';
    const searchMatch = !search ||
      e.title.toLowerCase().includes(searchLower) ||
      e.aboutUs.toLowerCase().includes(searchLower);
    const catMatch = !childCat || e.categoryId === childCat;
    if (parentCat && !childCat) {
      const childIds = getChildCategories(parentCat).map((c: CategoryRecord) => c.id);
      if (childIds.length > 0 && !childIds.includes(e.categoryId)) return false;
    }
    return statusOk && searchMatch && catMatch;
  });
} catch (e) { console.log('Query error:', e); allEntities = []; }

const total = allEntities.length;
const totalPages = Math.ceil(total / LIMIT);
const entities = allEntities.slice(offset, offset + LIMIT);

const buildUrl = (params: Record<string, string>) => {
  const p = new URLSearchParams();
  if (search) p.set('q', search);
  if (parentCat) p.set('parent', parentCat);
  if (childCat) p.set('child', childCat);
  Object.entries(params).forEach(([k, v]) => {
    if (v) p.set(k, v);
  });
  return `/public-sectors?${p.toString()}`;
};
---

<Layout title="Public Sectors - TimorUp">
  <div class="max-w-7xl mx-auto px-4" data-page-content>
    <CarouselBanner position="businesses" class="mb-6" />

    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl sm:text-3xl font-bold">Public Sectors</h1>
      <span class="text-sm text-muted-foreground">{total} total</span>
    </div>

    <form method="GET" action="/public-sectors" class="bg-card rounded-2xl border border-border/50 p-4 mb-6 shadow-sm">
      <div class="flex flex-col sm:flex-row gap-3">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input name="q" type="search" placeholder="Search public sectors..." value={search}
            class="w-full h-11 pl-10 pr-4 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" />
        </div>
        <div class="flex gap-2">
          <select name="parent" onchange="this.form.submit()"
            class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors">
            <option value="">All Categories</option>
            {parentCats.map(p => <option value={p.id} selected={parentCat===p.id}>{p.name}</option>)}
          </select>
          <select name="child" onchange="this.form.submit()"
            class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors">
            <option value="">Subcategory</option>
            {getChildCategories(parentCat).map(c => <option value={c.id} selected={childCat===c.id}>{c.name}</option>)}
          </select>
        </div>
      </div>
    </form>

    {entities.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {entities.map(e => (
          <BusinessCard
            title={e.title}
            slug={e.slug}
            category={categoryMap[e.categoryId || ''] || ''}
            profileImageId={e.profileImageId}
            likes={e.likes}
            reviews={e.ratingCount}
            views={e.views}
            location={e.address?.split(',')[0] || ''}
            entityType="publicsector"
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-16">
        <svg class="w-16 h-16 mx-auto text-muted-foreground/50 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3"/>
        </svg>
        <h3 class="text-lg font-medium mb-2">No public sectors found</h3>
        <p class="text-muted-foreground">Try adjusting your search or filters</p>
      </div>
    )}

    {totalPages > 1 ? (
      <nav class="flex items-center justify-center gap-2 mt-8" aria-label="Pagination">
        <a href={buildUrl({ page: String(page - 1) })}
           class={`px-4 py-2 rounded-lg border text-sm font-medium transition-colors ${page > 1 ? 'hover:border-primary hover:text-primary cursor-pointer' : 'opacity-50 pointer-events-none text-muted-foreground'}`}>
          &larr; Prev
        </a>
        {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
          const p = i + 1;
          return (
            <a href={buildUrl({ page: String(p) })}
               class={`px-4 py-2 rounded-lg border text-sm font-medium transition-colors ${p === page ? 'bg-primary text-primary-foreground border-primary' : 'hover:border-primary hover:text-primary cursor-pointer'}`}>
              {p}
            </a>
          );
        })}
        <a href={buildUrl({ page: String(page + 1) })}
           class={`px-4 py-2 rounded-lg border text-sm font-medium transition-colors ${page < totalPages ? 'hover:border-primary hover:text-primary cursor-pointer' : 'opacity-50 pointer-events-none text-muted-foreground'}`}>
          Next &rarr;
        </a>
      </nav>
    ) : null}
  </div>
</Layout>
