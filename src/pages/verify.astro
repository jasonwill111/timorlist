---
// This page needs SSR for email verification
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Button } from '../components/fulldev/button';
import { Card } from '../components/fulldev/card';
import { CardHeader } from '../components/fulldev/card';
import { CardTitle } from '../components/fulldev/card';
import { CardDescription } from '../components/fulldev/card';
import { CardContent } from '../components/fulldev/card';
import { CardFooter } from '../components/fulldev/card';
import ToastContainer from '../components/fulldev/toast/ToastContainer.astro';

---

<Layout title="Verify Email - TimorUp">
  <div class="container max-w-md py-16">
    <Card>
      <CardHeader>
        <CardTitle>Email Verification</CardTitle>
        <CardDescription>Verify your email address to activate your account</CardDescription>
      </CardHeader>
      <CardContent>
        <div id="verification-status" class="text-center py-4">
          <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-primary mx-auto mb-4" id="verify-spinner"></div>
          <!-- Static success state -->
          <div id="verify-success" class="hidden">
            <svg class="w-16 h-16 text-green-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p id="verify-success-msg" class="text-lg font-medium text-green-600"></p>
          </div>
          <!-- Static error state -->
          <div id="verify-error" class="hidden">
            <svg class="w-16 h-16 text-red-500 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <p id="verify-error-msg" class="text-lg font-medium text-red-600"></p>
            <a href="/login" class="inline-flex items-center justify-center gap-2 px-4 py-2.5 h-11 rounded-md text-sm font-medium bg-primary text-primary-foreground shadow-sm hover:bg-primary/90 hover:shadow-lg hover:shadow-primary/20 transition-all duration-200 mt-4">
              Go to Login
            </a>
          </div>
        </div>
      </CardContent>
      <CardFooter class="justify-center">
        <a href="/login" class="text-sm text-muted-foreground hover:text-primary">
          Back to Login
        </a>
      </CardFooter>
    </Card>
  </div>
</Layout>

<ToastContainer />
<script>
  import { toast } from '@/lib/toast';
  import { actions } from 'astro:actions';

  const statusContainer = document.getElementById('verification-status');

  async function verifyEmail() {
    const urlParams = new URLSearchParams(window.location.search);
    const token = urlParams.get('token');

    if (!token) {
      showError('Invalid verification link. Please request a new verification email.');
      return;
    }

    try {
      const result = await actions.auth.verifyEmail({ token });

      if (result.success) {
        showSuccess('Email verified successfully! Redirecting to login...');
        setTimeout(() => {
          window.location.href = '/login?verified=true';
        }, 2000);
      } else {
        showError(result.error?.message || 'Verification failed. Please try again.');
      }
    } catch (error) {
      console.error('Verification error:', error);
      showError('An error occurred during verification. Please try again.');
    }
  }

  function showSuccess(message: string) {
    const spinner = document.getElementById('verify-spinner');
    const successEl = document.getElementById('verify-success');
    const msgEl = document.getElementById('verify-success-msg');
    if (!successEl || !msgEl) return;
    spinner?.classList.add('hidden');
    successEl.classList.remove('hidden');
    msgEl.textContent = message;
    toast.success(message);
  }

  function showError(message: string) {
    const spinner = document.getElementById('verify-spinner');
    const errorEl = document.getElementById('verify-error');
    const msgEl = document.getElementById('verify-error-msg');
    if (!errorEl || !msgEl) return;
    spinner?.classList.add('hidden');
    errorEl.classList.remove('hidden');
    msgEl.textContent = message;
    toast.error(message);
  }

  // Run verification on page load
  verifyEmail();
</script>

