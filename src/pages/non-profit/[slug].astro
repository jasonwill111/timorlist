---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
import { getRawDb } from '@/lib/db';
import { Eye, Heart, Bookmark, Globe, MapPin, Tag, Clock } from '@lucide/astro';
import ShareDialog from '@/components/ui/ShareDialog.astro';
import TipTapRenderer from '../../components/ui/TipTapRenderer.astro';
import { createBreadcrumbSchema } from '@/lib/seo';

const { slug } = Astro.params;
const siteUrl = import.meta.env.SITE || 'https://timorup.com';
const canonicalUrl = `${siteUrl}/non-profit/${slug}`;

interface NonProfitRecord {
  id: string;
  title: string;
  slug: string;
  aboutUs: string | null;
  contact_name: string | null;
  contact_number: string | null;
  country_code: string | null;
  email: string | null;
  address: string | null;
  year_of_establishment: number | null;
  opening_hours: string | null;
  tags: string | null;
  social_links: string | null;
  likes: number | null;
  saves: number | null;
  views: number | null;
  category_id: string | null;
  status: string | null;
  profile_image_id: string | null;
  photo_gallery: string | null;
}

let entity: NonProfitRecord | null = null;
let category: { name: string } | null = null;
let socialLinks: Record<string, string> = {};
let tags: string[] = [];
let galleryImages: { id: string; r2_key: string; alt: string | null }[] = [];
let profileImage: { r2_key: string; alt: string | null } | null = null;

try {
  const db = await getRawDb();
  if (db) {
    entity = await db.prepare(`
      SELECT id, title, slug, aboutUs, contact_name, contact_number, country_code, email,
             address, year_of_establishment, opening_hours, tags, social_links,
             likes, saves, views, category_id, status, profile_image_id, photo_gallery
      FROM non_profits WHERE slug = ? LIMIT 1
    `).bind(slug).first() as NonProfitRecord | null;

    if (entity) {
      if (entity.category_id) {
        category = await db.prepare('SELECT name FROM non_profit_categories WHERE id = ? LIMIT 1')
          .bind(entity.category_id).first() as { name: string } | null;
      }
      if (entity.social_links) {
        try { socialLinks = JSON.parse(entity.social_links); } catch {}
      }
      if (entity.tags) {
        try { tags = JSON.parse(entity.tags); } catch {}
      }
      if (entity.profile_image_id) {
        profileImage = await db.prepare('SELECT r2_key, alt FROM media WHERE id = ? LIMIT 1')
          .bind(entity.profile_image_id).first() as any;
      }
      if (entity.photo_gallery) {
        try {
          const ids = JSON.parse(entity.photo_gallery);
          if (Array.isArray(ids) && ids.length > 0) {
            const placeholders = ids.map(() => '?').join(',');
            galleryImages = ((await db.prepare(`SELECT id, r2_key, alt FROM media WHERE id IN (${placeholders})`).bind(...ids).all()).results as any) || [];
          }
        } catch {}
      }
    }
  }
} catch (e) {
  console.error('Nonprofit query failed:', e);
}

if (!entity) return Astro.redirect('/non-profits');

Astro.response.headers.set('Cache-Control', 'public, max-age=120, s-maxage=600, stale-while-revalidate=1200');

const waNumber = (entity.contact_number || '').replace(/\D/g, '');
const waLink = entity.contact_number
  ? `https://wa.me/${(entity.country_code || '+670').replace('+', '')}${waNumber}?text=${encodeURIComponent('Hi, I am interested in: ' + entity.title)}`
  : '';

const breadcrumbSchema = createBreadcrumbSchema([
  { name: 'Home', url: siteUrl },
  { name: 'Non-Profits', url: `${siteUrl}/non-profits` },
  { name: entity.title, url: canonicalUrl }
]);
---

<Layout title={`${entity.title} - TimorUp`} description={entity.aboutUs?.substring(0, 160) || entity.title} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="max-w-7xl mx-auto px-4 py-6">
    <nav class="mb-4 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-muted-foreground">
        <li><a href="/" class="hover:text-primary">Home</a></li>
        <li class="text-muted-foreground/50">/</li>
        <li><a href="/non-profits" class="hover:text-primary">Non-Profits</a></li>
        <li class="text-muted-foreground/50">/</li>
        <li class="text-foreground font-medium truncate">{entity.title}</li>
      </ol>
    </nav>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="lg:col-span-2 space-y-6">
        <div class="rounded-2xl overflow-hidden bg-card border">
          {profileImage ? (
            <img src={`${siteUrl}/api/media/${entity.profile_image_id}`} alt={profileImage.alt || entity.title} class="w-full h-[400px] object-cover" />
          ) : (
            <div class="w-full h-[400px] bg-muted flex items-center justify-center">
              <span class="text-muted-foreground text-lg">No image available</span>
            </div>
          )}
        </div>

        <div class="bg-card rounded-2xl border p-6 space-y-6">
          <div>
            <h1 class="text-2xl sm:text-3xl font-bold mb-2">{entity.title}</h1>
            {category && (
              <span class="inline-block px-3 py-1 bg-primary/10 text-primary rounded-full text-sm">{category.name}</span>
            )}
          </div>

          {entity.aboutUs && (
            <div>
              <h2 class="text-lg font-semibold mb-2">About Us</h2>
              <TipTapRenderer content={entity.aboutUs} class="text-sm" />
            </div>
          )}

          {(entity.address || entity.opening_hours || entity.year_of_establishment) && (
            <div>
              <h2 class="text-lg font-semibold mb-3">Details</h2>
              <dl class="grid grid-cols-2 gap-4">
                {entity.address && (
                  <>
                    <dt class="text-muted-foreground flex items-center gap-1"><MapPin class="w-4 h-4" /> Address</dt>
                    <dd class="text-foreground">{entity.address}</dd>
                  </>
                )}
                {entity.opening_hours && (
                  <>
                    <dt class="text-muted-foreground flex items-center gap-1"><Clock class="w-4 h-4" /> Hours</dt>
                    <dd class="text-foreground">{entity.opening_hours}</dd>
                  </>
                )}
                {entity.year_of_establishment && (
                  <>
                    <dt class="text-muted-foreground">Established</dt>
                    <dd class="text-foreground">{entity.year_of_establishment}</dd>
                  </>
                )}
              </dl>
            </div>
          )}

          {tags.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold mb-2 flex items-center gap-1"><Tag class="w-4 h-4" /> Tags</h2>
              <div class="flex flex-wrap gap-2">
                {tags.map((tag: string) => (
                  <span class="px-2 py-1 bg-muted text-sm rounded-md">{tag}</span>
                ))}
              </div>
            </div>
          )}

          {Object.keys(socialLinks).length > 0 && (
            <div>
              <h2 class="text-lg font-semibold mb-2 flex items-center gap-1"><Globe class="w-4 h-4" /> Social Links</h2>
              <div class="flex flex-wrap gap-2">
                {Object.entries(socialLinks).map(([k, v]) => (
                  <a href={v} target="_blank" rel="noopener noreferrer" class="px-3 py-1 bg-primary/10 text-primary rounded-md text-sm hover:bg-primary/20">{k}</a>
                ))}
              </div>
            </div>
          )}

          {galleryImages.length > 0 && (
            <div>
              <h2 class="text-lg font-semibold mb-3">Photo Gallery</h2>
              <div class="grid grid-cols-3 gap-2">
                {galleryImages.map(img => (
                  <img src={`${siteUrl}/api/media/${img.id}`} alt={img.alt || ''} class="w-full h-24 object-cover rounded-lg" />
                ))}
              </div>
            </div>
          )}
        </div>
      </div>

      <div class="space-y-6">
        <div class="bg-card rounded-2xl border p-6 sticky top-24">
          <h3 class="text-lg font-semibold mb-4">Contact</h3>
          {entity.contact_name && (
            <div class="mb-4 pb-4 border-b">
              <p class="text-sm text-muted-foreground mb-1">Contact Person</p>
              <p class="font-medium">{entity.contact_name}</p>
            </div>
          )}
          {waLink ? (
            <a href={waLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full bg-green-500 hover:bg-green-600 text-white font-medium py-3 px-4 rounded-xl transition-colors mb-4">
              Contact on WhatsApp
            </a>
          ) : null}
          {entity.contact_number && (
            <div class="flex items-center gap-2 text-sm mb-2">
              <span class="text-muted-foreground">Phone:</span>
              <span>{entity.country_code} {entity.contact_number}</span>
            </div>
          )}
          {entity.email && (
            <div class="flex items-center gap-2 text-sm">
              <span class="text-muted-foreground">Email:</span>
              <a href={`mailto:${entity.email}`} class="text-primary hover:underline">{entity.email}</a>
            </div>
          )}
          <div class="flex items-center gap-4 text-sm text-muted-foreground pt-4 mt-4 border-t">
            <span class="flex items-center gap-1"><Eye class="w-4 h-4" />{entity.views || 0}</span>
            <span class="flex items-center gap-1"><Heart class="w-4 h-4" />{entity.likes || 0}</span>
            <span class="flex items-center gap-1"><Bookmark class="w-4 h-4" />{entity.saves || 0}</span>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
