---
// Dashboard page - requires authentication
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { Button } from '../components/fulldev/button';
import { Card } from '../components/fulldev/card';
import { CardHeader } from '../components/fulldev/card';
import { CardTitle } from '../components/fulldev/card';
import { CardDescription } from '../components/fulldev/card';
import { CardContent } from '../components/fulldev/card';
import { resolveUserFromCookie } from '@/lib/db/queries/auth';

const cookieHeader = Astro.request.headers.get('cookie') || '';
const user = await resolveUserFromCookie(cookieHeader);

if (!user) {
  return Astro.redirect('/login?redirect=/dashboard');
}
---

<Layout title="Dashboard - TimorUp">
  <div class="container py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-bold">Dashboard</h1>
      <p class="text-muted-foreground">Welcome back, {user.name}</p>
    </div>

    <div class="grid grid-col-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
      <Card>
        <CardHeader class="pb-2">
          <CardTitle class="text-sm text-muted-foreground">Quick Actions</CardTitle>
        </CardHeader>
        <CardContent class="space-y-2">
          <a href="/account">
            <Button variant="outline" class="w-full justify-start">My Account</Button>
          </a>
          <a href="/business/create">
            <Button variant="outline" class="w-full justify-start">Add Business</Button>
          </a>
        </CardContent>
      </Card>
    </div>
  </div>
</Layout>
