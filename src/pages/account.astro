---
// User account page
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import Card from '@/components/ui/Card.astro';
import CardHeader from '@/components/ui/CardHeader.astro';
import CardTitle from '@/components/ui/CardTitle.astro';
import CardDescription from '@/components/ui/CardDescription.astro';
import CardContent from '@/components/ui/CardContent.astro';
import CardFooter from '@/components/ui/CardFooter.astro';
import Button from '@/components/ui/Button.astro';
import Badge from '@/components/ui/Badge.astro';
import { getDb, getRawDb } from '@/lib/db';
import { businesses, orders, reviews } from '@/db/schema';
import { eq, desc } from 'drizzle-orm';

const cookieHeader = Astro.request.headers.get('cookie') || '';
let user: { id: string; name: string; email: string } | null = null;
let userPages: Array<{ id: string; title: string; slug: string; entityType: string; status: string; createdAt: number | null }> = [];
let subscription: { planSlug: string; amount: number; status: string; planExpiresAt: number | null } | null = null;
let businessReviews: Array<{ id: string; rating: number; comment: string | null; reviewerName: string; createdAt: number | null; reply: string | null; repliedAt: number | null }> = [];

try {
  const tokenMatch = cookieHeader.match(/better-auth\.session_token=([^;]+)/);

  if (tokenMatch) {
    const db = await getRawDb();
    if (db) {
      const session = await db.prepare('SELECT userId, expiresAt FROM session WHERE token = ? LIMIT 1')
        .bind(tokenMatch[1])
        .first() as { userId: string; expiresAt: number | string } | null;
      if (session) {
        const expiresAtMs = typeof session.expiresAt === 'number'
          ? (session.expiresAt < 1e12 ? session.expiresAt * 1000 : session.expiresAt)
          : new Date(session.expiresAt).getTime();
        if (expiresAtMs > Date.now()) {
          const userRecord = await db.prepare('SELECT id, name, email FROM user WHERE id = ? LIMIT 1')
            .bind(session.userId)
            .first() as { id: string; name: string; email: string } | null;

          if (userRecord) {
            user = { id: userRecord.id, name: userRecord.name || '', email: userRecord.email };
          }
        }
      }
    }
  }
} catch (e) {
  console.error('Account auth check failed:', e);
}

if (!user) {
  return Astro.redirect('/login?redirect=/account');
}

// Load user pages (businesses)
try {
  const db = await getDb();
  if (db) {
    // Get businesses
    const businessList = await db.select({
      id: businesses.id,
      title: businesses.title,
      slug: businesses.slug,
      status: businesses.status,
      createdAt: businesses.createdAt,
    })
    .from(businesses)
    .where(eq(businesses.ownerId, user.id))
    .all();

    userPages = businessList.map(b => ({ ...b, entityType: 'business' }));

    // Get subscription if any business exists
    if (userPages.length > 0) {
      const subOrder = await db.select({
        planSlug: orders.servicePackageId,
        amount: orders.amount,
        status: orders.status,
        planExpiresAt: orders.planExpiresAt,
      })
      .from(orders)
      .where(eq(orders.typeId, userPages[0].id))
      .where(eq(orders.type, 'business'))
      .where(eq(orders.status, 'paid'))
      .orderBy(desc(orders.planExpiresAt))
      .limit(1)
      .get();

      if (subOrder) {
        subscription = {
          planSlug: subOrder.planSlug || 'basic-monthly',
          amount: subOrder.amount,
          status: subOrder.status,
          planExpiresAt: subOrder.planExpiresAt,
        };
      }
    }
  }
} catch (e) {
  console.error('Failed to load user data:', e);
}

const isSubscriptionActive = subscription?.status === 'paid' && subscription?.planExpiresAt && subscription.planExpiresAt > Date.now() / 1000;
const isSubscriptionExpired = subscription?.status === 'paid' && subscription?.planExpiresAt && subscription.planExpiresAt <= Date.now() / 1000;
---
<Layout title="My Account - TimorUp">
  <div class="container py-8">
    <div class="flex items-center justify-between mb-8">
      <h1 class="text-3xl font-bold">My Account</h1>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        {userPages.length > 0 && (
          <div>
            <h2 class="text-xl font-semibold mb-4">Your Pages</h2>
            <div class="space-y-4">
              {userPages.map(page => (
                <Card>
                  <CardHeader>
                    <div class="flex items-start justify-between">
                      <div>
                        <CardTitle>{page.title}</CardTitle>
                        <CardDescription>Created on {page.createdAt ? new Date(page.createdAt * 1000).toLocaleDateString() : ''}</CardDescription>
                      </div>
                      <Badge variant={page.status === 'active' ? 'success' : 'secondary'} size="sm">
                        {page.status}
                      </Badge>
                    </div>
                    <div class="flex gap-2 mt-4">
                      <a href={`/business/${page.slug}`}>
                        <Button variant="outline" size="sm">View</Button>
                      </a>
                      <a href={`/business/${page.slug}/edit`}>
                        <Button size="sm">Edit</Button>
                      </a>
                    </div>
                  </CardHeader>
                </Card>
              ))}
            </div>
          </div>
        )}

        {userPages.length === 0 && (
          <Card>
            <CardHeader>
              <CardTitle>Create Your Page</CardTitle>
              <CardDescription>You haven't created any pages yet</CardDescription>
            </CardHeader>
            <CardContent>
              <p class="text-muted-foreground mb-4">
                Create a Business, Government, or Non-Profit page to get started.
              </p>
              <div class="flex flex-wrap gap-2">
                <a href="/business/create">
                  <Button>Create Business</Button>
                </a>
              </div>
            </CardContent>
          </Card>
        )}
      </div>

      <!-- Sidebar -->
      <div>
        <!-- Subscription Card -->
        <Card class="mb-6">
          <CardHeader>
            <CardTitle>Subscription</CardTitle>
          </CardHeader>
          <CardContent>
            {subscription ? (
              <div class="text-center">
                <p class="text-2xl font-bold text-green-600">Active</p>
                <p class="text-sm text-muted-foreground mt-1">
                  {subscription.planSlug.replace('-', ' ').toUpperCase()} Plan
                </p>
                {subscription.planExpiresAt && (
                  <p class="text-xs text-muted-foreground mt-2">
                    Expires: {new Date(subscription.planExpiresAt * 1000).toLocaleDateString()}
                  </p>
                )}
              </div>
            ) : (
              <div class="text-center">
                {userPages.length > 0 ? (
                  <>
                    <p class="text-2xl font-bold text-yellow-600">No Plan</p>
                    <p class="text-sm text-muted-foreground mt-1">
                      Subscribe to activate
                    </p>
                  </>
                ) : (
                  <>
                    <p class="text-lg font-semibold text-muted-foreground">Create a Page First</p>
                    <p class="text-sm text-muted-foreground mt-1">
                      Then subscribe
                    </p>
                  </>
                )}
              </div>
            )}
          </CardContent>
          <CardFooter class="flex-col gap-2">
            <a href="/pricing" class="w-full">
              <Button variant="outline" class="w-full">
                {isSubscriptionExpired ? 'Renew' : isSubscriptionActive ? 'Change Plan' : 'View Plans'}
              </Button>
            </a>
            {userPages.length > 0 && !subscription && (
              <a href={`/subscribe?page=${userPages[0].id}`} class="w-full">
                <Button class="w-full">Subscribe Now</Button>
              </a>
            )}
          </CardFooter>
        </Card>

        <!-- Quick Links -->
        <Card>
          <CardHeader>
            <CardTitle>Quick Links</CardTitle>
          </CardHeader>
          <CardContent class="space-y-2">
            <a href="/businesses" class="block">
              <Button variant="ghost" class="w-full justify-start">Browse Directory</Button>
            </a>
            <a href="/pricing" class="block">
              <Button variant="ghost" class="w-full justify-start">Pricing</Button>
            </a>
          </CardContent>
        </Card>
      </div>
    </div>
  </div>
</Layout>