---
import { getProductTypeGradient } from '@/lib/ui/card-colors';
import { buildProductHref } from '@/lib/ui/card-helpers';

interface Props {
  title: string;
  businessTitle?: string;
  businessSlug?: string;
  priceFields?: Array<{label: string; value: string; unit: string}>;
  thumbnail?: string | null;
  slug?: string;
  productType?: string;
  class?: string;
}

const {
  title,
  businessTitle = '',
  businessSlug = '',
  priceFields = [],
  thumbnail = null,
  slug = '',
  productType = 'product',
  class: className = '',
} = Astro.props;

// Display price format: "$4.50 / bottle"
const displayPrice = priceFields.length > 0 && priceFields[0].value
  ? `$${priceFields[0].value} / ${priceFields[0].unit || 'unit'}`
  : 'Price on request';

const href = buildProductHref(businessSlug, slug);
const gradientClass = getProductTypeGradient(productType);
---
  href={href}
  class:list={["block group cursor-pointer", className]}
  data-card
>
  <div class="relative bg-card rounded-xl border border-border shadow-sm hover:shadow-lg hover:border-primary/50 hover:-translate-y-0.5 transition-all duration-300 overflow-hidden cursor-pointer">
    <!-- Thumbnail -->
    <div class:list={["aspect-square relative overflow-hidden bg-gradient-to-br", gradientClass]}>
      {thumbnail ? (
        <img src={thumbnail} alt={title} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-4xl font-bold text-amber-500/40">{title.charAt(0)}</span>
        </div>
      )}

      <!-- Price badge - compact -->
      <div class="absolute bottom-1.5 right-1.5 sm:bottom-2 sm:right-2 bg-black/80 backdrop-blur-sm px-1.5 py-0.5 sm:px-2 sm:py-1 rounded">
        <span class="text-white text-xs sm:text-xs font-semibold">{displayPrice}</span>
      </div>
    </div>

    <!-- Content - compact -->
    <div class="p-2 sm:p-3">
      <h3 class="font-medium sm:font-semibold text-xs sm:text-sm truncate group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors leading-tight">
        {title}
      </h3>
      {businessTitle && (
        <p class="text-xs sm:text-xs text-muted-foreground truncate mt-0.5">
          by {businessTitle}
        </p>
      )}
    </div>
  </div>
</a>
