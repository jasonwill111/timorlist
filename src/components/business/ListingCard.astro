---
import { getListingTypeGradient, LISTING_TYPE_LABELS } from '@/lib/ui/card-colors';
import { buildListingHref } from '@/lib/ui/card-helpers';
import { resolveEntityImage } from '@/lib/ui/image-utils';

interface Props {
  title: string;
  slug: string;
  price?: string;
  listingType?: string;
  condition?: string;
  location?: string;
  thumbnail?: string | null;
  profileImageId?: string | null;
  imageIds?: string[];
  likes?: number;
  views?: number;
  class?: string;
}

const {
  title,
  slug,
  price = "",
  listingType = "product",
  condition = "",
  location = "",
  thumbnail = null,
  profileImageId = null,
  imageIds = [],
  likes = 0,
  views = 0,
  class: className = "",
} = Astro.props;

const imageSrc = resolveEntityImage(thumbnail, profileImageId, imageIds);
const href = buildListingHref(slug);
const gradientClass = getListingTypeGradient(listingType);
const typeLabel = LISTING_TYPE_LABELS[listingType] || listingType;
---
<a href={href} class:list={["block group cursor-pointer", className]} data-card>
  <div class="relative bg-card rounded-xl border border-border shadow-sm hover:shadow-lg hover:border-primary/50 hover:-translate-y-0.5 transition-all duration-300 overflow-hidden cursor-pointer">
    <!-- Thumbnail -->
    <div class:list={["aspect-square relative overflow-hidden bg-gradient-to-br", gradientClass]}>
      {imageSrc ? (
        <img src={imageSrc} alt={title} class="w-full h-full object-cover" loading="lazy" />
      ) : (
        <div class="absolute inset-0 flex items-center justify-center">
          <span class="text-4xl font-bold text-emerald-500/40">{title.charAt(0)}</span>
        </div>
      )}

      <!-- Price badge -->
      {price && (
        <div class="absolute bottom-1.5 right-1.5 sm:bottom-2 sm:right-2 bg-black/80 backdrop-blur-sm px-1.5 py-0.5 sm:px-2 sm:py-1 rounded">
          <span class="text-white text-xs sm:text-xs font-semibold">{price}</span>
        </div>
      )}

      <!-- Type badge -->
      <div class="absolute top-1.5 left-1.5 sm:top-2 sm:left-2">
        <span class="text-xs sm:text-xs px-1.5 py-0.5 rounded font-medium bg-black/70 text-white backdrop-blur-sm">
          {typeLabel}
        </span>
      </div>
    </div>

    <!-- Content -->
    <div class="p-2 sm:p-3">
      <h3 class="font-medium sm:font-semibold text-xs sm:text-sm truncate group-hover:text-emerald-700 dark:group-hover:text-emerald-400 transition-colors leading-tight">
        {title}
      </h3>
      <div class="flex items-center justify-between mt-0.5">
        {location && (
          <span class="flex items-center gap-0.5 text-xs sm:text-xs text-muted-foreground truncate">
            <svg class="w-2 h-2 sm:w-2.5 sm:h-2.5 flex-shrink-0 text-muted-foreground/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            </svg>
            <span class="truncate">{location}</span>
          </span>
        )}
        {likes > 0 && (
          <span class="flex items-center gap-0.5 text-xs sm:text-xs text-muted-foreground">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span>{likes}</span>
          </span>
        )}
      </div>
    </div>
  </div>
</a>