---
/**
 * ToastContainer — Starwind-style differential component
 *
 * Renders an empty viewport that listens for `window` 'toast' custom events
 * and appends visually-styled toasts. Pure vanilla JS — no runtime deps.
 *
 * Usage from any client script:
 *   window.dispatchEvent(
 *     new CustomEvent("toast", {
 *       detail: { title: "Saved", description: "Your changes were saved", variant: "success" },
 *     })
 *   )
 *
 * Or import the shared helper:
 *   import { toast } from "@/lib/toast";
 *   toast.success("Saved!");
 */
---

<ol
  id="toast-viewport"
  data-slot="toast-viewport"
  tabindex="-1"
  aria-live="polite"
  class="fixed top-0 z-[100] flex max-h-screen w-full flex-col-reverse p-4 sm:bottom-0 sm:right-0 sm:top-auto sm:flex-col md:max-w-[420px] pointer-events-none"
></ol>

<script>
  type ToastVariant = "default" | "destructive" | "success"

  interface ToastDetail {
    title?: string
    description?: string
    variant?: ToastVariant
    duration?: number
  }

  const VARIANT_CLASS: Record<ToastVariant, string> = {
    default:
      "border bg-background text-foreground",
    destructive:
      "border-destructive/50 bg-destructive/10 text-destructive",
    success:
      "border-green-500/50 bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-400",
  }

  const BASE_CLASS =
    "group/toast pointer-events-auto relative flex w-full items-start justify-between gap-3 overflow-hidden rounded-lg p-4 pr-8 shadow-lg transition-all mb-2 " +
    "data-[state=open]:animate-in data-[state=open]:slide-in-from-right-full " +
    "data-[state=closed]:animate-out data-[state=closed]:fade-out-80 data-[state=closed]:slide-out-to-right-full"

  function escapeHtml(s: string): string {
    const d = document.createElement("div")
    d.textContent = s
    return d.innerHTML
  }

  function makeToastEl(detail: ToastDetail): HTMLElement {
    const variant: ToastVariant = detail.variant ?? "default"
    const duration = detail.duration ?? 5000

    const root = document.createElement("div")
    root.setAttribute("role", "status")
    root.setAttribute("data-slot", "toast")
    root.setAttribute("data-variant", variant)
    root.setAttribute("data-state", "open")
    root.setAttribute("data-duration", String(duration))
    root.className = `${BASE_CLASS} ${VARIANT_CLASS[variant]}`

    const text = document.createElement("div")
    text.className = "flex-1 min-w-0"

    if (detail.title) {
      const t = document.createElement("div")
      t.setAttribute("data-slot", "toast-title")
      t.className = "text-sm font-semibold"
      t.innerHTML = escapeHtml(detail.title)
      text.appendChild(t)
    }
    if (detail.description) {
      const d = document.createElement("div")
      d.setAttribute("data-slot", "toast-description")
      d.className = "text-sm opacity-90 mt-1"
      d.innerHTML = escapeHtml(detail.description)
      text.appendChild(d)
    }
    root.appendChild(text)

    const close = document.createElement("button")
    close.type = "button"
    close.setAttribute("data-slot", "toast-close")
    close.setAttribute("aria-label", "Close")
    close.className =
      "absolute right-2 top-2 rounded-md p-1 text-foreground/50 opacity-0 transition-opacity hover:text-foreground group-hover:opacity-100"
    close.innerHTML = "&times;"
    close.addEventListener("click", () => dismiss(root))
    root.appendChild(close)

    return root
  }

  function dismiss(el: HTMLElement) {
    el.setAttribute("data-state", "closed")
    // Allow exit animation to play before removing from DOM
    setTimeout(() => el.remove(), 200)
  }

  function show(detail: ToastDetail) {
    const viewport = document.getElementById("toast-viewport")
    if (!viewport) return
    const el = makeToastEl(detail)
    viewport.appendChild(el)
    setTimeout(() => dismiss(el), detail.duration ?? 5000)
  }

  window.addEventListener("toast", (e) => {
    const ev = e as CustomEvent<ToastDetail>
    if (!ev.detail) return
    show(ev.detail)
  })
</script>
