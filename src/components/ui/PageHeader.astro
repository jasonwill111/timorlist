---
/**
 * PageHeader - Standard page title with optional description and actions.
 * Use at the top of pages to maintain consistent header layout.
 *
 * Usage:
 *   <PageHeader title="Categories" description="Manage your product categories">
 *     <Button>Add Category</Button>
 *   </PageHeader>
 */
interface Props {
  title: string;
  description?: string;
  class?: string;
}

const {
  title,
  description,
  class: className = '',
} = Astro.props;
---

<div class:list={['flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 mb-6', className]}>
  <div class="flex-1 min-w-0">
    <h1 class="text-3xl font-bold leading-tight tracking-tight text-foreground">{title}</h1>
    {description && (
      <p class="mt-1 text-sm text-muted-foreground">{description}</p>
    )}
  </div>
  <div class="flex flex-shrink-0 gap-2">
    <slot name="actions" />
  </div>
</div>
