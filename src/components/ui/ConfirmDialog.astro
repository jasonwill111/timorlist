import Button from './Button.astro';

---
/**
 * ConfirmDialog - Static modal for destructive action confirmation.
 * Use lib/modal.ts injectModal/removeModal for runtime-injected modals.
 *
 * Usage:
 *   <ConfirmDialog id="delete-product" title="Delete product?" message="This cannot be undone." variant="danger">
 *     <button data-confirm>Delete</button>
 *     <button data-cancel>Cancel</button>
 *   </ConfirmDialog>
 */
interface Props {
  id: string;
  title: string;
  message: string;
  confirmText?: string;
  cancelText?: string;
  variant?: 'danger' | 'warning' | 'info';
  class?: string;
}

const {
  id,
  title,
  message,
  confirmText = 'Confirm',
  cancelText = 'Cancel',
  variant = 'danger',
  class: className = '',
} = Astro.props;

---

<dialog id={id} class:list={['rounded-lg shadow-xl p-0 w-full max-w-md backdrop:bg-black/50', className]}>
  <div class="p-6">
    <h3 class="text-lg font-semibold text-foreground mb-2">{title}</h3>
    <p class="text-sm text-muted-foreground mb-6">{message}</p>
    <div class="flex justify-end gap-3">
      <Button
        variant="outline"
        size="sm"
        data-cancel
        class="px-4 py-2 text-sm font-medium rounded-md border border-input bg-background hover:bg-muted"
      >
        {cancelText}
      </Button>
      <Button
        variant={variant === 'danger' ? 'destructive' : variant === 'warning' ? 'default' : 'default'}
        size="sm"
        data-confirm
        class="px-4 py-2 text-sm font-medium rounded-md"
      >
        {confirmText}
      </Button>
    </div>
  </div>
</dialog>
