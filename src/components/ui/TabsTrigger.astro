import Button from './Button.astro';

interface Props {
  value: string;
  class?: string;
  'data-slot'?: string;
}

const {
  value,
  class: className = '',
  'data-slot': slot = 'tabs-trigger',
  ...props
} = Astro.props;

<Button
  variant="ghost"
  size="sm"
  class:list={['min-h-[44px] data-active:bg-background data-active:text-foreground data-active:shadow-sm', className]}
  data-tab-trigger={value}
  data-slot={slot}
  {...props}
>
  <slot />
</Button>
