---
interface Props {
  value: string;
  class?: string;
  'data-slot'?: string;
}

const {
  value,
  class: className = '',
  'data-slot': slot = 'tabs-trigger',
  ...props
} = Astro.props;
---

<button
  type="button"
  class:list={[
    'px-4 py-2 text-sm font-medium border-b-2 border-transparent',
    'data-active:border-primary data-active:text-foreground',
    'hover:border-muted-foreground hover:text-foreground',
    'transition-colors rounded-none',
    className
  ]}
  data-tab-trigger={value}
  data-slot={slot}
  {...props}
>
  <slot />
</button>