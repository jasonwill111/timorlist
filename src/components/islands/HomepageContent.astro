---
/**
 * HomepageContent — Data-loading wrapper for the homepage.
 * Fetches featured content via lib/db/queries/homepage and delegates
 * UI rendering to HomepageTabs.astro. Keeps server island cacheable.
 */
import { getHomepageContent } from "@/lib/db/queries/homepage";
import HomepageTabs from "@/components/islands/HomepageTabs.astro";

let data: Awaited<ReturnType<typeof getHomepageContent>> = {
  businesses: [],
  listings: [],
  publicSectors: [],
  nonProfits: [],
};

try {
  data = await getHomepageContent();
} catch (e) {
  console.error("Failed to fetch homepage data:", e);
}
---

<HomepageTabs data={data} />
