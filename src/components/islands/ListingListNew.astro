import { getDb } from '@/lib/db';
import { desc, eq } from 'drizzle-orm';
import Select from '@/components/ui/Select.astro';
import Input from '@/components/ui/Input.astro';
import { listings, listingCategories } from '@/db/schema';
const searchParams = Astro.url.searchParams;
const search = searchParams.get('q') || '';
const type = searchParams.get('type') || '';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

let allListings: Array<{
  id: string;
  title: string;
  slug: string;
  description: string | null;
  price: string | null;
  listingType: string;
  location: string | null;
  imageIds: string[];
  likes: number | null;
  views: number | null;
  status: string | null;
}> = [];

// Derive listing type from category parent slug
const typeMap: Record<string, string> = {
  'vehicles': 'vehicle',
  'property-sale': 'property',
  'for-sale': 'product',
  'jobs': 'job',
  'services': 'service',
  'rentals': 'rental',
  'wanted': 'wanted',
  'community': 'community',
  'pets-animals': 'pet',
  'agriculture': 'agriculture',
};

const db = await getDb();
if (db) {
  try {
    const results = await db.select({
      listing: listings,
      category: listingCategories,
    })
    .from(listings)
    .leftJoin(listingCategories, eq(listings.categoryId, listingCategories.id))
    .orderBy(desc(listings.createdAt))
    .all();

    allListings = results.map(r => {
      const categoryParentSlug = r.category?.slug || 'for-sale';
      const listingType = typeMap[categoryParentSlug] || 'product';
      return {
        id: r.listing.id,
        title: r.listing.title,
        slug: r.listing.slug,
        description: r.listing.description,
        price: r.listing.price,
        listingType,
        location: r.listing.location,
        imageIds: r.listing.imageIds || [],
        likes: r.listing.likes,
        views: r.listing.views,
        status: r.listing.status,
      };
    });
  } catch (e) {
    console.error('Query error:', e);
  }
}

const total = allListings.length;
const totalPages = Math.ceil(total / LIMIT);
const entities = allListings.slice(offset, offset + LIMIT);
---

<!-- Header with count -->
<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl sm:text-3xl font-bold">Classified Ads</h1>
  <span class="text-sm text-muted-foreground">{total} total</span>
</div>

<!-- Search & Filter -->
<form method="GET" action="/listings" class="bg-card rounded-2xl border border-border/50 p-4 mb-6 shadow-sm">
  <div class="flex flex-col sm:flex-row gap-3">
    <div class="relative flex-1">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      <Input name="q" type="search" placeholder="Search listings..." value={search}
        class="w-full pl-10 pr-4 rounded-xl border border-border bg-background focus:border-primary focus:ring-2 focus:ring-primary/20 transition-all" />
    </div>
    <Select name="type" onchange="this.form.submit()" class="h-11 px-4 rounded-xl border border-border bg-background text-sm cursor-pointer hover:border-primary/50 transition-colors">
      <option value="">All Types</option>
      <option value="product" selected={type === 'product'}>Product</option>
      <option value="vehicle" selected={type === 'vehicle'}>Vehicle</option>
      <option value="property" selected={type === 'property'}>Property</option>
      <option value="job" selected={type === 'job'}>Job</option>
      <option value="service" selected={type === 'service'}>Service</option>
      <option value="wanted" selected={type === 'wanted'}>Wanted</option>
    </Select>
</form>

<!-- Listings Grid using ListingCard component -->
{entities.length > 0 ? (
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {entities.map(l => (
      <ListingCard
        title={l.title}
        slug={l.slug}
        price={l.price || ''}
        listingType={l.listingType || 'product'}
        location={l.location?.split(',')[0] || ''}
        imageIds={l.imageIds || []}
        likes={l.likes || 0}
        views={l.views || 0}
      />
    ))}
  </div>
) : (
  <div class="text-center py-16">
    <svg class="w-16 h-16 mx-auto text-muted-foreground/50 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
    </svg>
    <h3 class="text-lg font-medium mb-2">No listings found</h3>
    <p class="text-muted-foreground">Try adjusting your search or filters</p>
  </div>
)}

<!-- Pagination -->
{totalPages > 1 && (
  <nav class="flex justify-center gap-2 mt-8" aria-label="Pagination">
    {page > 1 && (
      <a href={buildUrl({ page: String(page - 1) })} class="px-4 py-2 rounded-lg border hover:bg-muted transition-colors">
        Previous
      </a>
    )}
    {Array.from({ length: Math.min(5, totalPages) }, (_, i) => {
      const p = i + 1;
      return (
        <a href={buildUrl({ page: String(p) })} class={`px-4 py-2 rounded-lg border ${p === page ? 'bg-primary text-primary-foreground' : 'hover:bg-muted'}`}>
          {p}
        </a>
      );
    })}
    {page < totalPages && (
      <a href={buildUrl({ page: String(page + 1) })} class="px-4 py-2 rounded-lg border hover:bg-muted transition-colors">
        Next
      </a>
    )}
  </nav>
)}

<script is:inline>
  function buildUrl(params) {
    const p = new URLSearchParams(window.location.search);
    Object.entries(params).forEach(([k, v]) => {
      if (v) p.set(k, v);
    });
    return `/listings?${p.toString()}`;
  }
</script>
