---
/**
 * ProductsTableIsland - SKU list, search, filters
 * Part of ProductsIsland split. Dispatches CustomEvents for edit/delete actions.
 */
interface ProductData {
  id: string;
  businessId: string | null;
  categoryId: string | null;
  title: string | null;
  slug: string | null;
  description: string | null;
  productType: string | null;
  priceFields: string | null;
  specifications: string | null;
  images: string | null;
  active: number | null;
  createdAt: number | null;
  businessTitle?: string;
}

interface BusinessOption {
  value: string;
  label: string;
}

interface Props {
  products: ProductData[];
  businessOptions: BusinessOption[];
  skuCount?: number;
}

const { products, businessOptions, skuCount } = Astro.props;
---

<!-- Page Header -->
<div class="mb-4 md:mb-6 flex items-start justify-between gap-2">
  <div class="min-w-0">
    <h1 class="text-3xl font-bold leading-tight">Products</h1>
    <p class="text-xs md:text-sm text-muted-foreground hidden sm:block">Manage products and services with flexible pricing</p>
  </div>
  <button
    id="add-product-btn"
    class="text-xs px-2 py-1 h-7 border rounded-lg hover:bg-muted flex items-center gap-1 md:text-sm md:px-4 md:h-9 whitespace-nowrap"
  >
    + Add Product
  </button>
</div>

<!-- Search and Filters -->
<div class="bg-card border rounded-lg p-3 md:p-4 mb-4">
  <div class="flex flex-col md:flex-row gap-3">
    <div class="flex-1">
      <input
        type="text"
        id="search-input"
        placeholder="Search by title..."
        class="w-full px-3 py-2 border rounded-md text-sm bg-background"
      />
    </div>
    <div class="flex gap-2">
      <select
        id="business-filter"
        class="px-3 py-2 border rounded-lg text-sm bg-background"
      >
        <option value="">All Businesses</option>
      </select>
      <select
        id="type-filter"
        class="px-3 py-2 border rounded-lg text-sm bg-background"
      >
        <option value="">All Types</option>
        <option value="product">Product</option>
        <option value="service">Service</option>
        <option value="subscription">Subscription</option>
      </select>
    </div>
  </div>
</div>

<!-- SKUs List -->
<div class="bg-card border rounded-lg p-3 md:p-4">
  <div class="flex items-center justify-between mb-4">
    <span id="skus-count" class="text-xs text-muted-foreground">{skuCount ?? products.length} SKUs</span>
  </div>
  <div id="skus-list" class="space-y-2">
    {products.length === 0 ? (
      <p class="text-center text-muted-foreground py-8">No products found</p>
    ) : (
      products.map((sku) => {
        let priceDisplay = 'Ask for price';
        try {
          const fields = sku.priceFields ? JSON.parse(sku.priceFields) : [];
          if (fields.length > 0 && fields[0].value) {
            const unit = fields[0].unit ? ` / ${fields[0].unit.replace('/', '')}` : '';
            priceDisplay = `$${fields[0].value}${unit}`;
          }
        } catch (e) { /* ignore */ }
        const typeClass = sku.productType === 'product'
          ? 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200'
          : 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200';
        return (
          <div class="flex items-center justify-between p-2 md:p-3 border rounded text-sm hover:bg-muted/30">
            <div class="min-w-0 flex-1">
              <p class="font-medium truncate">{sku.title || 'Untitled'}</p>
              <p class="text-xs text-muted-foreground">{priceDisplay} - {sku.businessTitle || 'Unknown'}</p>
            </div>
            <div class="flex items-center gap-2">
              <span class={`px-2 py-0.5 text-xs rounded-full ${typeClass}`}>{sku.productType || 'product'}</span>
              <button
                data-action="edit-sku"
                data-id={sku.id}
                class="text-primary hover:text-primary/80 text-xs px-2 py-1"
              >
                Edit
              </button>
              <button
                data-action="delete-sku"
                data-id={sku.id}
                class="text-red-500 hover:text-red-600 text-xs px-2 py-1"
              >
                Del
              </button>
            </div>
          </div>
        );
      })
    )}
  </div>
</div>

<script>
  const businessOptions = (window as any).__productBusinessOptions || [];

  // Populate business filter select
  const businessFilter = document.getElementById('business-filter') as HTMLSelectElement | null;
  if (businessFilter) {
    businessFilter.innerHTML = '<option value="">All Businesses</option>' +
      businessOptions.map((b: any) => `<option value="${b.value}">${b.label}</option>`).join('');
  }

  // Dispatch CustomEvents — parent (ProductsIsland) listens and opens the Form modal
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
    if (!btn) return;
    const action = btn.dataset.action;
    const id = btn.dataset.id;
    if (action === 'edit-sku' && id) {
      document.dispatchEvent(new CustomEvent('sku-edit', { detail: { id } }));
    } else if (action === 'delete-sku' && id) {
      document.dispatchEvent(new CustomEvent('sku-delete', { detail: { id } }));
    }
  });

  // "Add Product" button — parent opens modal in create mode
  document.getElementById('add-product-btn')?.addEventListener('click', () => {
    document.dispatchEvent(new CustomEvent('sku-create', { detail: {} }));
  });

  // Search/filter — relay to parent renderer
  document.getElementById('search-input')?.addEventListener('input', () => {
    document.dispatchEvent(new CustomEvent('sku-filter-change', { detail: {
      search: (document.getElementById('search-input') as HTMLInputElement)?.value || '',
      business: (document.getElementById('business-filter') as HTMLSelectElement)?.value || '',
      type: (document.getElementById('type-filter') as HTMLSelectElement)?.value || '',
    }}));
  });
  document.getElementById('business-filter')?.addEventListener('change', () => {
    document.dispatchEvent(new CustomEvent('sku-filter-change', { detail: {
      search: (document.getElementById('search-input') as HTMLInputElement)?.value || '',
      business: (document.getElementById('business-filter') as HTMLSelectElement)?.value || '',
      type: (document.getElementById('type-filter') as HTMLSelectElement)?.value || '',
    }}));
  });
  document.getElementById('type-filter')?.addEventListener('change', () => {
    document.dispatchEvent(new CustomEvent('sku-filter-change', { detail: {
      search: (document.getElementById('search-input') as HTMLInputElement)?.value || '',
      business: (document.getElementById('business-filter') as HTMLSelectElement)?.value || '',
      type: (document.getElementById('type-filter') as HTMLSelectElement)?.value || '',
    }}));
  });
</script>
