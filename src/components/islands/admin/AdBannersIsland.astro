---
/**
 * AdBannersIsland - Admin ad banners management island
 * Replaces innerHTML list rendering with Astro component markup
 * Server-fetched data passed as props; client handles interactions
 */
import { actions } from 'astro:actions';
import { Button } from '@/components/fulldev/button';
import { Input } from '@/components/fulldev/input';
import { Select } from '@/components/fulldev/select';
import { Textarea } from '@/components/fulldev/textarea';

interface HeroData {
  id: string;
  title: string;
  description: string | null;
  imageId: string | null;
  externalUrl: string | null;
  linkedBusinessPageId: string | null;
  isActive: boolean;
}

interface Business {
  id: string;
  title: string;
}

interface Props {
  heroes: HeroData[];
  businesses: Business[];
}

const { heroes, businesses } = Astro.props;
---

<div class="ad-banners-island" data-page="ad-banners">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6 flex items-start justify-between gap-2">
    <div class="min-w-0">
      <h1 class="text-3xl font-bold leading-tight truncate">Ad Banners</h1>
      <p class="text-xs md:text-sm text-muted-foreground hidden sm:block">Manage homepage ad banners</p>
    </div>
    <Button id="add-hero-btn" class="text-xs px-2 py-1 h-7 flex-shrink-0 whitespace-nowrap md:text-sm md:px-4 md:h-9">+ Add Hero</Button>
  </div>

  <!-- Heroes List -->
  <div class="bg-card border rounded-lg p-3 md:p-4">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
      <h3 class="text-lg font-medium leading-snug mb-3 md:mb-4">All Heroes</h3>
      <span id="heroes-count" class="text-xs text-muted-foreground">{heroes.length} hero{heroes.length !== 1 ? 'es' : ''}</span>
    </div>
    <div id="heroes-list" class="space-y-2">
      {heroes.length === 0 ? (
        <p class="text-center text-muted-foreground py-8">No heroes yet. Click "+ Add Hero" to create one.</p>
      ) : (
        heroes.map((hero) => (
          <div class="flex items-center gap-3 p-3 border rounded text-sm">
            <div class="w-16 h-10 bg-muted rounded overflow-hidden flex-shrink-0">
              {hero.imageId ? (
                <img
                  src={`/api/media/${hero.imageId}`}
                  alt={hero.title}
                  class="w-full h-full object-cover"
                  onerror="this.parentElement.innerHTML='<div class=\\'w-full h-full flex items-center justify-center text-xs\\'>📷</div>'"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-xs">📷</div>
              )}
            </div>
            <div class="min-w-0 flex-1">
              <p class="font-medium truncate">{hero.title}</p>
              <p class="text-xs text-muted-foreground truncate">{hero.description || 'No description'}</p>
              <div class="flex gap-1 mt-1">
                <button data-action="edit-hero" data-id={hero.id} class="px-2 py-1 text-xs border rounded hover:bg-primary/10 text-primary">Edit</button>
                <button data-action="delete-hero" data-id={hero.id} class="px-2 py-1 text-xs border rounded hover:bg-red-50 text-red-500">Del</button>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <span class={`px-2 py-0.5 text-xs rounded-full ${hero.isActive ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-300'}`}>
                {hero.isActive ? 'Active' : 'Inactive'}
              </span>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<!-- Create/Edit Hero Modal -->
<div id="hero-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-card border rounded-lg w-full max-w-lg max-h-[90vh] overflow-y-auto">
    <div class="p-4 border-b flex items-center justify-between sticky top-0 bg-card">
      <h2 id="modal-title" class="text-lg font-semibold leading-snug">Add Hero</h2>
      <Button id="close-modal" data-action="close-modal" variant="ghost" size="icon" class="p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </Button>
    </div>
    <form id="hero-form" class="p-4 space-y-4">
      <input type="hidden" id="hero-id" name="id" />
      <div>
        <label for="hero-title" class="block text-sm font-medium mb-1">Title *</label>
        <Input type="text" id="hero-title" name="title" required class="w-full" placeholder="Hero title" />
      </div>
      <div>
        <label for="hero-desc" class="block text-sm font-medium mb-1">Description</label>
        <Textarea id="hero-desc" name="description" rows={2} placeholder="Hero description..." />
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Image</label>
        <div id="hero-image-upload" class="border-2 border-dashed border-muted-foreground/25 rounded-lg p-3 text-center hover:border-muted-foreground/50 transition-colors cursor-pointer">
          <p class="text-xs text-muted-foreground">Click or drag to upload</p>
        </div>
        <input type="file" id="hero-image-file" accept="image/*" class="hidden" />
        <div id="hero-image-preview" class="mt-2 hidden">
          <div class="relative inline-block">
            <img id="hero-preview-img" class="w-full max-h-40 rounded-lg object-cover" />
            <Button id="remove-hero-image" variant="destructive" size="icon-xs" data-action="remove-hero-image" class="absolute top-1 right-1">×</Button>
          </div>
        </div>
        <input type="hidden" id="hero-image" name="imageId" value="" />
      </div>
      <div>
        <label for="hero-ext-url" class="block text-sm font-medium mb-1">External URL</label>
        <Input type="text" id="hero-ext-url" name="externalUrl" class="w-full" placeholder="https://..." />
      </div>
      <div>
        <label for="hero-business" class="block text-sm font-medium mb-1">Link to Business Page</label>
        <select id="hero-business" name="linkedBusinessPageId" class="w-full px-3 py-2 border rounded-md text-sm bg-background">
          <option value="">None</option>
          {businesses.map(biz => (
            <option value={biz.id}>{biz.title}</option>
          ))}
        </select>
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" id="hero-active" name="isActive" checked class="w-4 h-4" />
        <label for="hero-active" class="text-sm">Active</label>
      </div>
      <div class="flex gap-2 justify-end pt-2">
        <Button type="button" id="cancel-btn" variant="outline" class="text-xs py-1 h-8">Cancel</Button>
        <Button type="submit" class="text-xs py-1 h-8">Save</Button>
      </div>
    </form>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';
  import { uploadFile } from '../../../lib/client/upload-helper';

  let isEditMode = false;
  let heroImageId: string | null = null;

  // Image upload handler
  document.getElementById('hero-image-upload')?.addEventListener('click', () => {
    document.getElementById('hero-image-file')?.click();
  });
  document.getElementById('hero-image-file')?.addEventListener('change', async (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const result = await uploadFile(file, {
      type: 'hero',
      typeId: 'hero',
      compress: true,
      maxSizeMB: 1,
      maxWidthOrHeight: 1920,
    });

    if (result.success && result.data?.id) {
      heroImageId = result.data.id;
      (document.getElementById('hero-image') as HTMLInputElement).value = result.data.id;
      (document.getElementById('hero-preview-img') as HTMLImageElement).src = result.data.url;
      document.getElementById('hero-image-preview')?.classList.remove('hidden');
      document.getElementById('hero-image-upload')?.classList.add('hidden');
    } else {
      toast.error(result.error?.message || 'Failed to upload image');
    }
    (e.target as HTMLInputElement).value = '';
  });

  // Event delegation for data-action attributes
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('[data-action]') as HTMLElement | null;
    if (!target) return;
    const action = target.dataset.action;
    const id = target.dataset.id;
    switch (action) {
      case 'edit-hero':
        if (id) editHero(id);
        break;
      case 'delete-hero':
        if (id) deleteHero(id);
        break;
      case 'remove-hero-image':
        removeHeroImage();
        break;
      case 'close-modal':
        closeModal();
        break;
    }
  });

  function removeHeroImage() {
    heroImageId = null;
    (document.getElementById('hero-image') as HTMLInputElement).value = '';
    document.getElementById('hero-image-preview')?.classList.add('hidden');
    document.getElementById('hero-image-upload')?.classList.remove('hidden');
  }

  function closeModal() {
    const modal = document.getElementById('hero-modal');
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
  }

  async function editHero(id: string) {
    const container = document.getElementById('heroes-list');
    if (!container) return;

    const heroCard = container.querySelector(`[data-id="${id}"]`)?.closest('[class*="flex items-center"]');
    if (!heroCard) return;

    const title = heroCard.querySelector('p.font-medium')?.textContent || '';
    const desc = heroCard.querySelector('p.text-xs.text-muted-foreground')?.textContent || '';
    const isActive = heroCard.querySelector('.bg-green-100, .bg-green-900') !== null;

    isEditMode = true;
    document.getElementById('modal-title')!.textContent = 'Edit Hero';
    (document.getElementById('hero-id') as HTMLInputElement).value = id;
    (document.getElementById('hero-title') as HTMLInputElement).value = title;
    (document.getElementById('hero-desc') as HTMLTextAreaElement).value = desc;
    (document.getElementById('hero-active') as HTMLInputElement).checked = isActive;

    const modal = document.getElementById('hero-modal');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  }

  async function deleteHero(id: string) {
    if (!confirm('Delete this hero?')) return;

    try {
      const result = await actions.admin.heroes.delete({ id });
      if (result.success) {
        toast.success('Hero deleted');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to delete hero');
      }
    } catch (err) {
      console.error('Error deleting hero:', err);
      toast.error('Error deleting hero');
    }
  }

  const modal = document.getElementById('hero-modal');
  const addBtn = document.getElementById('add-hero-btn');
  const cancelBtn = document.getElementById('cancel-btn');
  addBtn?.addEventListener('click', () => {
    isEditMode = false;
    heroImageId = null;
    document.getElementById('modal-title')!.textContent = 'Add Hero';
    (document.getElementById('hero-form') as HTMLFormElement).reset();
    (document.getElementById('hero-id') as HTMLInputElement).value = '';
    (document.getElementById('hero-image') as HTMLInputElement).value = '';
    document.getElementById('hero-image-preview')?.classList.add('hidden');
    document.getElementById('hero-image-upload')?.classList.remove('hidden');
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
  });
  cancelBtn?.addEventListener('click', () => {
    closeModal();
  });
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  document.getElementById('hero-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);

    const heroData = {
      title: String(formData.get('title') || ''),
      description: String(formData.get('description') || ''),
      imageId: String(formData.get('imageId') || ''),
      ctaText: String(formData.get('ctaText') || ''),
      ctaLink: String(formData.get('ctaLink') || ''),
      isActive: (document.getElementById('hero-active') as HTMLInputElement).checked,
    };

    const heroId = formData.get('id');

    try {
      let result;
      if (heroId) {
        result = await actions.admin.heroes.update({ id: heroId as string, ...heroData });
      } else {
        result = await actions.admin.heroes.create(heroData);
      }

      if (result.success) {
        toast.success(isEditMode ? 'Hero updated!' : 'Hero created!');
        modal?.classList.add('hidden');
        modal?.classList.remove('flex');
        (e.target as HTMLFormElement).reset();
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to save hero');
      }
    } catch (err) {
      console.error('Error saving hero:', err);
      toast.error('Error saving hero');
    }
  });
</script>