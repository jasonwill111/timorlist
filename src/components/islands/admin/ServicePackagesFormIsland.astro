---
/**
 * ServicePackagesFormIsland - Create/Edit package modal
 * Part of ServicePackagesIsland split.
 */
import { Textarea } from '@/components/fulldev/textarea';

export interface PackageVariant {
  id: string;
  name: string;
  price: number;
  currency: string;
  durationValue: number;
  durationUnit: string;
  limits: {
    skuLimit?: number;
    maxImages?: number;
    maxVideos?: number;
    maxBusinessImages?: number;
    maxBusinessVideos?: number;
  };
  features: string[];
}

export interface ServicePackageData {
  id: string;
  name: string;
  slug: string;
  serviceRelationTo: string;
  description: string | null;
  variants: PackageVariant[];
  isActive: boolean;
  sortOrder: number;
  createdAt: number | null;
  updatedAt: number | null;
}
---

<!-- Edit/Create Plan Modal -->
<div id="plan-modal" class="fixed inset-0 bg-black/50 z-[60] hidden items-center justify-center p-4 overflow-y-auto">
  <div class="bg-card border rounded-lg w-full max-w-lg my-8">
    <div class="p-4 border-b flex items-center justify-between">
      <h2 class="text-lg font-semibold leading-snug" id="modal-title">Edit Plan</h2>
      <button id="close-modal" class="p-1 hover:bg-muted rounded" aria-label="Close">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <form id="plan-form" class="p-4 space-y-4">
      <input type="hidden" id="plan-id" name="id" />
      <input type="hidden" id="plan-mode" name="mode" value="edit" />

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="plan-name" class="block text-sm font-medium mb-1">Name *</label>
          <Input type="text" id="plan-name" name="name" required class="w-full h-9 px-3 rounded-md border bg-background text-sm" />
        </div>
        <div>
          <label for="package-type" class="block text-sm font-medium mb-1">Type</label>
          <Select id="package-type" name="serviceType" options={[
            { value: 'subscription', label: 'Subscription (Business Plan)' },
            { value: 'listing_renewal', label: 'Listing Renewal' },
            { value: 'ad_banner', label: 'Ad Banner' }
          ]} />
        </div>
      </div>

      <div>
        <label for="package-relation" class="block text-sm font-medium mb-1">Relation</label>
        <Select id="package-relation" name="serviceRelationTo" options={[
          { value: 'business', label: 'Business' },
          { value: 'listing', label: 'Listing' },
          { value: 'ad_banner', label: 'Ad Banner' }
        ]} />
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="plan-amount" class="block text-sm font-medium mb-1">Price (USD) *</label>
          <Input type="number" id="plan-amount" name="amount" required min="0" step="0.01" class="w-full h-9 px-3 rounded-md border bg-background text-sm" />
        </div>
        <div>
          <label for="plan-sortOrder" class="block text-sm font-medium mb-1">Sort Order</label>
          <Input type="number" id="plan-sortOrder" name="sortOrder" min="0" value="0" class="w-full h-9 px-3 rounded-md border bg-background text-sm" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-2">
        <div>
          <label for="plan-skuLimit" class="block text-xs font-medium mb-1">SKU Limit</label>
          <Input type="number" id="plan-skuLimit" name="skuLimit" required min="0" class="w-full h-9 px-3 rounded-md border bg-background text-xs" />
        </div>
        <div>
          <label for="plan-maxImages" class="block text-xs font-medium mb-1">Max Images</label>
          <Input type="number" id="plan-maxImages" name="maxImages" required min="0" class="w-full h-9 px-3 rounded-md border bg-background text-xs" />
        </div>
        <div>
          <label for="plan-maxVideos" class="block text-xs font-medium mb-1">Max Videos</label>
          <Input type="number" id="plan-maxVideos" name="maxVideos" required min="0" class="w-full h-9 px-3 rounded-md border bg-background text-xs" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label for="plan-maxBusinessImages" class="block text-xs font-medium mb-1">Business Images</label>
          <Input type="number" id="plan-maxBusinessImages" name="maxBusinessImages" required min="0" class="w-full h-9 px-3 rounded-md border bg-background text-xs" />
        </div>
        <div>
          <label for="plan-maxBusinessVideos" class="block text-xs font-medium mb-1">Business Videos</label>
          <Input type="number" id="plan-maxBusinessVideos" name="maxBusinessVideos" required min="0" class="w-full h-9 px-3 rounded-md border bg-background text-xs" />
        </div>
      </div>

      <div>
        <label for="plan-description" class="block text-sm font-medium mb-1">Description</label>
        <Textarea id="plan-description" name="description" rows={2} />
      </div>

      <div>
        <label for="plan-features" class="block text-sm font-medium mb-1">Features (one per line)</label>
        <Textarea id="plan-features" name="features" rows={4} placeholder="Feature 1&#10;Feature 2&#10;Feature 3" />
      </div>

      <div class="flex items-center gap-2">
        <input type="checkbox" id="plan-active" name="active" class="w-4 h-4 rounded border-gray-300" />
        <label for="plan-active" class="text-sm">Active</label>
      </div>

      <div class="flex justify-end gap-2 pt-2">
        <button type="button" id="delete-plan-btn" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded-md text-xs h-8 hidden">Delete</button>
        <div class="flex-1"></div>
        <button type="button" id="cancel-btn" class="px-3 py-1 border rounded-md text-xs h-8 hover:bg-muted">Cancel</button>
        <button type="submit" class="px-3 py-1 bg-primary text-primary-foreground rounded-md text-xs h-8 hover:opacity-90">Save Changes</button>
      </div>
    </form>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="delete-modal" class="fixed inset-0 bg-black/50 z-[70] hidden items-center justify-center p-4">
  <div class="bg-card border rounded-lg w-full max-w-sm my-8 p-6">
    <h2 class="text-lg font-semibold leading-snug mb-2">Delete Plan?</h2>
    <p class="text-sm text-muted-foreground mb-4">This action cannot be undone. Any users with this plan will lose access.</p>
    <div class="flex justify-end gap-2">
      <button type="button" id="cancel-delete" class="px-3 py-1 border rounded-md text-xs h-8 hover:bg-muted">Cancel</button>
      <button type="button" id="confirm-delete" class="bg-red-600 hover:bg-red-700 text-white px-3 py-1 rounded-md text-xs h-8">Delete</button>
    </div>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';
  import { actions } from 'astro:actions';

  let deleteTargetId: string | null = null;

  function closeModal() {
    const modal = document.getElementById('plan-modal');
    if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
  }

  function hideDeleteConfirm() {
    deleteTargetId = null;
    const modal = document.getElementById('delete-modal');
    if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); }
  }

  function showDeleteConfirm(planId: string) {
    deleteTargetId = planId;
    const modal = document.getElementById('delete-modal');
    if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
  }

  function openEditModal(pkg: any) {
    const firstVariant = pkg.variants?.[0] || {};
    (document.getElementById('plan-id') as HTMLInputElement).value = pkg.id;
    (document.getElementById('plan-name') as HTMLInputElement).value = pkg.name;
    (document.getElementById('plan-amount') as HTMLInputElement).value = String(firstVariant.price || 0);
    (document.getElementById('plan-skuLimit') as HTMLInputElement).value = String(firstVariant.limits?.skuLimit || 0);
    (document.getElementById('plan-maxImages') as HTMLInputElement).value = String(firstVariant.limits?.maxImages || 0);
    (document.getElementById('plan-maxVideos') as HTMLInputElement).value = String(firstVariant.limits?.maxVideos || 0);
    (document.getElementById('plan-maxBusinessImages') as HTMLInputElement).value = String(firstVariant.limits?.maxBusinessImages || 0);
    (document.getElementById('plan-maxBusinessVideos') as HTMLInputElement).value = String(firstVariant.limits?.maxBusinessVideos || 0);
    (document.getElementById('plan-sortOrder') as HTMLInputElement).value = String(pkg.sortOrder || 0);
    (document.getElementById('plan-description') as HTMLTextAreaElement).value = pkg.description || '';
    (document.getElementById('plan-features') as HTMLTextAreaElement).value = (firstVariant.features || []).join('\n');
    (document.getElementById('plan-active') as HTMLInputElement).checked = Boolean(pkg.isActive);
    const deleteBtn = document.getElementById('delete-plan-btn');
    if (deleteBtn) { deleteBtn.classList.remove('hidden'); deleteBtn.onclick = () => showDeleteConfirm(pkg.id); }
    const modal = document.getElementById('plan-modal');
    if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
  }

  function openCreateModal() {
    (document.getElementById('plan-id') as HTMLInputElement).value = '';
    (document.getElementById('plan-name') as HTMLInputElement).value = '';
    (document.getElementById('plan-amount') as HTMLInputElement).value = '';
    (document.getElementById('plan-skuLimit') as HTMLInputElement).value = '10';
    (document.getElementById('plan-maxImages') as HTMLInputElement).value = '5';
    (document.getElementById('plan-maxVideos') as HTMLInputElement).value = '1';
    (document.getElementById('plan-maxBusinessImages') as HTMLInputElement).value = '16';
    (document.getElementById('plan-maxBusinessVideos') as HTMLInputElement).value = '2';
    (document.getElementById('plan-sortOrder') as HTMLInputElement).value = '0';
    (document.getElementById('plan-description') as HTMLTextAreaElement).value = '';
    (document.getElementById('plan-features') as HTMLTextAreaElement).value = '';
    (document.getElementById('plan-active') as HTMLInputElement).checked = true;
    const deleteBtn = document.getElementById('delete-plan-btn');
    if (deleteBtn) deleteBtn.classList.add('hidden');
    const modal = document.getElementById('plan-modal');
    if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); }
  }

  async function deletePlan(planId: string) {
    try {
      const result: any = await actions.admin.servicePackagesAdmin.delete({ id: planId });
      if (result.success) {
        hideDeleteConfirm();
        closeModal();
        toast.success('Plan deleted');
        document.dispatchEvent(new CustomEvent('sp-deleted', { detail: { id: planId } }));
      } else {
        toast.error(result.error?.message || 'Failed to delete plan');
      }
    } catch (e) { toast.error('Failed to delete plan'); }
  }

  // Events from parent (ServicePackagesIsland)
  document.addEventListener('sp-create', () => openCreateModal());
  document.addEventListener('sp-edit', (e: any) => openEditModal(e.detail.pkg));

  // Close/cancel — merged delegation
  ['close-modal', 'cancel-btn'].forEach(id => document.getElementById(id)?.addEventListener('click', closeModal));
  document.getElementById('plan-modal')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });

  // Delete confirm — merged delegation
  ['cancel-delete', 'confirm-delete'].forEach((id, i) => {
    document.getElementById(id)?.addEventListener('click', i === 0 ? hideDeleteConfirm : () => { if (deleteTargetId) deletePlan(deleteTargetId); });
  });
  document.getElementById('delete-modal')?.addEventListener('click', (e) => { if (e.target === e.currentTarget) hideDeleteConfirm(); });

  // Submit
  document.getElementById('plan-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const formData = new FormData(form);
    const mode = formData.get('mode') as string;
    const id = formData.get('id') as string;
    const features = (formData.get('features') as string).split('\n').filter(f => f.trim());

    const variant = {
      name: formData.get('name') as string,
      price: parseFloat(formData.get('amount') as string) || 0,
      currency: 'USD',
      durationValue: 1,
      durationUnit: 'month',
      limits: {
        skuLimit: parseInt(formData.get('skuLimit') as string) || 0,
        maxImages: parseInt(formData.get('maxImages') as string) || 0,
        maxVideos: parseInt(formData.get('maxVideos') as string) || 0,
        maxBusinessImages: parseInt(formData.get('maxBusinessImages') as string) || 0,
        maxBusinessVideos: parseInt(formData.get('maxBusinessVideos') as string) || 0,
      },
      features,
    };

    try {
      let result: any;
      if (mode === 'edit' && id) {
        const existingPkg = (window as any).__spPackages?.find((p: any) => p.id === id);
        const variants = existingPkg?.variants || [variant];
        variants[0] = variant;
        result = await actions.admin.servicePackagesAdmin.update({
          id, name: formData.get('name') as string,
          description: formData.get('description') as string, variants, isActive: formData.get('active') === 'on',
          sortOrder: parseInt(formData.get('sortOrder') as string) || 0,
        });
      } else {
        const serviceRelationTo = (formData.get('serviceRelationTo') as string) || 'business';
        result = await actions.admin.servicePackagesAdmin.create({
          name: formData.get('name') as string,
          serviceType: (formData.get('serviceType') as 'subscription'|'listing_renewal'|'ad_banner') || 'subscription',
          serviceRelationTo: serviceRelationTo as 'business'|'listing'|'ad_banner',
          description: formData.get('description') as string || '', variants: [variant],
          isActive: formData.get('active') === 'on',
          sortOrder: parseInt(formData.get('sortOrder') as string) || 0,
        });
      }
      if (result.success) {
        closeModal();
        toast.success(mode === 'edit' ? 'Plan updated' : 'Plan created');
        document.dispatchEvent(new CustomEvent('sp-saved', { detail: { mode } }));
      } else {
        toast.error(result.error?.message || 'Failed to save plan');
      }
    } catch (e) { toast.error('Failed to save plan'); }
  });
</script>
