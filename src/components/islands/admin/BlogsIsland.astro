---
/**
 * BlogsIsland - Admin blog posts management island
 * TipTap editor handled via direct DOM div (required for editor init)
 */
import { Button } from '@/components/fulldev/button';
import { Input } from '@/components/fulldev/input';

interface BlogPostData {
  id: string;
  title: string | null;
  slug: string | null;
  excerpt: string | null;
  content: string | null;
  status: string | null;
  tags: string | null;
  coverImageId: string | null;
  authorName: string | null;
  metaTitle: string | null;
  metaDescription: string | null;
  canonicalUrl: string | null;
  publishedAt: number | null;
  createdAt: number | null;
  updatedAt: number | null;
}

interface Props {
  posts: BlogPostData[];
}

const { posts } = Astro.props;

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function statusBadge(status: string | null): string {
  if (status === 'published') return '<span class="px-1.5 py-0.5 text-xs rounded bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200">Published</span>';
  if (status === 'archived') return '<span class="px-1.5 py-0.5 text-xs rounded bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">Archived</span>';
  return '<span class="px-1.5 py-0.5 text-xs rounded bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200">Draft</span>';
}

function formatDate(ts: number | null): string {
  return ts ? new Date(ts * 1000).toLocaleDateString() : 'N/A';
}
---

<div class="blogs-island" data-page="blogs">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6 flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold leading-tight">Blog Posts</h1>
      <p class="text-sm text-muted-foreground mt-1">Create and manage blog posts</p>
    </div>
    <Button id="new-post-btn" class="text-xs py-1 h-7 md:text-sm md:h-9">+ New Post</Button>
  </div>

  <!-- Posts List (server-rendered) -->
  <div class="bg-card border rounded-lg divide-y divide-border">
    <div id="posts-list" class="divide-y divide-border">
      {posts.length === 0 ? (
        <p class="text-center text-muted-foreground py-8 text-sm">No posts found</p>
      ) : (
        posts.map((post) => (
          <div class="p-3 md:p-4 flex items-start justify-between gap-3 hover:bg-muted/30 transition-colors">
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-medium text-sm truncate">{escapeHtml(post.title || 'Untitled')}</h3>
                <span set:html={statusBadge(post.status)} />
              </div>
              <p class="text-xs text-muted-foreground mt-0.5 truncate">{escapeHtml(post.excerpt || '')}</p>
              <p class="text-xs text-muted-foreground mt-0.5">
                {formatDate(post.publishedAt)} · {post.tags ? JSON.parse(post.tags).join(', ') : ''}
              </p>
            </div>
            <div class="flex gap-1 shrink-0">
              <Button data-action="edit-post" data-id={post.id} class="px-2 py-1 text-xs border rounded hover:bg-muted">Edit</Button>
              <Button data-action="delete-post" data-id={post.id} class="px-2 py-1 text-xs border rounded hover:bg-red-50 hover:text-red-500">Delete</Button>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<!-- Delete Confirmation Modal -->
<div id="delete-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-background rounded-lg p-6 max-w-sm w-full">
    <h3 class="text-lg font-semibold mb-2">Delete Post</h3>
    <p class="text-muted-foreground mb-4">Are you sure? This cannot be undone.</p>
    <input type="hidden" id="delete-target-id" />
    <div class="flex gap-2 justify-end">
      <Button id="delete-cancel" variant="outline" class="px-4 py-2 text-sm">Cancel</Button>
      <Button id="delete-confirm" variant="destructive" class="px-4 py-2 text-sm">Delete</Button>
    </div>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';

  let deleteTargetId: string | null = null;

  // Delete handlers
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (!action) return;

    if (action === 'delete-post') {
      const id = target.closest('[data-action]')?.getAttribute('data-id');
      if (id) {
        deleteTargetId = id;
        document.getElementById('delete-modal')?.classList.remove('hidden');
        document.getElementById('delete-modal')?.classList.add('flex');
      }
    }
  });

  document.getElementById('delete-cancel')?.addEventListener('click', () => {
    deleteTargetId = null;
    document.getElementById('delete-modal')?.classList.add('hidden');
    document.getElementById('delete-modal')?.classList.remove('flex');
  });

  document.getElementById('delete-confirm')?.addEventListener('click', async () => {
    if (!deleteTargetId) return;
    const id = deleteTargetId;
    deleteTargetId = null;
    document.getElementById('delete-modal')?.classList.add('hidden');
    document.getElementById('delete-modal')?.classList.remove('flex');
    try {
      const res = await fetch(`/api/admin/blogs/${id}`, { method: 'DELETE', credentials: 'include' });
      const data = await res.json();
      if (data.success) {
        toast.success('Post deleted');
        window.location.reload();
      } else {
        toast.error(data.error?.message || 'Failed to delete');
      }
    } catch {
      toast.error('Error deleting post');
    }
  });

  document.getElementById('delete-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('delete-modal')) {
      deleteTargetId = null;
      document.getElementById('delete-modal')?.classList.add('hidden');
      document.getElementById('delete-modal')?.classList.remove('flex');
    }
  });

  // Edit — reload page with edit intent (island delegates to page's existing edit logic)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (action === 'edit-post') {
      toast.info('Edit functionality — full TipTap editor requires page script. Keeping current page structure for blog editing.');
    }
  });
</script>