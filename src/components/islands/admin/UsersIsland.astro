---
/**
 * UsersIsland - Admin users management island
 */
import { actions } from 'astro:actions';
import { Button } from '@/components/fulldev/button';
import { Input } from '@/components/fulldev/input';
import { Select } from '@/components/fulldev/select';

interface UserData {
  id: string;
  name: string | null;
  email: string | null;
  phone: string | null;
  role: string | null;
  createdAt: number | null;
  updatedAt: number | null;
}

interface Props {
  users: UserData[];
}

const { users } = Astro.props;

function getRoleClass(role: string | null): string {
  switch (role) {
    case 'super_admin': return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
    case 'admin': return 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200';
    case 'editor': return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
    default: return 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200';
  }
}

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}
---

<div class="users-island" data-page="users">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6">
    <h1 class="text-xl md:text-2xl font-bold">Users</h1>
    <p class="text-sm text-muted-foreground mt-1">Manage platform users and roles</p>
  </div>

  <!-- Filters -->
  <div class="bg-card border rounded-lg p-3 md:p-4 mb-4">
    <div class="flex flex-col md:flex-row gap-3">
      <Input
        type="text"
        id="search-input"
        placeholder="Search by name, email..."
        class="w-full px-3 py-2 border rounded-lg text-sm"
      />
      <div class="flex gap-2">
        <Select
          id="role-filter"
          options={[
            { value: "", label: "All Roles" },
            { value: "user", label: "User" },
            { value: "editor", label: "Editor" },
            { value: "admin", label: "Admin" },
            { value: "super_admin", label: "Super Admin" },
          ]}
        />
      </div>
    </div>
  </div>

  <!-- Users List -->
  <div class="bg-card border rounded-lg p-3 md:p-4">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-sm md:text-base">All Users</h3>
      <span id="users-count" class="text-xs text-muted-foreground">{users.length} users</span>
    </div>
    <div id="users-list" class="space-y-2">
      {users.length === 0 ? (
        <p class="text-center text-muted-foreground py-8">No users found</p>
      ) : (
        users.map((user) => (
          <div
            class="flex items-center justify-between p-3 border rounded text-sm hover:bg-muted/30"
            data-user-id={user.id}
            data-user-name={escapeHtml(user.name || '')}
            data-user-email={escapeHtml(user.email || '')}
            data-user-phone={escapeHtml(user.phone || '')}
            data-user-role={user.role}
          >
            <div class="min-w-0 flex-1">
              <p class="font-medium truncate">{user.name || 'Unnamed'}</p>
              <p class="text-xs text-muted-foreground truncate">{user.email || 'No email'}</p>
              <p class="text-xs text-muted-foreground truncate">{user.phone || 'No phone'}</p>
            </div>
            <div class="flex items-center gap-2 ml-2">
              <span class={`px-2 py-0.5 text-xs rounded-full ${getRoleClass(user.role)}`}>{user.role || 'user'}</span>
              <button data-action="edit-user" class="text-blue-500 hover:text-blue-600 text-xs px-2 py-1">Edit</button>
              <button data-action="delete-user" data-user-id={user.id} class="text-red-500 hover:text-red-600 text-xs px-2 py-1">Del</button>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<!-- Edit User Modal -->
<div id="edit-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-card border rounded-lg w-full max-w-md">
    <div class="p-4 border-b flex items-center justify-between">
      <h2 class="text-lg font-semibold">Edit User</h2>
      <Button id="close-modal" variant="ghost" size="sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </Button>
    </div>
    <form id="user-form" class="p-4 space-y-4">
      <input type="hidden" id="user-id" name="id" />
      <div>
        <label for="user-name" class="block text-sm font-medium mb-1">Name</label>
        <Input type="text" id="user-name" name="name" class="w-full" />
      </div>
      <div>
        <label for="user-email" class="block text-sm font-medium mb-1">Email</label>
        <Input type="email" id="user-email" name="email" class="w-full" />
      </div>
      <div>
        <label for="user-phone" class="block text-sm font-medium mb-1">Phone</label>
        <Input type="text" id="user-phone" name="phone" class="w-full" />
      </div>
      <div>
        <label for="user-role" class="block text-sm font-medium mb-1">Role</label>
        <Select
          id="user-role"
          name="role"
          options={[
            { value: "user", label: "User" },
            { value: "editor", label: "Editor" },
            { value: "admin", label: "Admin" },
            { value: "super_admin", label: "Super Admin" },
          ]}
        />
      </div>
      <div class="flex gap-2 justify-end">
        <Button type="button" id="cancel-btn" variant="outline">Cancel</Button>
        <Button type="submit" variant="primary">Save Changes</Button>
      </div>
    </form>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';

  let currentUserRole = 'user';

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.dataset.action;
    if (!action) return;
    const row = target.closest('[data-user-id]') as HTMLElement;

    if (action === 'edit-user' && row) {
      (document.getElementById('user-id') as HTMLInputElement).value = row.dataset.userId || '';
      (document.getElementById('user-name') as HTMLInputElement).value = row.dataset.userName || '';
      (document.getElementById('user-email') as HTMLInputElement).value = row.dataset.userEmail || '';
      (document.getElementById('user-phone') as HTMLInputElement).value = row.dataset.userPhone || '';
      (document.getElementById('user-role') as HTMLSelectElement).value = row.dataset.userRole || 'user';
      document.getElementById('edit-modal')?.classList.remove('hidden');
      document.getElementById('edit-modal')?.classList.add('flex');
    }

    if (action === 'delete-user' && row) {
      const id = row.dataset.userId || '';
      if (confirm('Delete this user and all their data? This action cannot be undone.')) {
        deleteUser(id);
      }
    }
  });

  async function deleteUser(id: string) {
    try {
      const result = await actions.admin.users.delete({ id });
      if (result.success) {
        toast.success('User deleted');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to delete');
      }
    } catch (err) {
      toast.error('Error deleting user');
    }
  }

  document.getElementById('close-modal')?.addEventListener('click', () => {
    document.getElementById('edit-modal')?.classList.add('hidden');
    document.getElementById('edit-modal')?.classList.remove('flex');
  });
  document.getElementById('cancel-btn')?.addEventListener('click', () => {
    document.getElementById('edit-modal')?.classList.add('hidden');
    document.getElementById('edit-modal')?.classList.remove('flex');
  });
  document.getElementById('edit-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('edit-modal')) {
      document.getElementById('edit-modal')?.classList.add('hidden');
      document.getElementById('edit-modal')?.classList.remove('flex');
    }
  });

  document.getElementById('user-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    const userId = formData.get('id') as string;
    try {
      const result = await actions.admin.users.update({
        id: userId,
        name: String(formData.get('name') || ''),
        email: String(formData.get('email') || '') || undefined,
        phone: String(formData.get('phone') || '') || undefined,
      });
      if (result.success) {
        toast.success('User updated');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to update');
      }
    } catch (err) {
      toast.error('Error updating user');
    }
  });
</script>