---
/**
 * OrdersIsland - Admin orders management island
 * Server-fetched orders → client-side filter + modal
 */
import { actions } from 'astro:actions';
import { Button } from '@/components/ui/button';
import { Textarea } from '@/components/ui/textarea';
import { Select } from '@/components/ui/select';

interface OrderData {
  id: string;
  servicePackageId: string | null;
  variantSnapshot: string | null;
  type: string | null;
  typeId: string | null;
  userId: string | null;
  amount: number | null;
  paymentMethod: string | null;
  status: string | null;
  planExpiresAt: number | null;
  paidDate: number | null;
  createdAt: number | null;
  adminNotes: string | null;
}

interface Props {
  orders: OrderData[];
}

const { orders } = Astro.props;

function getSnapshot(order: OrderData) {
  try {
    return order.variantSnapshot ? JSON.parse(order.variantSnapshot) : {};
  } catch {
    return {};
  }
}
---

<div class="orders-island" data-page="orders">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6">
    <h1 class="text-xl md:text-2xl font-bold">Orders</h1>
    <p class="text-sm text-muted-foreground mt-1">Manage subscription orders and payments</p>
  </div>

  <!-- Filter Tabs -->
  <div class="flex gap-2 mb-4 overflow-x-auto">
    <button class="filter-btn px-3 py-1.5 text-xs font-medium rounded-md bg-primary text-primary-foreground" data-filter="all">All</button>
    <button class="filter-btn px-3 py-1.5 text-xs font-medium rounded-md bg-secondary text-secondary-foreground" data-filter="unpaid">Unpaid</button>
    <button class="filter-btn px-3 py-1.5 text-xs font-medium rounded-md bg-secondary text-secondary-foreground" data-filter="paid">Paid</button>
  </div>

  <!-- Orders List -->
  <div class="bg-card border rounded-lg p-3 md:p-4">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-medium leading-snug mb-2">Orders</h3>
      <span id="orders-count" class="text-xs text-muted-foreground">{orders.length} orders</span>
    </div>
    <div id="orders-list" class="space-y-2">
      {orders.length === 0 ? (
        <p class="text-center text-muted-foreground py-8">No orders found</p>
      ) : (
        orders.map((order) => {
          const snapshot = getSnapshot(order);
          return (
            <div
              class="flex items-center justify-between p-3 border rounded text-sm cursor-pointer hover:bg-muted/50 order-item"
              data-action="show-order-details"
              data-id={order.id}
              data-status={order.status}
            >
              <div class="min-w-0 flex-1">
                <p class="font-medium truncate">#{order.id.slice(0, 8)}</p>
                <p class="text-xs text-muted-foreground truncate">
                  {snapshot.name || order.servicePackageId || 'N/A'} - ${(order.amount ?? 0) / 100}
                </p>
                <p class="text-xs text-muted-foreground">{order.typeId || order.userId || 'N/A'}</p>
              </div>
              <div class="flex items-center gap-2 ml-2">
                <span class={`px-2 py-0.5 text-xs rounded-full ${order.status === 'paid' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200'}`}>
                  {order.status || 'unknown'}
                </span>
              </div>
            </div>
          );
        })
      )}
    </div>
  </div>
</div>

<!-- Order Details Modal -->
<div id="order-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-card border rounded-lg w-full max-w-lg">
    <div class="p-4 border-b flex items-center justify-between">
      <h2 class="text-lg font-semibold leading-snug" id="modal-title">Order Details</h2>
      <Button id="close-modal" variant="ghost" size="sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </Button>
    </div>

    <form id="order-form" class="p-4 space-y-4">
      <input type="hidden" id="order-id" name="orderId" />

      <div>
        <label for="plan-type" class="block text-sm font-medium mb-1">Service Package</label>
        <Select
          id="plan-type"
          name="servicePackageId"
          options={[
            { value: "sp-business-basic", label: "Basic Monthly - $29" },
            { value: "sp-business-pro", label: "Pro Monthly - $59" },
            { value: "sp-business-max", label: "Max Monthly - $89" }
          ]}
        />
      </div>

      <div>
        <label for="admin-notes" class="block text-sm font-medium mb-1">Admin Notes</label>
        <Textarea id="admin-notes" name="adminNotes" rows={3} placeholder="Discount applied, special arrangement, etc." />
      </div>

      <!-- Info Display -->
      <div class="bg-muted/50 rounded-lg p-3 text-sm space-y-1">
        <div class="flex justify-between">
          <span class="text-muted-foreground">Order ID:</span>
          <span id="modal-order-id" class="font-mono text-xs"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted-foreground">Business:</span>
          <span id="modal-business-title"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted-foreground">Created:</span>
          <span id="modal-created-date"></span>
        </div>
        <div class="flex justify-between">
          <span class="text-muted-foreground">Paid Date:</span>
          <span id="modal-paid-date"></span>
        </div>
      </div>
    </form>

    <div class="p-4 border-t flex gap-2 justify-between">
      <Button id="delete-order-btn" variant="destructive" size="sm">Delete</Button>
      <div class="flex gap-2">
        <Button id="cancel-modal-btn" variant="secondary" size="sm">Cancel</Button>
        <Button id="reject-order-btn" variant="warning" size="sm" class="hidden">Reject</Button>
        <Button id="confirm-order-btn" variant="success" size="sm" class="hidden">Confirm Payment</Button>
        <Button id="save-order-btn" variant="primary" size="sm">Save Changes</Button>
      </div>
    </div>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';

  let selectedOrderId = '';
  let currentOrderData: any = null;

  function filterOrders(filter: string) {
    const items = document.querySelectorAll('.order-item');
    let visible = 0;
    items.forEach(item => {
      const status = (item as HTMLElement).dataset.status;
      const show = filter === 'all' || status === filter;
      (item as HTMLElement).style.display = show ? '' : 'none';
      if (show) visible++;
    });
    const countEl = document.getElementById('orders-count');
    if (countEl) countEl.textContent = `${visible} order${visible !== 1 ? 's' : ''}`;
  }

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => {
        b.classList.remove('bg-primary', 'text-primary-foreground');
        b.classList.add('bg-secondary', 'text-secondary-foreground');
      });
      btn.classList.remove('bg-secondary', 'text-secondary-foreground');
      btn.classList.add('bg-primary', 'text-primary-foreground');
      filterOrders((btn as HTMLElement).dataset.filter || 'all');
    });
  });

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (!action) return;

    if (action === 'show-order-details') {
      const row = target.closest('[data-action]') as HTMLElement;
      const id = row?.dataset.id;
      if (id) showOrderDetails(id);
    }
  });

  async function showOrderDetails(id: string) {
    selectedOrderId = id;
    const modal = document.getElementById('order-modal');
    const form = document.getElementById('order-form') as HTMLFormElement;
    if (!modal || !form) return;

    try {
      const result = await actions.admin.subscriptions.getById({ id });
      if (!result.success || !result.data) {
        toast.error('Failed to load order details');
        return;
      }

      const order = result.data;
      currentOrderData = order;
      const snapshot = order.variantSnapshot ? JSON.parse(order.variantSnapshot) : {};
      const planName = snapshot.name || order.servicePackageId || 'N/A';

      (document.getElementById('order-id') as HTMLInputElement).value = order.id;
      (document.getElementById('plan-type') as HTMLSelectElement).value = order.servicePackageId || '';
      (document.getElementById('admin-notes') as HTMLTextAreaElement).value = order.adminNotes || '';
      (document.getElementById('modal-order-id') as HTMLElement).textContent = order.id.slice(0, 12) + '...';
      (document.getElementById('modal-business-title') as HTMLElement).textContent = planName;
      (document.getElementById('modal-created-date') as HTMLElement).textContent = order.createdAt
        ? new Date(order.createdAt * 1000).toLocaleDateString()
        : 'N/A';
      (document.getElementById('modal-paid-date') as HTMLElement).textContent = order.paidDate
        ? new Date(order.paidDate * 1000).toLocaleDateString()
        : 'Not paid';

      modal.classList.remove('hidden');
      modal.classList.add('flex');
    } catch (err) {
      console.error('Error loading order:', err);
      toast.error('Error loading order');
    }
  }

  // Modal controls
  document.getElementById('close-modal')?.addEventListener('click', () => {
    document.getElementById('order-modal')?.classList.add('hidden', 'items-center');
    document.getElementById('order-modal')?.classList.remove('flex');
  });
  document.getElementById('cancel-modal-btn')?.addEventListener('click', () => {
    document.getElementById('order-modal')?.classList.add('hidden', 'items-center');
    document.getElementById('order-modal')?.classList.remove('flex');
  });
  document.getElementById('order-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('order-modal')) {
      document.getElementById('order-modal')?.classList.add('hidden', 'items-center');
      document.getElementById('order-modal')?.classList.remove('flex');
    }
  });

  // Save changes
  document.getElementById('save-order-btn')?.addEventListener('click', async () => {
    if (!selectedOrderId) return;
    try {
      const result = await actions.admin.subscriptions.updateStatus({
        id: selectedOrderId,
        status: 'paid',
      });
      if (result.success) {
        toast.success('Order updated');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to update');
      }
    } catch (err) {
      toast.error('Error saving order');
    }
  });

  // Delete
  document.getElementById('delete-order-btn')?.addEventListener('click', async () => {
    if (!selectedOrderId || !confirm('Delete this order?')) return;
    try {
      const result = await actions.admin.subscriptions.delete({ id: selectedOrderId });
      if (result.success) {
        toast.success('Order deleted');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to delete');
      }
    } catch (err) {
      toast.error('Error deleting order');
    }
  });

  // Confirm payment
  document.getElementById('confirm-order-btn')?.addEventListener('click', async () => {
    if (!selectedOrderId) return;
    try {
      const result = await actions.admin.subscriptions.updateStatus({
        id: selectedOrderId,
        status: 'paid',
      });
      if (result.success) {
        toast.success('Payment confirmed');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to confirm');
      }
    } catch (err) {
      toast.error('Error confirming payment');
    }
  });
</script>