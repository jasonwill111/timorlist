---
/**
 * PublicSectorsIsland - Admin public sectors management island
 */
import { actions } from 'astro:actions';
import { Button } from '@/components/fulldev/button';
import { Input } from '@/components/fulldev/input';
import { Textarea } from '@/components/fulldev/textarea';

interface PublicSectorData {
  id: string;
  title: string | null;
  slug: string | null;
  email: string | null;
  contactNumber: string | null;
  status: string | null;
  aboutUs: string | null;
  latestUpdate: string | null;
  createdAt: number | null;
  updatedAt: number | null;
}

interface Props {
  publicSectors: PublicSectorData[];
}

const { publicSectors } = Astro.props;

function getStatusClass(status: string | null): string {
  if (status === 'active') return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (status === 'draft') return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';
  if (status === 'deleted') return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
  return 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200';
}

function capitalizeFirst(str: string | null | undefined): string {
  if (!str) return '-';
  return str.charAt(0).toUpperCase() + str.slice(1);
}
---

<div class="public-sectors-island" data-page="public-sectors">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6 flex items-start justify-between gap-2">
    <div>
      <h1 class="text-lg md:text-2xl font-bold">All Public Sectors</h1>
      <p class="text-sm text-muted-foreground mt-1">Manage all public sector listings</p>
    </div>
    <Button id="add-ps-btn" data-action="modal-add" class="text-xs px-2 py-1 h-7 flex-shrink-0 whitespace-nowrap md:text-sm md:px-4 md:h-9">+ Add Public Sector</Button>
  </div>

  <!-- Filters -->
  <div class="bg-card border rounded-lg p-3 md:p-4 mb-4">
    <div class="flex flex-col md:flex-row gap-3">
      <Input
        type="text"
        id="search-input"
        placeholder="Search by name or slug..."
        class="w-full px-3 py-2 border rounded-lg text-sm"
      />
      <div class="flex gap-2">
        <select id="status-filter" class="px-3 py-2 border rounded-lg text-sm bg-background">
          <option value="">All Status</option>
          <option value="draft">Draft</option>
          <option value="active">Active</option>
          <option value="deleted">Deleted</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Public Sectors List -->
  <div class="bg-card border rounded-lg p-3 md:p-4">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-sm md:text-base">All Public Sectors</h3>
      <span id="public-sectors-count" class="text-xs text-muted-foreground">{publicSectors.length} public sectors</span>
    </div>
    <div id="public-sectors-list" class="space-y-2">
      {publicSectors.length === 0 ? (
        <p class="text-center text-muted-foreground py-8">No public sectors yet</p>
      ) : (
        publicSectors.map((ps) => (
          <div class="flex items-center justify-between p-2 md:p-3 border rounded text-sm hover:bg-muted/30">
            <div class="min-w-0 flex-1">
              <p class="font-medium truncate">{ps.title || 'Untitled'}</p>
              <p class="text-xs text-muted-foreground">/{ps.slug || 'no-slug'}</p>
            </div>
            <div class="flex items-center gap-2 ml-2">
              <button
                class="text-xs px-2 py-1 border rounded hover:bg-muted"
                data-action="edit"
                data-id={ps.id}
              >Edit</button>
              <span class={`px-2 py-0.5 text-xs rounded-full ${getStatusClass(ps.status)}`}>{capitalizeFirst(ps.status)}</span>
              <select
                class="text-xs border rounded px-1 py-0.5 bg-background"
                data-action="status-update"
                data-id={ps.id}
              >
                <option value="draft" selected={ps.status === 'draft'}>Draft</option>
                <option value="active" selected={ps.status === 'active'}>Active</option>
                <option value="deleted" selected={ps.status === 'deleted'}>Deleted</option>
              </select>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<!-- Create / Edit Public Sector Modal -->
<div id="ps-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-card border rounded-lg w-full max-w-2xl max-h-[90vh] overflow-y-auto">
    <div class="p-4 border-b flex items-center justify-between">
      <h2 class="text-lg font-semibold leading-snug" id="ps-modal-title">Create Public Sector</h2>
      <Button id="close-ps-modal" variant="ghost" size="sm" class="p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </Button>
    </div>
    <form id="ps-form" class="p-4 space-y-4">
      <input type="hidden" id="ps-id" name="id" />
      <div>
        <label for="ps-title" class="block text-sm font-medium mb-1">Public Sector Name *</label>
        <Input type="text" id="ps-title" name="title" required class="w-full px-3 py-2 border rounded-md text-sm" />
      </div>
      <div>
        <label for="ps-slug" class="block text-sm font-medium mb-1">Slug *</label>
        <Input type="text" id="ps-slug" name="slug" required class="w-full px-3 py-2 border rounded-md text-sm" />
      </div>
      <div>
        <label for="ps-email" class="block text-sm font-medium mb-1">Email</label>
        <Input type="email" id="ps-email" name="email" class="w-full px-3 py-2 border rounded-md text-sm" />
      </div>
      <div>
        <label for="ps-phone" class="block text-sm font-medium mb-1">Phone</label>
        <Input type="tel" id="ps-phone" name="contactNumber" class="w-full px-3 py-2 border rounded-md text-sm" />
      </div>
      <div>
        <label for="ps-about" class="block text-sm font-medium mb-1">About Us</label>
        <Textarea id="ps-about" name="aboutUs" rows={3} class="w-full" />
      </div>
      <div>
        <label for="ps-updates" class="block text-sm font-medium mb-1">Latest Updates</label>
        <Textarea id="ps-updates" name="latestUpdate" rows={3} class="w-full" />
      </div>
      <div class="flex gap-2 justify-end">
        <Button type="button" id="cancel-ps-btn" variant="outline">Cancel</Button>
        <Button type="submit">Save</Button>
      </div>
    </form>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';

  // Auto-generate slug from title
  document.getElementById('ps-title')?.addEventListener('input', (e) => {
    const title = (e.target as HTMLInputElement).value;
    const slugInput = document.getElementById('ps-slug') as HTMLInputElement;
    if (slugInput && !slugInput.dataset.userModified) {
      slugInput.value = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    }
  });
  document.getElementById('ps-slug')?.addEventListener('input', () => {
    (document.getElementById('ps-slug') as HTMLInputElement).dataset.userModified = 'true';
  });

  // Modal controls
  document.getElementById('close-ps-modal')?.addEventListener('click', () => {
    document.getElementById('ps-modal')?.classList.add('hidden');
    document.getElementById('ps-modal')?.classList.remove('flex');
  });
  document.getElementById('cancel-ps-btn')?.addEventListener('click', () => {
    document.getElementById('ps-modal')?.classList.add('hidden');
    document.getElementById('ps-modal')?.classList.remove('flex');
  });
  document.getElementById('ps-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('ps-modal')) {
      document.getElementById('ps-modal')?.classList.add('hidden');
      document.getElementById('ps-modal')?.classList.remove('flex');
    }
  });

  // Click handler for add/edit buttons
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (!action) return;

    if (action === 'modal-add') {
      (document.getElementById('ps-id') as HTMLInputElement).value = '';
      (document.getElementById('ps-title') as HTMLInputElement).value = '';
      (document.getElementById('ps-slug') as HTMLInputElement).value = '';
      (document.getElementById('ps-email') as HTMLInputElement).value = '';
      (document.getElementById('ps-phone') as HTMLInputElement).value = '';
      (document.getElementById('ps-about') as HTMLTextAreaElement).value = '';
      (document.getElementById('ps-updates') as HTMLTextAreaElement).value = '';
      document.getElementById('ps-modal-title').textContent = 'Create Public Sector';
      document.getElementById('ps-modal')?.classList.remove('hidden');
      document.getElementById('ps-modal')?.classList.add('flex');
    }

    if (action === 'edit') {
      const id = target.closest('[data-action]')?.getAttribute('data-id');
      if (!id) return;
      const ps = (window as any).__publicSectorsData?.find((p: any) => p.id === id);
      if (!ps) return;
      (document.getElementById('ps-id') as HTMLInputElement).value = ps.id;
      (document.getElementById('ps-title') as HTMLInputElement).value = ps.title || '';
      (document.getElementById('ps-slug') as HTMLInputElement).value = ps.slug || '';
      (document.getElementById('ps-email') as HTMLInputElement).value = ps.email || '';
      (document.getElementById('ps-phone') as HTMLInputElement).value = ps.contactNumber || '';
      (document.getElementById('ps-about') as HTMLTextAreaElement).value = ps.aboutUs || '';
      (document.getElementById('ps-updates') as HTMLTextAreaElement).value = ps.latestUpdate || '';
      document.getElementById('ps-modal-title').textContent = 'Edit Public Sector';
      document.getElementById('ps-modal')?.classList.remove('hidden');
      document.getElementById('ps-modal')?.classList.add('flex');
    }
  });

  // Store data for edit lookup
  (window as any).__publicSectorsData = JSON.parse('{JSON.stringify(publicSectors)}');

  // Status update
  document.addEventListener('change', async (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (action !== 'status-update') return;
    const select = target.closest('select') as HTMLSelectElement;
    if (!select) return;
    const id = select.dataset.id;
    const status = select.value;
    if (!id) return;
    try {
      const result = await actions.admin.publicSectors.updateStatus({ id, status: status as any });
      if (result.success) {
        toast.success('Status updated');
      } else {
        toast.error('Failed to update status');
        window.location.reload();
      }
    } catch (err) {
      toast.error('Error updating status');
    }
  });

  // Form submit
  document.getElementById('ps-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    const id = formData.get('id') as string;
    const isEdit = !!id;

    try {
      const result = await (isEdit
        ? actions.admin.publicSectors.update({
            id,
            title: String(formData.get('title') || ''),
            slug: String(formData.get('slug') || ''),
            email: String(formData.get('email') || ''),
            contactNumber: String(formData.get('contactNumber') || ''),
            aboutUs: String(formData.get('aboutUs') || ''),
            latestUpdate: String(formData.get('latestUpdate') || ''),
          } as any)
        : actions.admin.publicSectors.create({
            title: String(formData.get('title') || ''),
            slug: String(formData.get('slug') || ''),
            email: String(formData.get('email') || ''),
            contactNumber: String(formData.get('contactNumber') || ''),
            aboutUs: String(formData.get('aboutUs') || ''),
            latestUpdate: String(formData.get('latestUpdate') || ''),
          } as any));

      if (result.success) {
        toast.success(isEdit ? 'Public Sector updated' : 'Public Sector created');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to save');
      }
    } catch (err) {
      toast.error('Error saving public sector');
    }
  });
</script>