---
/**
 * BusinessesIsland - Admin businesses management island
 */
import { actions } from 'astro:actions';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Textarea } from '@/components/ui/textarea';

interface BusinessData {
  id: string;
  title: string | null;
  slug: string | null;
  email: string | null;
  contactNumber: string | null;
  status: string | null;
  planExpiresAt: number | null;
  createdAt: number | null;
  updatedAt: number | null;
}

interface Props {
  businesses: BusinessData[];
}

const { businesses } = Astro.props;

function escapeHtml(str: string): string {
  return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
}

function getStatusClass(status: string | null): string {
  if (status === 'live' || status === 'paid') return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (status === 'draft') return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';
  if (status === 'expired') return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
  return 'bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200';
}
---

<div class="businesses-island" data-page="businesses">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6">
    <h1 class="text-xl md:text-2xl font-bold">Businesses</h1>
    <p class="text-sm text-muted-foreground mt-1">Manage all business listings</p>
  </div>

  <!-- Filters -->
  <div class="bg-card border rounded-lg p-3 md:p-4 mb-4">
    <div class="flex flex-col md:flex-row gap-3">
      <Input
        type="text"
        id="search-input"
        placeholder="Search by name or slug..."
        class="w-full px-3 py-2 border rounded-lg text-sm"
      />
      <div class="flex gap-2">
        <select id="status-filter" class="px-3 py-2 border rounded-lg text-sm bg-background">
          <option value="">All Statuses</option>
          <option value="draft">Draft</option>
          <option value="live">Live</option>
          <option value="paid">Paid</option>
          <option value="expired">Expired</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Businesses List -->
  <div class="bg-card border rounded-lg p-3 md:p-4">
    <div class="flex items-center justify-between mb-4">
      <h3 class="font-semibold text-sm md:text-base">All Businesses</h3>
      <span id="businesses-count" class="text-xs text-muted-foreground">{businesses.length} businesses</span>
    </div>
    <div id="businesses-list" class="space-y-2">
      {businesses.length === 0 ? (
        <p class="text-center text-muted-foreground py-8">No businesses yet</p>
      ) : (
        businesses.map((biz) => (
          <div class="flex items-center justify-between p-2 md:p-3 border rounded text-sm hover:bg-muted/30">
            <div class="min-w-0 flex-1">
              <p class="font-medium truncate">{biz.title || 'Untitled'}</p>
              <p class="text-xs text-muted-foreground">/{biz.slug || 'no-slug'}</p>
            </div>
            <div class="flex items-center gap-2 ml-2">
              <button
                class="text-xs px-2 py-1 border rounded hover:bg-muted"
                data-action="edit"
                data-id={biz.id}
              >Edit</button>
              <span class={`px-2 py-0.5 text-xs rounded-full ${getStatusClass(biz.status)}`}>{biz.status || 'unknown'}</span>
              <select
                class="text-xs border rounded px-1 py-0.5 bg-background"
                data-action="status-update"
                data-id={biz.id}
              >
                <option value="draft" selected={biz.status === 'draft'}>Draft</option>
                <option value="live" selected={biz.status === 'live'}>Live</option>
                <option value="paid" selected={biz.status === 'paid'}>Paid</option>
                <option value="expired" selected={biz.status === 'expired'}>Expired</option>
              </select>
            </div>
          </div>
        ))
      )}
    </div>
  </div>
</div>

<!-- Edit Business Modal -->
<div id="business-modal" class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4">
  <div class="bg-card border rounded-lg w-full max-w-lg max-h-[90vh] overflow-y-auto">
    <div class="p-4 border-b flex items-center justify-between sticky top-0 bg-card">
      <h2 class="text-lg font-semibold">Edit Business</h2>
      <Button id="close-biz-modal" variant="ghost" size="sm">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </Button>
    </div>
    <form id="business-form" class="p-4 space-y-4">
      <input type="hidden" id="biz-id" name="id" />
      <div>
        <label for="biz-title" class="block text-sm font-medium mb-1">Business Name</label>
        <Input type="text" id="biz-title" name="title" class="w-full" />
      </div>
      <div>
        <label for="biz-slug" class="block text-sm font-medium mb-1">Slug</label>
        <Input type="text" id="biz-slug" name="slug" class="w-full" />
      </div>
      <div>
        <label for="biz-about" class="block text-sm font-medium mb-1">About</label>
        <Textarea id="biz-about" name="aboutUs" rows={3} class="w-full" />
      </div>
      <div>
        <label for="biz-updates" class="block text-sm font-medium mb-1">Latest Updates</label>
        <Textarea id="biz-updates" name="latestUpdates" rows={3} class="w-full" />
      </div>
      <div class="flex gap-2 justify-end">
        <Button type="button" id="cancel-biz-btn" variant="outline">Cancel</Button>
        <Button type="submit" variant="primary">Save Changes</Button>
      </div>
    </form>
  </div>
</div>

<script>
  import { toast } from '@/lib/toast';

  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (!action) return;

    if (action === 'edit') {
      const id = target.closest('[data-action]')?.getAttribute('data-id');
      if (id) {
        (document.getElementById('biz-id') as HTMLInputElement).value = id;
        document.getElementById('business-modal')?.classList.remove('hidden');
        document.getElementById('business-modal')?.classList.add('flex');
      }
    }
  });

  document.addEventListener('change', async (e) => {
    const target = e.target as HTMLElement;
    const action = target.closest('[data-action]')?.getAttribute('data-action');
    if (action !== 'status-update') return;

    const select = target.closest('select') as HTMLSelectElement;
    if (!select) return;
    const id = select.dataset.id;
    const status = select.value;
    if (!id) return;

    try {
      const result = await actions.admin.businesses.updateStatus({ id, status: status as any });
      if (result.success) {
        toast.success('Status updated');
      } else {
        toast.error('Failed to update status');
        window.location.reload();
      }
    } catch (err) {
      toast.error('Error updating status');
    }
  });

  document.getElementById('close-biz-modal')?.addEventListener('click', () => {
    document.getElementById('business-modal')?.classList.add('hidden');
    document.getElementById('business-modal')?.classList.remove('flex');
  });
  document.getElementById('cancel-biz-btn')?.addEventListener('click', () => {
    document.getElementById('business-modal')?.classList.add('hidden');
    document.getElementById('business-modal')?.classList.remove('flex');
  });
  document.getElementById('business-modal')?.addEventListener('click', (e) => {
    if (e.target === document.getElementById('business-modal')) {
      document.getElementById('business-modal')?.classList.add('hidden');
      document.getElementById('business-modal')?.classList.remove('flex');
    }
  });

  document.getElementById('business-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const formData = new FormData(e.target as HTMLFormElement);
    const id = formData.get('id') as string;
    try {
      const result = await actions.admin.businesses.update({
        id,
        title: String(formData.get('title') || ''),
        slug: String(formData.get('slug') || ''),
        aboutUs: String(formData.get('aboutUs') || ''),
        latestUpdates: String(formData.get('latestUpdates') || ''),
      } as any);
      if (result.success) {
        toast.success('Business updated');
        window.location.reload();
      } else {
        toast.error(result.error?.message || 'Failed to update');
      }
    } catch (err) {
      toast.error('Error updating business');
    }
  });
</script>