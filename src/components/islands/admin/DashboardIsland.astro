---
/**
 * DashboardIsland - Admin dashboard island component
 * Replaces inline <script> from pages/admin/index.astro
 * All rendering uses safe DOM APIs (textContent, classList, value) — zero innerHTML
 */
import { Button } from '@/components/fulldev/button';

interface MonthlyData {
  month: string;
  revenue: number;
  subscriptions: number;
}

interface DashboardStats {
  totalUsers: number;
  totalBusinesses: number;
  totalNonProfits: number;
  totalProducts: number;
  mtd?: {
    revenue: number;
    newSubscriptions: number;
    newUsers: number;
  };
  expiringSoon: number;
  monthly: MonthlyData[];
}

interface Subscription {
  id: string;
  planSlug: string;
  servicePackageId: string;
  amount: number;
  status: string;
  planExpiresAt: number | null;
}

interface Props {
  stats: DashboardStats;
  subscriptions: Subscription[];
}

const { stats, subscriptions } = Astro.props;

function escapeAttr(str: string): string {
  return String(str ?? '')
    .replace(/&/g, '&amp;')
    .replace(/"/g, '&quot;');
}
---

<!-- Pass data via JSON script tag (server-rendered, safe) -->
<script id="dashboard-stats" type="application/json" set:html={JSON.stringify(stats)}></script>
<script id="dashboard-subs" type="application/json" set:html={JSON.stringify(subscriptions)}></script>

<div class="container py-4 px-2 md:py-6 max-w-7xl">
  <!-- Page Header -->
  <div class="mb-4 md:mb-6">
    <h1 class="text-3xl font-bold leading-tight">Dashboard</h1>
    <p class="text-xs md:text-sm text-muted-foreground">Overview of your platform</p>
  </div>

  <!-- Stats Cards - Total Counts -->
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 md:gap-4 mb-4">
    <a href="/admin/users" class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/50 border-blue-200 dark:border-blue-800 rounded-xl p-3 border hover:shadow-md transition-shadow cursor-pointer">
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-bold text-blue-700 dark:text-blue-300" id="stat-users">-</p>
        <p class="text-xs text-blue-600 dark:text-blue-400">Users</p>
      </div>
    </a>
    <a href="/admin/businesses?type=business" class="bg-gradient-to-br from-emerald-50 to-emerald-100 dark:from-emerald-950/50 dark:to-emerald-900/50 border-emerald-200 dark:border-emerald-800 rounded-xl p-3 border hover:shadow-md transition-shadow cursor-pointer">
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-bold text-emerald-700 dark:text-emerald-300" id="stat-businesses">-</p>
        <p class="text-xs text-emerald-600 dark:text-emerald-400">Businesses</p>
      </div>
    </a>
    <a href="/admin/businesses?type=nonprofit" class="bg-gradient-to-br from-teal-50 to-teal-100 dark:from-teal-950/50 dark:to-teal-900/50 border-teal-200 dark:border-teal-800 rounded-xl p-3 border hover:shadow-md transition-shadow cursor-pointer">
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-bold text-teal-700 dark:text-teal-300" id="stat-nonprofits">-</p>
        <p class="text-xs text-teal-600 dark:text-teal-400">Non-Profits</p>
      </div>
    </a>
    <a href="/admin/skus" class="bg-gradient-to-br from-rose-50 to-rose-100 dark:from-rose-950/50 dark:to-rose-900/50 border-rose-200 dark:border-rose-800 rounded-xl p-3 border hover:shadow-md transition-shadow cursor-pointer">
      <div class="text-center">
        <p class="text-2xl md:text-3xl font-bold text-rose-700 dark:text-rose-300" id="stat-products">-</p>
        <p class="text-xs text-rose-600 dark:text-rose-400">Products</p>
      </div>
    </a>
  </div>

  <!-- MTD Stats Row -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4 mb-6">
    <div class="bg-gradient-to-br from-amber-50 to-amber-100 dark:from-amber-950/50 dark:to-amber-900/50 border-amber-200 dark:border-amber-800 rounded-xl p-3 md:p-4 border">
      <div class="flex items-center gap-2 md:gap-3">
        <div class="w-8 h-8 md:w-10 md:h-10 bg-amber-500 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xl md:text-2xl font-bold text-amber-700 dark:text-amber-300 truncate" id="mtd-revenue">$0</p>
          <p class="text-xs md:text-xs text-amber-600 dark:text-amber-400">MTD Revenue</p>
        </div>
      </div>
    </div>
    <div class="bg-gradient-to-br from-purple-50 to-purple-100 dark:from-purple-950/50 dark:to-purple-900/50 border-purple-200 dark:border-purple-800 rounded-xl p-3 md:p-4 border">
      <div class="flex items-center gap-2 md:gap-3">
        <div class="w-8 h-8 md:w-10 md:h-10 bg-purple-500 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xl md:text-2xl font-bold text-purple-700 dark:text-purple-300" id="mtd-subs">0</p>
          <p class="text-xs md:text-xs text-purple-600 dark:text-purple-400">MTD Subs</p>
        </div>
      </div>
    </div>
    <div class="bg-gradient-to-br from-blue-50 to-blue-100 dark:from-blue-950/50 dark:to-blue-900/50 border-blue-200 dark:border-blue-800 rounded-xl p-3 md:p-4 border">
      <div class="flex items-center gap-2 md:gap-3">
        <div class="w-8 h-8 md:w-10 md:h-10 bg-blue-500 rounded-lg flex items-center justify-center flex-shrink-0">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xl md:text-2xl font-bold text-blue-700 dark:text-blue-300" id="mtd-users">0</p>
          <p class="text-xs md:text-xs text-blue-600 dark:text-blue-400">MTD Users</p>
        </div>
      </div>
    </div>
    <a href="/admin/subscriptions?filter=expiring" class="bg-gradient-to-br from-red-50 to-red-100 dark:from-red-950/50 dark:to-red-900/50 border-red-200 dark:border-red-800 rounded-xl p-3 md:p-4 border hover:shadow-md transition-shadow cursor-pointer">
      <div class="flex items-center gap-2 md:gap-3">
        <div class="w-8 h-8 md:w-10 md:h-10 bg-red-500 rounded-lg flex items-center justify-center animate-pulse flex-shrink-0">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
          </svg>
        </div>
        <div class="min-w-0">
          <p class="text-xl md:text-2xl font-bold text-red-700 dark:text-red-300" id="stat-expiring">0</p>
          <p class="text-xs md:text-xs text-red-600 dark:text-red-400">Expiring</p>
        </div>
      </div>
    </a>
  </div>

  <!-- Charts Section -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
    <div class="bg-card border rounded-xl p-3 md:p-4">
      <h3 class="text-lg font-medium leading-snug mb-2">Revenue (6 Months)</h3>
      <div id="revenue-chart" class="flex items-end justify-between gap-1 h-24 md:h-32"></div>
    </div>
    <div class="bg-card border rounded-xl p-3 md:p-4">
      <h3 class="text-lg font-medium leading-snug mb-2">New Subscriptions</h3>
      <div id="subscriptions-chart" class="h-24 md:h-32 relative">
        <svg class="w-full h-full" id="subscriptions-svg"></svg>
      </div>
    </div>
  </div>

  <div class="bg-card border rounded-xl p-3 md:p-4 mb-6">
    <h3 class="text-lg font-medium leading-snug mb-2">New Users (6 Months)</h3>
    <div id="users-chart" class="h-24 md:h-32 relative">
      <svg class="w-full h-full" id="users-svg"></svg>
    </div>
  </div>

  <!-- Recent Subscriptions + Quick Actions -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <div class="bg-card border rounded-xl p-3 md:p-4">
      <div class="flex items-center justify-between mb-3 md:mb-4">
        <h3 class="text-lg font-medium leading-snug">Recent Subscriptions</h3>
        <a href="/admin/subscriptions" class="text-xs text-primary hover:underline">View All</a>
      </div>
      <div id="orders-list" class="space-y-2">
        <p class="text-center text-muted-foreground py-6 md:py-8 text-sm">Loading...</p>
      </div>
    </div>

    <div class="bg-card border rounded-xl p-3 md:p-4">
      <h3 class="text-lg font-medium leading-snug mb-3 md:mb-4">Quick Actions</h3>
      <div class="grid grid-cols-2 gap-2">
        <a href="/admin/businesses" class="flex items-center gap-2 p-2 md:p-3 rounded-lg bg-blue-50 dark:bg-blue-950/30 hover:bg-blue-100 dark:hover:bg-blue-900/50 transition-colors">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-blue-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
          </svg>
          <span class="text-xs md:text-sm font-medium truncate">Add Business</span>
        </a>
        <a href="/admin/skus" class="flex items-center gap-2 p-2 md:p-3 rounded-lg bg-emerald-50 dark:bg-emerald-950/30 hover:bg-emerald-100 dark:hover:bg-emerald-900/50 transition-colors">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
          </svg>
          <span class="text-xs md:text-sm font-medium truncate">Add Product</span>
        </a>
        <a href="/admin/blogs" class="flex items-center gap-2 p-2 md:p-3 rounded-lg bg-purple-50 dark:bg-purple-950/30 hover:bg-purple-100 dark:hover:bg-purple-900/50 transition-colors">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-purple-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828l3.586 3.586a2 2 0 010 2.828l-3.586 3.586a2 2 0 01-2.828 0l-3.586-3.586a2 2 0 010-2.828L9.414 5.414A2 2 0 0112 3.586z"/>
          </svg>
          <span class="text-xs md:text-sm font-medium truncate">Write Blog</span>
        </a>
        <a href="/admin/media" class="flex items-center gap-2 p-2 md:p-3 rounded-lg bg-amber-50 dark:bg-amber-950/30 hover:bg-amber-100 dark:hover:bg-amber-900/50 transition-colors">
          <svg class="w-4 h-4 md:w-5 md:h-5 text-amber-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          <span class="text-xs md:text-sm font-medium truncate">Upload Media</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  import DOMPurify from 'dompurify';

  const sanitize = (html: string) => DOMPurify.sanitize(html, { USE_PROFILES: { html: true } });

  const toNum = (val: unknown): number => typeof val === 'number' ? val : 0;

  // Parse server-rendered JSON
  const statsEl = document.getElementById('dashboard-stats');
  const subsEl = document.getElementById('dashboard-subs');
  const stats: DashboardStats = JSON.parse(statsEl?.textContent || '{}');
  const subs: Subscription[] = JSON.parse(subsEl?.textContent || '[]');

  // Render stat numbers (safe — textContent only)
  const setText = (id: string, value: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  };

  setText('stat-users', String(toNum(stats.totalUsers)));
  setText('stat-businesses', String(toNum(stats.totalBusinesses)));
  setText('stat-nonprofits', String(toNum(stats.totalNonProfits)));
  setText('stat-products', String(toNum(stats.totalProducts)));

  if (stats.mtd) {
    setText('mtd-revenue', '$' + String(toNum(stats.mtd.revenue)));
    setText('mtd-subs', String(toNum(stats.mtd.newSubscriptions)));
    setText('mtd-users', String(toNum(stats.mtd.newUsers)));
  }

  setText('stat-expiring', String(toNum(stats.expiringSoon)));

  // Render revenue bar chart (uses DOMPurify)
  const chartEl = document.getElementById('revenue-chart');
  if (chartEl && stats.monthly?.length) {
    const maxRevenue = Math.max(...stats.monthly.map(m => m.revenue), 1);
    const chartHeight = 120;

    const bars = stats.monthly.map(m => {
      const heightPercent = (m.revenue / maxRevenue) * 100;
      const heightPx = Math.max((heightPercent / 100) * chartHeight, 4);
      const safeMonth = String(m.month ?? '').replace(/</g, '&lt;').replace(/>/g, '&gt;');
      return `<div class="flex-1 flex flex-col items-center gap-1">
        <div class="w-full bg-gradient-to-t from-amber-400 to-amber-300 rounded-t transition-all hover:opacity-80 cursor-help relative group" style="height: ${heightPx}px">
          <div class="absolute -top-8 left-1/2 -translate-x-1/2 bg-gray-800 text-white text-xs px-2 py-1 rounded opacity-0 group-hover:opacity-100 whitespace-nowrap z-10">
            $${m.revenue}
          </div>
        </div>
        <span class="text-xs text-muted-foreground">${safeMonth}</span>
      </div>`;
    }).join('');
    chartEl.innerHTML = sanitize(bars);
  }

  // Render SVG line chart helper
  function renderLineChart(svgId: string, data: number[], labels: string[], color: string) {
    const svg = document.getElementById(svgId) as unknown as SVGSVGElement;
    if (!svg || !data.length) return;

    const width = svg.clientWidth || 400;
    const height = svg.clientHeight || 128;
    const padding = { top: 10, right: 10, bottom: 30, left: 10 };
    const chartWidth = width - padding.left - padding.right;
    const chartHeight = height - padding.top - padding.bottom;

    const maxVal = Math.max(...data, 1);
    const minVal = 0;
    const range = maxVal - minVal || 1;

    const points = data.map((val, i) => ({
      x: padding.left + (i / (data.length - 1)) * chartWidth,
      y: padding.top + chartHeight - ((val - minVal) / range) * chartHeight
    }));

    const pathD = points.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
    const areaD = pathD + ` L ${points[points.length - 1].x} ${height - padding.bottom} L ${padding.left} ${height - padding.bottom} Z`;
    const safeLabels = labels.map(l => String(l ?? '').replace(/</g, '&lt;').replace(/>/g, '&gt;'));

    const circles = points.map((p, i) => `
      <circle cx="${p.x}" cy="${p.y}" r="4" fill="${color}">
        <title>${safeLabels[i]}: ${data[i]}</title>
      </circle>
      <text x="${p.x}" y="${height - 8}" text-anchor="middle" class="fill-muted-foreground text-xs">${safeLabels[i]}</text>
    `).join('');

    const svgContent = `<defs>
      <linearGradient id="${svgId}-gradient" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="${color}" stop-opacity="0.3"/>
        <stop offset="100%" stop-color="${color}" stop-opacity="0"/>
      </linearGradient>
    </defs>
    <path d="${areaD}" fill="url(#${svgId}-gradient)"/>
    <path d="${pathD}" fill="none" stroke="${color}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    ${circles}`;

    svg.innerHTML = sanitize(svgContent);
  }

  if (stats.monthly?.length) {
    renderLineChart('subscriptions-svg', stats.monthly.map(m => toNum(m.subscriptions)), stats.monthly.map(m => String(m.month ?? '')), '#8b5cf6');
    renderLineChart('users-svg', stats.monthly.map(() => 0), stats.monthly.map(m => String(m.month ?? '')), '#3b82f6');
  }

  // Render subscriptions list (safe DOM API)
  const ordersContainer = document.getElementById('orders-list');
  if (ordersContainer) {
    if (!subs.length) {
      ordersContainer.innerHTML = '<p class="text-center text-muted-foreground py-6 text-sm">No subscriptions yet</p>';
    } else {
      // Use safe DOM construction, no innerHTML with user data
      ordersContainer.textContent = '';
      subs.slice(0, 5).forEach((sub: Subscription) => {
        const item = document.createElement('div');
        item.className = 'flex items-center justify-between p-2 border rounded text-sm';

        const left = document.createElement('div');
        left.className = 'min-w-0 flex-1';

        const idP = document.createElement('p');
        idP.className = 'font-medium truncate';
        idP.textContent = '#' + String(sub.id ?? '').slice(0, 8);

        const descP = document.createElement('p');
        descP.className = 'text-xs text-muted-foreground truncate';
        descP.textContent = String(sub.servicePackageId ?? sub.planSlug ?? 'Subscription') + ' - $' + String(sub.amount);

        left.appendChild(idP);
        left.appendChild(descP);

        const badge = document.createElement('span');
        badge.className = 'px-2 py-0.5 text-xs rounded-full ml-2 ' +
          (sub.status === 'paid' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200');
        badge.textContent = String(sub.status ?? '');

        item.appendChild(left);
        item.appendChild(badge);
        ordersContainer.appendChild(item);
      });
    }
  }
</script>