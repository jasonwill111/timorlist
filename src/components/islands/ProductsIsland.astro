---
import Button from '@/components/ui/Button.astro';
import Input from '@/components/ui/Input.astro';
// Server-rendered Products list with proper pagination
// All filtering, sorting, and pagination happens on the server
import { getDb, getRawDb } from '@/lib/db';
import { products, businesses } from '@/db/schema';
import { desc, eq, like, asc, and } from 'drizzle-orm';
import Select from '@/components/ui/Select.astro';

const searchParams = Astro.url.searchParams;
const search = searchParams.get('search') || '';
const businessId = searchParams.get('business') || '';
const sort = searchParams.get('sort') || 'recent';
const page = parseInt(searchParams.get('page') || '1', 10);
const LIMIT = 12;
const offset = (page - 1) * LIMIT;

// Cache: Products page - 2min browser, 10min CDN
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=120, s-maxage=600, stale-while-revalidate=1200'
);

// Fetch all businesses for filter dropdown
let allBusinesses: { id: string; title: string; slug: string }[] = [];
try {
  const db = await getDb();
  if (db) {
    allBusinesses = await db
      .select({
        id: businesses.id,
        title: businesses.title,
        slug: businesses.slug,
      })
      .from(businesses)
      .where(eq(businesses.status, 'active'))
      .orderBy(asc(businesses.title))
      .limit(100)
      .all();
  }
} catch (e) {
  console.error('Failed to fetch businesses:', e);
}

// Build WHERE conditions
const conditions = [eq(products.active, 1)];

if (search) {
  conditions.push(like(products.title, `%${search}%`));
}

if (businessId) {
  conditions.push(eq(products.businessId, businessId));
}

// Count total matching products - use raw D1Database.prepare()
let total = 0;
try {
  const rawDb = await getRawDb();
  console.log('[Products] rawDb available:', !!rawDb);
  if (rawDb) {
    const stmt = rawDb.prepare('SELECT COUNT(*) as count FROM products WHERE active = 1 AND deleted_at IS NULL');
    const result = await stmt.first();
    console.log('[Products] count result:', JSON.stringify(result));
    total = (result as any)?.count ?? 0;
    console.log('[Products] total set to:', total);
  }
} catch (e) { console.error('Count error:', e); }
// Fetch paginated products
let paginatedProducts: {
  id: string;
  title: string;
  slug: string;
  priceFields: string | null;
  productType: string | null;
  businessId: string | null;
}[] = [];

try {
  const db = await getDb();
  if (db) {
    let query = db
      .select({
        id: products.id,
        title: products.title,
        slug: products.slug,
        priceFields: products.priceFields,
        productType: products.productType,
        businessId: products.businessId,
      })
      .from(products)
      .where(and(...conditions));

    // Apply sorting
    if (sort === 'name') {
      query = query.orderBy(asc(products.title));
    } else {
      query = query.orderBy(desc(products.createdAt));
    }

    paginatedProducts = await query
      .limit(LIMIT)
      .offset(offset)
      .all();
  }
} catch (e) {
  console.error('Failed to fetch products:', e);
}

// Parse price fields for display
function parsePrice(priceFields: string | null): { min?: number; max?: number; currency?: string } {
  if (!priceFields) return {};
  try {
    return JSON.parse(priceFields);
  } catch {
    return {};
  }
}

const totalPages = Math.ceil(total / LIMIT);

// Build pagination URL helper
const buildUrl = (pageNum: number) => {
  const p = new URLSearchParams();
  if (search) p.set('search', search);
  if (businessId) p.set('business', businessId);
  if (sort !== 'recent') p.set('sort', sort);
  if (pageNum > 1) p.set('page', pageNum.toString());
  return `/products-services?${p.toString()}`;
};
---

<!-- Header -->
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2 mb-4 sm:mb-6">
  <div>
    <h1 class="text-3xl font-bold leading-tight">Products & Services</h1>
    <p class="text-xs sm:text-sm text-muted-foreground">{total} products found</p>
  </div>
  <a href="/listings" class="text-xs sm:text-sm text-primary hover:underline">← Directory</a>
</div>

<!-- Filters -->
<form id="filter-form" method="GET" action="/products-services" class="flex flex-wrap gap-2 sm:gap-4 mb-4 sm:mb-6">
  <div class="relative flex-1 min-w-[200px]">
    <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-muted-foreground" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
    <Input
      id="search"
      name="search"
      type="search"
      placeholder="Search products..."
      value={search}
      class="w-full h-10 pl-10 pr-4 rounded-lg border border-input bg-background text-sm"
    />
  </div>

  <Select id="business-filter" name="business">
    <option value="">All Businesses</option>
    {allBusinesses.map(b => (
      <option value={b.id} selected={businessId === b.id}>{b.title}</option>
    ))}
  </Select>
  <Select id="sort-filter" name="sort">
    <option value="recent" selected={sort === 'recent'}>Recent</option>
    <option value="name" selected={sort === 'name'}>Name A-Z</option>
  </Select>
  <Button type="submit">
    Filter
  </Button>
</form>

<!-- Products Grid -->
{paginatedProducts.length > 0 ? (
  <>
    <div class="grid grid-cols-2 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-2 sm:gap-4">
      {paginatedProducts.map(p => {
        const price = parsePrice(p.priceFields);
        const business = allBusinesses.find(b => b.id === p.businessId);
        return (
          <a href={`/product/${p.slug}`} class="group block bg-card rounded-xl overflow-hidden border border-border/50 hover:border-primary/40 hover:shadow-md transition-all">
            {/* Product Image Placeholder */}
            <div class="aspect-square bg-gradient-to-br from-primary/10 to-primary/5 flex items-center justify-center">
              <svg class="w-12 h-12 text-primary/30" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            
            {/* Content */}
            <div class="p-3">
              <h3 class="font-semibold text-sm line-clamp-2 group-hover:text-primary transition-colors">
                {p.title}
              </h3>
              {business && (
                <p class="text-xs text-muted-foreground mt-1 truncate">
                  {business.title}
                </p>
              )}
              {price.min !== undefined && (
                <p class="text-sm font-medium text-primary mt-2">
                  {price.currency || '$'}{price.min.toLocaleString()}
                  {price.max !== undefined && ` - ${price.currency || '$'}${price.max.toLocaleString()}`}
                </p>
              )}
            </div>
          </a>
        );
      })}
    </div>

    {/* Pagination */}
    {totalPages > 1 && (
      <nav class="flex justify-center items-center gap-2 mt-8" aria-label="Pagination">
        {page > 1 && (
          <a href={buildUrl(page - 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
            ← Previous
          </a>
        )}
        
        {Array.from({ length: Math.min(totalPages, 7) }, (_, i) => {
          const pageNum = i + 1;
          const isActive = pageNum === page;
          return (
            <a 
              href={buildUrl(pageNum)} 
              class={`px-3 py-2 rounded-md text-sm ${isActive ? 'bg-primary text-primary-foreground' : 'bg-muted hover:bg-muted/80'}`}
              aria-current={isActive ? 'page' : undefined}
            >
              {pageNum}
            </a>
          );
        })}
        
        {page < totalPages && (
          <a href={buildUrl(page + 1)} class="px-3 py-2 rounded-md bg-muted hover:bg-muted/80 text-sm">
            Next →
          </a>
        )}
      </nav>
    )}
  </>
) : (
  <div class="text-center py-16">
    <svg class="w-16 h-16 text-muted-foreground/50 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
    </svg>
    <h3 class="text-xl font-semibold leading-snug text-foreground mb-2">No products found</h3>
    <p class="text-muted-foreground">Try adjusting your search or filters</p>
    <a href="/products-services" class="inline-block mt-4 px-4 py-2 bg-primary text-primary-foreground rounded-md">
      View all products
    </a>
  </div>
)}
