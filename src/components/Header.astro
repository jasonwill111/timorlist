---
/**
 * Header - Main site navigation
 * Migrated to compose ui/* primitives:
 * - Desktop nav dropdowns → DropdownMenu (click trigger)
 * - Mobile menu → Sheet (right side panel)
 * - Avatar → Avatar + AvatarFallback
 *
 * All imports must be inside the single frontmatter block (SSR safety, see 0125).
 */
import ThemeToggle from './fulldev/ThemeToggle.astro';
import { Button } from './fulldev/button';
import { Avatar } from './fulldev/avatar';
import { AvatarFallback } from './fulldev/avatar';
import { DropdownMenu } from './fulldev/dropdown-menu';
import { DropdownMenuTrigger } from './fulldev/dropdown-menu';
import { DropdownMenuContent } from './fulldev/dropdown-menu';
import { Sheet } from './fulldev/sheet';
import { SheetTrigger } from './fulldev/sheet';
import { SheetContent } from './fulldev/sheet';
import { SheetHeader } from './fulldev/sheet';
import { SheetTitle } from './fulldev/sheet';
import { SheetDescription } from './fulldev/sheet';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isLoggedIn = typeof window !== 'undefined' && (sessionStorage.getItem('userId') || localStorage.getItem('userId'));
const urlParams = new URL(Astro.request.url).searchParams;
---

<header class="sticky top-0 z-50 w-full border-b bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container max-w-7xl">
    <div class="flex h-16 items-center justify-between">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2">
        <div class="w-11 h-10 bg-brand-500 rounded-lg flex items-center justify-center">
          <span class="text-white font-bold text-lg">T</span>
        </div>
        <span class="font-bold text-xl hidden sm:inline-block">TimorUp</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-0">
        <!-- Dropdown: Business -->
        <DropdownMenu>
          <DropdownMenuTrigger class="inline-flex items-center justify-center h-9 px-2.5 rounded-md text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
            Business
          </DropdownMenuTrigger>
          <DropdownMenuContent class="w-48">
            <a href="/businesses" data-slot="dropdown-menu-item" class="relative flex cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
              Business Directories
            </a>
            <a href="/products-services" data-slot="dropdown-menu-item" class="relative flex cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
              Products & Services
            </a>
          </DropdownMenuContent>
        </DropdownMenu>

        <a
          href="/listings"
          class:list={[
            "text-sm font-medium transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded px-1.5 py-1 flex items-center",
            currentPath.startsWith('/listings') ? "text-primary" : "text-muted-foreground"
          ]}
        >
          Classified Ads
        </a>

        <!-- Dropdown: Govs & NGOs -->
        <DropdownMenu>
          <DropdownMenuTrigger class="inline-flex items-center justify-center h-9 px-2.5 rounded-md text-sm font-medium text-muted-foreground hover:bg-muted hover:text-foreground">
            Govs & NGOs
          </DropdownMenuTrigger>
          <DropdownMenuContent class="w-40">
            <a href="/public-sectors" data-slot="dropdown-menu-item" class="relative flex cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
              Public Sectors
            </a>
            <a href="/non-profits" data-slot="dropdown-menu-item" class="relative flex cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
              Non-Profits
            </a>
          </DropdownMenuContent>
        </DropdownMenu>

        <a
          href="/pricing"
          class:list={[
            "text-sm font-medium transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded px-1.5 py-1 flex items-center",
            currentPath === '/pricing' ? "text-primary" : "text-muted-foreground"
          ]}
        >
          Pricing
        </a>
        <a
          href="/faq"
          class:list={[
            "text-sm font-medium transition-colors hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 rounded px-1.5 py-1 flex items-center",
            currentPath === '/faq' ? "text-primary" : "text-muted-foreground"
          ]}
        >
          FAQ
        </a>
        <a
          href="/listings/create"
          class="text-sm font-medium bg-primary text-primary-foreground px-2 py-1 rounded hover:bg-primary/90 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 flex items-center ml-1"
        >
          + Create
        </a>
      </nav>

      <!-- Right Side -->
      <div class="flex items-center gap-2">
        <ThemeToggle />

        <div id="desktop-auth" class="hidden md:flex items-center gap-2">
          {isLoggedIn ? (
            <DropdownMenu>
              <DropdownMenuTrigger class="w-11 h-10 rounded-lg bg-brand-500 hover:opacity-80 transition-opacity p-0 inline-flex items-center justify-center">
                <Avatar class="w-full h-full bg-brand-500">
                  <AvatarFallback class="bg-brand-500 text-white text-sm font-medium">?</AvatarFallback>
                </Avatar>
              </DropdownMenuTrigger>
              <DropdownMenuContent align="end" class="w-40">
                <a href="/account" data-slot="dropdown-menu-item" class="relative flex cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none hover:bg-accent hover:text-accent-foreground">
                  My Account
                </a>
                <div data-slot="dropdown-menu-separator" class="bg-muted -mx-1 my-1 h-px"></div>
                <button id="logout-btn" data-slot="dropdown-menu-item" data-variant="destructive" class="relative flex w-full cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none text-destructive hover:bg-destructive/10">
                  Log Out
                </button>
              </DropdownMenuContent>
            </DropdownMenu>
          ) : (
            <>
              <a href="/login" class="text-sm font-medium text-muted-foreground hover:text-primary px-2 sm:px-3 h-7 rounded-md hover:bg-muted transition-colors flex items-center py-0.5">
                Log in
              </a>
              <a href="/register" class="text-sm font-medium bg-primary text-primary-foreground px-3 sm:px-4 h-7 rounded-md hover:bg-primary/90 transition-colors flex items-center py-0.5">
                Sign Up
              </a>
            </>
          )}
        </div>

        <!-- Mobile Menu (Sheet) -->
        <Sheet>
          <SheetTrigger class="md:hidden w-11 h-10 rounded-md hover:bg-muted transition-colors" aria-label="Open menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </SheetTrigger>
          <SheetContent side="right" class="w-full max-w-xs p-0">
            <SheetHeader class="p-4 border-b">
              <SheetTitle>Menu</SheetTitle>
              <SheetDescription>Navigate to a section</SheetDescription>
            </SheetHeader>
            <nav class="flex flex-col p-4 space-y-1">
              <a href="/businesses" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath.startsWith('/businesses') ? "bg-muted text-primary" : "text-muted-foreground"]}>
                Business Directories
              </a>
              <a href="/products-services" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath.startsWith('/products-services') ? "bg-muted text-primary" : "text-muted-foreground"]}>
                Products & Services
              </a>
              <a href="/listings" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath.startsWith('/listings') ? "bg-muted text-primary" : "text-muted-foreground"]}>
                Classified Ads
              </a>
              <a href="/public-sectors" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath.startsWith('/public-sectors') ? "bg-muted text-primary" : "text-muted-foreground"]}>
                Public Sectors
              </a>
              <a href="/non-profits" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath.startsWith('/non-profits') ? "bg-muted text-primary" : "text-muted-foreground"]}>
                Non-Profits
              </a>
              <a href="/pricing" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath === '/pricing' ? "bg-muted text-primary" : "text-muted-foreground"]}>
                Pricing
              </a>
              <a href="/faq" class:list={["block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium flex items-center", currentPath === '/faq' ? "bg-muted text-primary" : "text-muted-foreground"]}>
                FAQ
              </a>
              <a href="/listings/create" class="block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium bg-primary text-primary-foreground text-center flex items-center justify-center">
                + Create Listing
              </a>
              <div id="mobile-auth" class="border-t pt-2 mt-2 space-y-2">
                {isLoggedIn ? (
                  <>
                    <a href="/account" class="block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium text-muted-foreground flex items-center">My Account</a>
                    <Button id="mobile-logout" data-action="mobile-logout" variant="ghost" class="block w-full text-left px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium text-red-500 flex items-center" />
                  </>
                ) : (
                  <>
                    <a href="/login" class="block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium text-center border border-primary text-primary hover:bg-primary/5 flex items-center justify-center">Log in</a>
                    <a href="/register" class="block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium text-center bg-primary text-primary-foreground flex items-center justify-center">Sign Up</a>
                  </>
                )}
              </div>
            </nav>
          </SheetContent>
        </Sheet>
    </div>
  </div>
</header>

<script>
  import { actions } from 'astro:actions';

  // Logout handler for both desktop and mobile
  async function handleLogout() {
    try { await actions.auth.signOut(); }
    catch (e) { console.error('Logout error:', e); }
    finally {
      sessionStorage.removeItem('userId');
      localStorage.removeItem('userId');
      window.location.href = '/';
    }
  }

  // Wire up logout buttons (desktop + mobile) via event delegation
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const actionEl = target.closest('[data-action]');
    const action = actionEl?.getAttribute('data-action');
    if (action === 'mobile-logout') {
      handleLogout();
    }
    if (target.closest('#logout-btn')) {
      handleLogout();
    }
  });

  function updateAuthState() {
    const userId = localStorage.getItem('userId') || sessionStorage.getItem('userId');
    const userName = localStorage.getItem('userName') || sessionStorage.getItem('userName');
    const desktopAuth = document.getElementById('desktop-auth');
    const mobileAuth = document.getElementById('mobile-auth');
    const initial = userName ? escapeHtml(userName).charAt(0).toUpperCase() : '?';

    if (userId) {
      if (desktopAuth) {
        desktopAuth.innerHTML = `
          <div data-slot="dropdown-menu" class="relative">
            <button data-slot="dropdown-menu-trigger" id="avatar-dropdown-btn" class="w-11 h-10 rounded-lg bg-brand-500 hover:opacity-80 transition-opacity p-0 inline-flex items-center justify-center">
              <div data-slot="avatar" data-size="default" class="after:border-border group/avatar relative flex size-8 shrink-0 overflow-hidden rounded-full select-none after:absolute after:inset-0 after:rounded-full after:border after:mix-blend-darken dark:after:mix-blend-lighten">
                <div data-slot="avatar-fallback" class="bg-brand-500 text-muted-foreground absolute inset-0 z-0 flex size-full items-center justify-center rounded-full text-sm group-data-[size=sm]/avatar:text-xs">
                  <span class="text-white font-medium">${initial}</span>
                </div>
              </div>
            </button>
            <div data-slot="dropdown-menu-portal" class="hidden absolute right-0 mt-2 z-50">
              <div data-slot="dropdown-menu-positioner" data-side="bottom" data-align="end" class="isolate z-50 outline-none">
                <div data-slot="dropdown-menu-content" hidden class="bg-popover text-popover-foreground z-50 min-w-32 overflow-x-hidden overflow-y-auto rounded-md p-1 shadow-md ring-1 ring-foreground/10 w-40">
                  <a href="/account" data-slot="dropdown-menu-item" class="relative flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none select-none hover:bg-accent hover:text-accent-foreground">My Account</a>
                  <div data-slot="dropdown-menu-separator" class="bg-muted -mx-1 my-1 h-px"></div>
                  <button id="logout-btn" data-slot="dropdown-menu-item" data-variant="destructive" class="relative flex w-full cursor-pointer items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none select-none text-red-500 hover:bg-destructive/10">Log Out</button>
                </div>
              </div>
            </div>
          </div>
        `;
        setTimeout(() => {
          const btn = document.getElementById('avatar-dropdown-btn');
          const portal = btn?.closest('[data-slot="dropdown-menu"]')?.querySelector('[data-slot="dropdown-menu-portal"]');
          const content = portal?.querySelector('[data-slot="dropdown-menu-content"]') as HTMLElement | null;
          btn?.addEventListener('click', (e) => {
            e.stopPropagation();
            if (content) {
              content.hidden = !content.hidden;
              portal?.classList.toggle('hidden', content.hidden);
            }
          });
          document.addEventListener('click', () => {
            if (content && !content.hidden) {
              content.hidden = true;
              portal?.classList.add('hidden');
            }
          });
          document.getElementById('logout-btn')?.addEventListener('click', () => handleLogout());
        }, 0);
      }
      if (mobileAuth) {
        mobileAuth.innerHTML = `
          <a href="/account" class="block px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium text-muted-foreground flex items-center">My Account</a>
          <button id="mobile-logout" data-action="mobile-logout" class="block w-full text-left px-3 py-3 min-h-[44px] rounded-lg text-base sm:text-sm font-medium text-red-500 flex items-center">Log Out</button>
        `;
      }
    }
  }

  updateAuthState();

  function escapeHtml(str: string) {
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
  }
</script>
