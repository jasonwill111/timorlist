---
import { Field, FieldLabel, FieldError } from '@/components/ui/field';
import { cn } from '@/lib/utils';

interface Props {
  label: string;
  name: string;
  errors?: Array<{ message?: string } | undefined>;
  required?: boolean;
  class?: string;
}

const { label, name, errors, required = false, class: className } = Astro.props;

const hasError = errors && errors.length > 0;
---
<Field class={cn('flex-col gap-1.5', className)}>
  <FieldLabel for={name}>
    {label}{required && <span class="text-destructive ml-0.5">*</span>}
  </FieldLabel>
  <slot />
  {hasError && <FieldError errors={errors} />}
</Field>
