---
/**
 * FormMessage - Success/Error message display
 * Migrated to compose ui/Alert primitives.
 * Preserves window.__formMessage.show/hide API for callers.
 */
import { Alert } from '@/components/ui/alert';
import { AlertDescription } from '@/components/ui/alert';

interface Props {
  id?: string;
  type?: 'success' | 'error';
}

const { id = 'form-message', type = 'error' } = Astro.props;
---

<Alert
  id={id}
  variant={type === 'error' ? 'destructive' : 'default'}
  class:list={[
    'hidden',
    type === 'success' && 'border-green-500 text-green-700 dark:text-green-400 [&_[data-slot=alert-description]]:text-green-700/90 dark:[&_[data-slot=alert-description]]:text-green-400/90'
  ]}
  role="alert"
>
  <AlertDescription>
    <slot />
  </AlertDescription>
</Alert>

<script define:vars={{ id }}>
  function showMessage(message, isSuccess = false) {
    const el = document.getElementById(id);
    if (!el) return;
    if (isSuccess) {
      el.classList.remove('hidden', 'border-destructive', 'text-destructive', '[&_[data-slot=alert-description]]:text-destructive/90');
      el.classList.add('border-green-500', 'text-green-700', 'dark:text-green-400');
    } else {
      el.classList.remove('hidden', 'border-green-500', 'text-green-700', 'dark:text-green-400');
      el.classList.add('border-destructive', 'text-destructive', '[&_[data-slot=alert-description]]:text-destructive/90');
    }
    // Set text content inside the alert-description child
    const desc = el.querySelector('[data-slot=alert-description]');
    if (desc) desc.textContent = message;
    el.classList.remove('hidden');
  }

  function hideMessage() {
    const el = document.getElementById(id);
    if (el) el.classList.add('hidden');
  }

  window.__formMessage = { show: showMessage, hide: hideMessage };
</script>
