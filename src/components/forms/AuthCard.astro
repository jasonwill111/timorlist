---
// AuthCard - Wrapper for auth pages (login, register, forgot-password, reset-password)
import { Card } from '@/components/fulldev/card';
import { CardHeader } from '@/components/fulldev/card';
import { CardTitle } from '@/components/fulldev/card';
import { CardDescription } from '@/components/fulldev/card';
import { CardContent } from '@/components/fulldev/card';
import { CardFooter } from '@/components/fulldev/card';
import { Button } from '@/components/fulldev/button';

interface Props {
  title: string;
  description: string;
  footerText?: string;
  footerLink?: { href: string; text: string };
}

const { title, description, footerText, footerLink } = Astro.props;
---

<div class="container py-12">
  <div class="max-w-md mx-auto">
    <Card>
      <CardHeader class="text-center">
        <CardTitle class="text-2xl">{title}</CardTitle>
        <CardDescription>{description}</CardDescription>
      </CardHeader>
      <CardContent>
        <slot />
      </CardContent>
      {footerText && (
        <CardFooter class="justify-center">
          <p class="text-sm text-muted-foreground">
            {footerText}
            {footerLink && (
              <Button variant="link" as="a" href={footerLink.href} class="ml-1">
                {footerLink.text}
              </Button>
            )}
          </p>
        </CardFooter>
      )}
    </Card>
  </div>
</div>
