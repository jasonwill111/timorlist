---
// Optimized Image Component for Astro
// Uses R2 CDN with responsive srcset for optimal loading
// v2: Added error fallback handling

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  className?: string;
  loading?: 'lazy' | 'eager';
  decoding?: 'async' | 'sync';
  sizes?: string;
  fallbackSrc?: string;
}

// R2 public URL from environment
const R2_PUBLIC_URL = import.meta.env.PUBLIC_R2_PUBLIC_URL ||
  `https://${import.meta.env.PUBLIC_R2_BUCKET || 'TimorUp-media'}.r2.cloudflarestorage.com`;

// Generate responsive srcset for R2 images
function generateSrcset(src: string): string {
  if (!src) return '';

  if (src.startsWith('data:') || src.startsWith('http') && !src.includes('r2.cloudflarestorage')) {
    return '';
  }

  let key = src;
  if (src.includes(R2_PUBLIC_URL)) {
    key = src.replace(`${R2_PUBLIC_URL}/`, '');
  }

  const widths = [320, 640, 960, 1280];
  const srcsetParts = widths.map(w => {
    const cdnUrl = `https://TimorUp.com/cdn-cgi/image/width=${w},quality=75,format=webp/${R2_PUBLIC_URL}/${key} ${w}w`;
    return cdnUrl;
  });

  return srcsetParts.join(', ');
}

// Get the full URL for the image
function getImageUrl(src: string): string {
  if (!src) return '/placeholder.svg';
  if (src.startsWith('data:') || src.startsWith('http')) return src;
  return `${R2_PUBLIC_URL}/${src}`;
}

const {
  src,
  alt,
  width,
  height,
  className = '',
  loading = 'lazy',
  decoding = 'async',
  sizes = '(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 33vw',
  fallbackSrc = '/placeholder.svg'
} = Astro.props;

const imageUrl = getImageUrl(src);
const srcset = generateSrcset(src);
const elementId = `img-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['optimized-image-wrapper', className]} style={width && height ? `aspect-ratio: ${width}/${height};` : undefined}>
  <img
    id={elementId}
    src={imageUrl}
    srcset={srcset || undefined}
    {sizes}
    {alt}
    {width}
    {height}
    class="optimized-image"
    {loading}
    {decoding}
    onerror={`this.onerror=null;this.src='${fallbackSrc}';this.srcset='';this.classList.add('optimized-image-fallback')`}
  />
</div>

<style>
  .optimized-image-wrapper {
    display: block;
    position: relative;
    overflow: hidden;
  }
  .optimized-image {
    display: block;
    max-width: 100%;
    height: auto;
  }
  .optimized-image-fallback {
    opacity: 0.6;
    object-fit: contain;
  }
</style>
