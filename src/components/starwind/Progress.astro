---
/**
 * Starwind-style Progress component
 * Visual progress indicator.
 *
 * Usage:
 * <Progress value={75} max={100} label="Uploading..." />
 */

interface Props {
  value: number;
  max?: number;
  label?: string;
  variant?: 'default' | 'success' | 'error' | 'warning';
  class?: string;
}

const { value, max = 100, label, variant = 'default', class: className = '' } = Astro.props;
const percent = Math.min(100, Math.max(0, (value / max) * 100));

const variantClass = {
  default: 'bg-primary',
  success: 'bg-green-500',
  error: 'bg-red-500',
  warning: 'bg-yellow-500',
}[variant];
---

<div class={`w-full ${className}`} role="progressbar" aria-valuenow={value} aria-valuemin="0" aria-valuemax={max}>
  {label && (
    <div class="flex justify-between text-xs text-muted-foreground mb-1">
      <span>{label}</span>
      <span>{Math.round(percent)}%</span>
    </div>
  )}
  <div class="h-2 w-full bg-secondary rounded-full overflow-hidden">
    <div
      class={`h-full ${variantClass} transition-all duration-300`}
      style={`width: ${percent}%`}
    />
  </div>
</div>
