---
/**
 * Starwind-style Dropzone component
 * Drag-and-drop file upload area.
 *
 * Usage:
 * <Dropzone
 *   id="media-upload"
 *   name="files"
 *   accept="image/*,video/*"
 *   multiple={true}
 *   maxSize={10485760}
 * />
 */

interface Props {
  id: string;
  name: string;
  accept?: string;
  multiple?: boolean;
  maxSize?: number;
  label?: string;
  class?: string;
}

const {
  id,
  name,
  accept = 'image/*',
  multiple = false,
  maxSize = 10 * 1024 * 1024, // 10MB
  label = 'Drag files here or click to browse',
  class: className = '',
} = Astro.props;
---

<div
  class={`dropzone border-2 border-dashed border-input rounded-lg p-8 text-center cursor-pointer hover:border-primary hover:bg-accent/50 transition-colors ${className}`}
  data-dropzone
  data-max-size={maxSize}
>
  <input
    type="file"
    id={id}
    name={name}
    accept={accept}
    multiple={multiple}
    class="sr-only"
    data-dropzone-input
  />
  <label for={id} class="cursor-pointer block">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="mx-auto h-12 w-12 text-muted-foreground mb-3"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"
      />
    </svg>
    <p class="text-sm font-medium text-foreground">{label}</p>
    <p class="text-xs text-muted-foreground mt-1">
      {accept} · up to {Math.round(maxSize / 1024 / 1024)}MB
    </p>
  </label>
  <div data-dropzone-feedback class="mt-3 text-sm text-primary hidden">
    File selected!
  </div>
</div>

<script>
  // Lightweight drag-drop visual feedback
  document.addEventListener('DOMContentLoaded', () => {
    const dropzones = document.querySelectorAll('[data-dropzone]');
    dropzones.forEach((zone) => {
      const input = zone.querySelector('[data-dropzone-input]') as HTMLInputElement;
      const feedback = zone.querySelector('[data-dropzone-feedback]');

      if (!input || !feedback) return;

      // Click on zone opens file picker (label does this, but for non-label click too)
      zone.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).tagName === 'LABEL') return;
        if ((e.target as HTMLElement).tagName === 'INPUT') return;
        input.click();
      });

      // Visual feedback on dragover
      zone.addEventListener('dragover', (e) => {
        e.preventDefault();
        zone.classList.add('border-primary', 'bg-accent');
      });

      // Remove visual on dragleave
      zone.addEventListener('dragleave', () => {
        zone.classList.remove('border-primary', 'bg-accent');
      });

      // Handle drop
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('border-primary', 'bg-accent');
        if (e.dataTransfer?.files) {
          input.files = e.dataTransfer.files;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });

      // Show feedback on file selection
      input.addEventListener('change', () => {
        if (input.files && input.files.length > 0) {
          feedback.classList.remove('hidden');
          const count = input.files.length;
          feedback.textContent = count === 1
            ? `Selected: ${input.files[0].name}`
            : `Selected ${count} files`;
        }
      });
    });
  });
</script>
